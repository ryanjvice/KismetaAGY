<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />
    <engine:Style src="../../USS/SummerActions.uss" />
    <engine:Style src="../../USS/EndAndOverlays.uss" />
    <engine:Template src="../shell/GameHeaderOverlay.uxml" name="GameHeaderOverlay" />
    <engine:Template src="../shell/PlayerInventoryOverlay.uxml" name="PlayerInventoryOverlay" />

    <engine:VisualElement name="summer-main" class="screen screen--summer">

        <engine:VisualElement class="screen__body">
            <engine:Instance template="GameHeaderOverlay" />

            <engine:VisualElement class="summer-main__toolbar">
                <engine:Label name="narrative-beat" text="" class="narrative-beat" />
            </engine:VisualElement>

            <engine:VisualElement class="summer-main__actionbar">
                <engine:VisualElement class="actionbar__row actionbar__row--primary">
                    <engine:Button name="trade-btn" text="Trade" class="actionbtn btn btn--secondary" />
                    <engine:Button name="duel-btn" text="Duel" class="actionbtn btn btn--secondary" />
                    <engine:Button name="gambit-btn" text="Gambit" class="actionbtn btn btn--secondary" />
                    <engine:Button name="opposition-btn" text="Opposition" class="actionbtn btn btn--secondary" />
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement class="central-panel">
                <engine:VisualElement name="summer-roster" class="summer-roster" style="flex-grow: 1;">
                    <engine:VisualElement class="summer-roster__sort" style="padding: 6px 12px; flex-direction: row;">
                        <engine:Button name="sort-threat" text="by threat" class="table-action" style="background-color: rgb(42, 31, 14); border-color: rgb(90, 68, 32); color: rgb(224, 200, 120);" />
                        <engine:Button name="sort-turn" text="turn order" class="table-action" style="background-color: rgb(16, 10, 18); border-color: rgb(58, 36, 64); color: rgb(184, 154, 110);" />
                        <engine:Button name="sort-arcanum" text="arcanum" class="table-action" style="background-color: rgb(16, 10, 18); border-color: rgb(58, 36, 64); color: rgb(184, 154, 110);" />
                    </engine:VisualElement>
                    <engine:ScrollView name="players" class="card-table__players" style="flex-grow: 1;" />
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement class="summer-main__stakes">
                <engine:VisualElement name="narrative-stakes-wrap" class="narrative-stakes-wrap tip tip--caution">
                    <engine:Label name="narrative-stakes" text="" class="narrative-stakes tip__text" />
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement class="stage-cta stage-cta--single summer-main__pass-block">
                <engine:Button name="pass-btn" text="Pass" class="actionbtn btn btn--secondary" />
                <engine:Label name="narrative-charge" text="" class="narrative-charge summer-main__charge" />
            </engine:VisualElement>

            <engine:Instance template="PlayerInventoryOverlay" />
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
