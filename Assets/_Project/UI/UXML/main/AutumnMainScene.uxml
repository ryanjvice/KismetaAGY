<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />
    <engine:Style src="../../USS/SummerActions.uss" />
    <engine:Style src="../../USS/AutumnActions.uss" />
    <engine:Style src="../../USS/CentralPanelInspect.uss" />
    <engine:Template src="../shell/GameHeaderOverlay.uxml" name="GameHeaderOverlay" />
    <engine:Template src="../shell/PlayerInventoryOverlay.uxml" name="PlayerInventoryOverlay" />
    <engine:Template src="../shell/CauldronHub.uxml" name="CauldronHub" />
    <engine:Template src="../shell/CentralPanelInspectFab.uxml" name="CentralPanelInspectFab" />

    <engine:VisualElement name="autumn-main" class="screen screen--autumn">

        <engine:VisualElement class="screen__body">
            <engine:Instance template="GameHeaderOverlay" />

            <engine:VisualElement class="autumn-main__toolbar">
                <engine:VisualElement class="narrative-toolbar">
                    <engine:Button name="info-btn" text="🗓️" class="narrative-toolbar__info-btn btn btn--secondary" />
                    <engine:Label name="narrative-beat" text="" class="narrative-beat" />
                    <engine:Button name="table-fab" text="🧙" class="narrative-toolbar__table-btn table-fab btn btn--secondary" />
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement class="autumn-main__actionbar">
                <engine:VisualElement class="actionbar__row actionbar__row--primary">
                    <engine:Button name="craft-btn" text="Craft&#10;Reagents" class="actionbtn btn btn--action btn--action-hue-blue" />
                    <engine:Button name="activate-btn" text="Light&#10;Cauldrons" class="actionbtn btn btn--action btn--action-hue-red" />
                    <engine:Button name="forge-btn" text="Forge&#10;Stone" class="actionbtn btn btn--action btn--action-hue-green" />
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement class="autumn-main__forge-heading">
                <engine:VisualElement class="summer-roster__header">
                    <engine:VisualElement class="summer-roster__header-line" />
                    <engine:Label text="The Forge" class="summer-roster__heading" />
                    <engine:VisualElement class="summer-roster__header-line" />
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement class="central-panel">
                <engine:VisualElement name="autumn-cauldron-stage" class="stage" style="align-items: center; justify-content: center; display: none;">
                    <engine:Instance template="CauldronHub" />
                </engine:VisualElement>

                <engine:VisualElement name="autumn-forge-stage" class="stage" style="align-items: center; justify-content: center;">
                    <engine:VisualElement class="forge-panel">
                        <engine:VisualElement name="board-stage" class="forge-stage">
                            <engine:VisualElement name="forge-mandala" class="forge-mandala" />
                            <engine:VisualElement class="stone-marker forge-pos forge-pos--0" />
                            <engine:VisualElement class="stone-marker forge-pos forge-pos--1 stone-marker--inner" />
                            <engine:VisualElement class="stone-marker forge-pos forge-pos--2" />
                            <engine:VisualElement class="stone-marker forge-pos forge-pos--3 stone-marker--inner" />
                            <engine:VisualElement class="stone-marker forge-pos forge-pos--4" />
                            <engine:VisualElement class="stone-marker forge-pos forge-pos--5 stone-marker--inner" />
                            <engine:VisualElement class="stone-marker forge-pos forge-pos--6" />
                            <engine:VisualElement class="stone-marker forge-pos forge-pos--7 stone-marker--inner" />
                            <engine:VisualElement name="stone-marker-altar" class="stone-marker forge-pos forge-pos--altar" />
                            <engine:VisualElement name="player-stones" class="player-stones" />
                        </engine:VisualElement>
                        <engine:VisualElement name="stasis-row" class="forge-bottom-row">
                            <engine:VisualElement name="stasis-slot-0" class="stasis-slot">
                                <engine:VisualElement class="stasis-slot__stone" />
                            </engine:VisualElement>
                            <engine:VisualElement name="stasis-slot-1" class="stasis-slot">
                                <engine:VisualElement class="stasis-slot__stone" />
                            </engine:VisualElement>
                            <engine:VisualElement name="cauldron-mini" class="cauldron-mini">
                                <engine:VisualElement class="cauldron-mini__reagent cauldron-mini__reagent--wands" />
                                <engine:VisualElement class="cauldron-mini__reagent cauldron-mini__reagent--cups" />
                                <engine:VisualElement class="cauldron-mini__reagent cauldron-mini__reagent--pentacles" />
                                <engine:VisualElement class="cauldron-mini__reagent cauldron-mini__reagent--swords" />
                            </engine:VisualElement>
                            <engine:VisualElement name="stasis-slot-2" class="stasis-slot">
                                <engine:VisualElement class="stasis-slot__stone" />
                            </engine:VisualElement>
                            <engine:VisualElement name="stasis-slot-3" class="stasis-slot">
                                <engine:VisualElement class="stasis-slot__stone" />
                            </engine:VisualElement>
                        </engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:Instance template="CentralPanelInspectFab" />
            </engine:VisualElement>

            <engine:VisualElement class="autumn-main__crucible-section">
                <engine:VisualElement class="summer-roster__header">
                    <engine:VisualElement class="summer-roster__header-line" />
                    <engine:Label text="Crucible Cards" class="summer-roster__heading" />
                    <engine:VisualElement class="summer-roster__header-line" />
                </engine:VisualElement>
                <engine:VisualElement class="autumn-main__crucible-row">
                    <engine:VisualElement class="crucible-cards">
                    <engine:VisualElement name="crucible-card-0" class="crucible-card">
                        <engine:VisualElement name="crucible-token-0" class="crucible-card__token" />
                        <engine:VisualElement name="crucible-face-0" class="crucible-card__face" style="display: none;">
                            <engine:Label name="crucible-numeral-0" text="" class="crucible-card__numeral" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement name="crucible-card-1" class="crucible-card">
                        <engine:VisualElement name="crucible-token-1" class="crucible-card__token" />
                        <engine:VisualElement name="crucible-face-1" class="crucible-card__face" style="display: none;">
                            <engine:Label name="crucible-numeral-1" text="" class="crucible-card__numeral" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement name="crucible-card-2" class="crucible-card">
                        <engine:VisualElement name="crucible-token-2" class="crucible-card__token" />
                        <engine:VisualElement name="crucible-face-2" class="crucible-card__face" style="display: none;">
                            <engine:Label name="crucible-numeral-2" text="" class="crucible-card__numeral" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement name="crucible-card-3" class="crucible-card">
                        <engine:VisualElement name="crucible-token-3" class="crucible-card__token" />
                        <engine:VisualElement name="crucible-face-3" class="crucible-card__face" style="display: none;">
                            <engine:Label name="crucible-numeral-3" text="" class="crucible-card__numeral" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement class="stage-cta stage-cta--multi">
                <engine:VisualElement class="actionbar__row actionbar__row--primary">
                    <engine:Button name="stasis-btn" text="Stasis" class="actionbtn btn btn--stasis" />
                    <engine:Button name="pass-btn" text="Finish Turn" class="actionbtn btn btn--primary" />
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:Instance template="PlayerInventoryOverlay" />

        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
