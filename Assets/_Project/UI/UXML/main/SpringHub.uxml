<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />
    <engine:Style src="../../USS/SpringSteps.uss" />
    <engine:Style src="../../USS/CentralPanelInspect.uss" />
    <engine:Template src="../shell/GameHeaderOverlay.uxml" name="GameHeaderOverlay" />
    <engine:Template src="../shell/PlayerInventoryOverlay.uxml" name="PlayerInventoryOverlay" />
    <engine:Template src="../shell/CentralPanelInspectFab.uxml" name="CentralPanelInspectFab" />
    <engine:Template src="../shell/TableauStage.uxml" name="TableauStage" />

    <engine:VisualElement name="spring-hub" class="screen screen--spring">
        <engine:Label text="Spring hub — zodiac board, commune, and advance to Summer." class="sr-only" />

        <engine:VisualElement class="screen__body">
            <engine:Instance template="GameHeaderOverlay" />

            <engine:VisualElement class="spring-hub__toolbar">
                <engine:VisualElement class="narrative-toolbar">
                    <engine:Button name="info-btn" text="🗓️" class="narrative-toolbar__info-btn btn btn--secondary" />
                    <engine:Label name="narrative-beat" text="" class="narrative-beat" />
                    <engine:Button name="table-fab" text="🧙" class="narrative-toolbar__table-btn table-fab btn btn--secondary" />
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement class="central-panel">
            <engine:VisualElement name="wheel-stage" class="stage spring-hub__stage">
                <engine:VisualElement name="wheel-stack" class="wheel-stack">
                    <engine:VisualElement name="wheel-star-chart" class="wheel-stack__star" />
                    <engine:VisualElement name="wheel-zodiac" class="wheel-stack__zodiac" />
                    <engine:VisualElement name="wheel-glyph-host" class="wheel-stack__glyph-host">
                        <engine:Label name="wheel-glyph" text="?" class="font-zodiac wheel-stack__glyph" />
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:Label name="rolled-sign" text="" class="spring-hub__rolled-sign" />
                <engine:Label name="sign-match" text="" class="spring-hub__sign-match" />
                <engine:Label name="narrative-charge" text="" class="narrative-charge" />
                <engine:Label name="harvest-count" text="Awaiting your roll" class="spring-hub__harvest-count" />
                <engine:Label name="hint-label" text="Your turn" class="spring-hub__hint" />
            </engine:VisualElement>

            <engine:VisualElement name="hub-stage" class="stage spring-hub__board-stage spring-hub__stage--hidden">
                <engine:VisualElement class="spring-board-panel">
                    <engine:VisualElement name="spring-board" class="spring-board">
                        <engine:VisualElement name="spring-board-wheel" class="spring-board__wheel" />
                        <engine:VisualElement name="spring-board-tokens" class="spring-board__tokens" picking-mode="Ignore" />
                    </engine:VisualElement>
                    <engine:Label name="narrative-charge" text="" class="narrative-charge spring-board-panel__charge" />
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement name="commune-stage" class="commune-stage commune-stage--hidden">
                <engine:Instance template="TableauStage" />
            </engine:VisualElement>
            <engine:Instance template="CentralPanelInspectFab" />
            </engine:VisualElement>

            <engine:VisualElement name="wheel-cta" class="stage-cta stage-cta--single">
                <engine:Button name="wheel-action-btn" text="Roll Your Zodiac Die" class="actionbtn btn btn--primary" />
            </engine:VisualElement>

            <engine:VisualElement name="hub-cta" class="stage-cta stage-cta--multi spring-hub__hub-cta--hidden">
                <engine:Button name="review-tableau-btn" text="Review the Tableau" class="actionbtn btn btn--secondary" />
                <engine:Button name="proceed-btn" text="Proceed To Summer" class="actionbtn btn btn--primary" />
            </engine:VisualElement>

            <engine:VisualElement name="commune-cta" class="stage-cta stage-cta--multi spring-hub__commune-cta--hidden">
                <engine:Button name="review-effects-btn" text="Review Effects" class="actionbtn btn btn--secondary" />
                <engine:Button name="commune-lock-btn" text="Lock The Tableau" class="actionbtn btn btn--primary" />
            </engine:VisualElement>

            <engine:Instance template="PlayerInventoryOverlay" />

        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
