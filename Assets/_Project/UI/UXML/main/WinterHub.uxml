<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />

    <engine:VisualElement name="winter-hub" class="screen screen--winter">

        <engine:VisualElement class="screen__chrome">
            <engine:VisualElement class="game-header">
                <engine:VisualElement class="game-header__row">
                    <engine:VisualElement class="game-header__age-cluster">
                        <engine:VisualElement class="cosmic-age-banner__sigil" />
                        <engine:Label text="cosmic age" class="eyebrow cosmic-age-banner__eyebrow" />
                        <engine:VisualElement class="cosmic-age-banner__row">
                            <engine:Label name="age-sign" text="Scorpio" class="cosmic-age-banner__sign" />
                            <engine:Label text="·" class="cosmic-age-banner__sep" />
                            <engine:Label name="age-planet" text="Mars" class="cosmic-age-banner__planet" />
                            <engine:Label text="·" class="cosmic-age-banner__sep" />
                            <engine:Label name="age-element" text="Water" class="cosmic-age-banner__element" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:Label name="status-round" text="Round 1" class="statusbar__sub game-header__round" />
                </engine:VisualElement>
                <engine:VisualElement class="game-header__row game-header__row--phase">
                    <engine:Label name="status-season" text="Winter" class="statusbar__title game-header__season" />
                    <engine:VisualElement name="step-rail" class="steprail steprail--inline">
                        <engine:VisualElement name="step-0" class="step step--inline"><engine:VisualElement class="step__dot" /><engine:Label text="unlock" class="step__label" /></engine:VisualElement>
                        <engine:VisualElement name="step-1" class="step step--inline"><engine:VisualElement class="step__dot" /><engine:Label text="wager" class="step__label" /></engine:VisualElement>
                        <engine:VisualElement name="step-2" class="step step--inline"><engine:VisualElement class="step__dot" /><engine:Label text="limits" class="step__label" /></engine:VisualElement>
                        <engine:VisualElement name="step-3" class="step step--inline"><engine:VisualElement class="step__dot" /><engine:Label text="transit" class="step__label" /></engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement name="rivals" class="rivals" />

        <engine:VisualElement class="screen__body">
            <engine:VisualElement class="stage" style="padding: 16px;">
                <engine:Label text="closing rites" class="eyebrow" />
                <engine:Label name="limits-line" text="Spread 0/5 · Hand 0/5" style="font-size: 11px; color: rgb(184, 154, 110); margin-bottom: 12px;" />
                <engine:Label name="hint-label" text="Your turn" style="font-size: 11px; color: rgb(158, 201, 224); margin-top: 14px;" />
            </engine:VisualElement>

            <engine:VisualElement class="stage-cta stage-cta--multi stage-cta--winter">
                <engine:Button name="continue-btn" text="Unlock cards" class="actionbtn btn btn--primary" style="display: none;" />
                <engine:Button name="craft-btn" text="Craft reagents" class="actionbtn btn btn--primary" style="display: none;" />
                <engine:Button name="wager-btn" text="Fateful wager" class="actionbtn btn btn--primary" style="display: none;" />
                <engine:Button name="limits-btn" text="Enforce limits" class="actionbtn btn btn--primary" style="display: none;" />
                <engine:Button name="transit-btn" text="Transit the age" class="actionbtn btn btn--primary" style="display: none;" />
                <engine:Button name="pass-btn" text="Pass" class="actionbtn actionbtn--tight btn btn--secondary" />
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement class="screen__inventory">
            <engine:VisualElement class="screen__fab-layer">
                <engine:Button name="hand-btn" text="Hand" class="menu-btn-fab btn btn--secondary" />
                <engine:Button name="menu-btn" text="Table" class="menu-btn-fab btn btn--secondary" />
            </engine:VisualElement>

            <engine:VisualElement class="dock">
                <engine:VisualElement class="dock__header">
                    <engine:Label name="dock-zone-label" text="spread" class="eyebrow" style="margin-bottom: 0;" />
                    <engine:Label name="spread-count" text="0" style="font-size: 10px; color: rgb(184, 154, 110);" />
                </engine:VisualElement>
                <engine:VisualElement name="spread-strip" class="dock__strip" />
            </engine:VisualElement>
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
