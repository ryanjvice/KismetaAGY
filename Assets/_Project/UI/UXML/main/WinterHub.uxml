<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />
    <engine:Style src="../../USS/WinterHub.uss" />
    <engine:Template src="../shell/NarrativeSlots.uxml" name="NarrativeSlots" />
    <engine:Template src="../shell/GameHeaderOverlay.uxml" name="GameHeaderOverlay" />
    <engine:Template src="../shell/PlayerInventoryOverlay.uxml" name="PlayerInventoryOverlay" />

    <engine:VisualElement name="winter-hub" class="screen screen--winter">

        <engine:VisualElement class="screen__body">
            <engine:Instance template="GameHeaderOverlay" />
            <engine:VisualElement class="central-panel">
            <engine:VisualElement name="winter-stage" class="stage winter-hub__stage">
                <engine:VisualElement class="winter-hub__narrative" style="width: 100%; padding: 0 14px 8px;">
                    <engine:Instance template="NarrativeSlots" />
                </engine:VisualElement>
                <engine:VisualElement name="winter-seal" class="winter-seal" />
                <engine:Label text="closing rites" class="eyebrow winter-hub__title" />
                <engine:Label name="limits-line" text="Spread 0/5 · Hand 0/5" class="text-muted winter-hub__limits" />
                <engine:Label name="hint-label" text="Your turn" class="text-hint winter-hub__hint" />
            </engine:VisualElement>

            <engine:VisualElement class="hub-fab-stack">
                <engine:Button name="table-fab" text="Table" class="table-fab btn btn--secondary" />
                <engine:Button name="effects-fab" text="Effects" class="effects-fab btn btn--secondary" />
            </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement class="stage-cta stage-cta--multi stage-cta--winter">
                <engine:Button name="continue-btn" text="Unlock cards" class="actionbtn btn btn--primary" style="display: none;" />
                <engine:Button name="craft-btn" text="Craft reagents" class="actionbtn btn btn--primary" style="display: none;" />
                <engine:Button name="wager-btn" text="Fateful wager" class="actionbtn btn btn--primary" style="display: none;" />
                <engine:Button name="limits-btn" text="Enforce limits" class="actionbtn btn btn--primary" style="display: none;" />
                <engine:Button name="transit-btn" text="Transit the age" class="actionbtn btn btn--primary" style="display: none;" />
                <engine:Button name="pass-btn" text="Pass" class="actionbtn btn btn--secondary" />
            </engine:VisualElement>

            <engine:Instance template="PlayerInventoryOverlay" />
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
