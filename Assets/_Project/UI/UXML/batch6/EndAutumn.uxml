<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />
    <engine:Style src="../../USS/AutumnActions.uss" />

    <engine:VisualElement name="end-autumn" class="sheet end-autumn">

        <engine:VisualElement class="sheet__header end-autumn__header">
            <engine:VisualElement class="statusbar__left">
                <engine:VisualElement class="statusbar__sigil" style="background-color: rgb(42,21,14); border-color: rgb(224, 138, 74);">
                    <engine:Label text="&#xed5a;" class="ti-icon" style="color: rgb(224, 138, 74);" />
                </engine:VisualElement>
                <engine:VisualElement class="end-pass__heading">
                    <engine:Label text="Pass your turn?" class="statusbar__title end-autumn__title" />
                    <engine:Label text="yield the forge — autumn ends when everyone passes in a row" class="statusbar__sub" />
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:Button name="close-btn" text="&#10005;" class="end-autumn__close" />
        </engine:VisualElement>

        <engine:VisualElement class="sheet__body end-autumn__body">
            <engine:VisualElement class="end-autumn__section">
                <engine:Label text="your autumn at the forge" class="end-autumn__eyebrow" />
                <engine:VisualElement name="recap-list" class="end-autumn__recap-list" />
            </engine:VisualElement>

            <engine:VisualElement class="end-autumn__section">
                <engine:Label text="still available this autumn" class="end-autumn__eyebrow" />
                <engine:VisualElement name="still-available" class="end-autumn__hints tip tip--caution" />
                <engine:Label text="passing forfeits any remaining actions this turn" class="end-autumn__footnote" />
            </engine:VisualElement>

            <engine:VisualElement class="end-autumn__actions">
                <engine:Button name="keep-btn" text="Keep forging" class="btn btn--secondary end-autumn__btn" />
                <engine:Button name="end-btn" text="Pass turn" class="btn btn--primary end-autumn__btn end-autumn__btn--pass" />
            </engine:VisualElement>
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
