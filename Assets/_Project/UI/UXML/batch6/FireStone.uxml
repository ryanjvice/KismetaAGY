<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />
    <engine:Style src="../../USS/SummerActions.uss" />
    <engine:Style src="../../USS/AutumnActions.uss" />

    <!-- ============================================================
         FIRE YOUR STONE (#31) — modal. Spend reagents (any type) to advance
         ONE position. Reuses the ReagentStepper + pay-pill. Present as an
         overlay with a scrim over the Autumn forge scene.
         ============================================================ -->
    <engine:VisualElement name="fire-modal" class="modal modal--fire">

        <engine:VisualElement class="modal__header" style="background-color: rgb(36,17,8); border-bottom-color: rgb(74,32,24);">
            <engine:VisualElement style="width: 30px; height: 30px; border-radius: 9px; background-color: rgb(58,26,14); border-width: 1px; border-color: rgb(201, 150, 47); align-items: center; justify-content: center; margin-right: 10px;">
                <engine:Label text="&#xec3a;" class="ti-icon" style="color: rgb(232, 185, 74);" />
            </engine:VisualElement>
            <engine:VisualElement style="flex-grow: 1;">
                <engine:Label text="Fire your stone" style="font-size: 14px; color: rgb(224, 138, 74);" />
                <engine:Label text="spend reagents to advance one position" style="font-size: 10px; color: rgb(184,148,106);" />
            </engine:VisualElement>
            <engine:Button name="fire-close" text="&#10005;" style="background-color: rgba(0,0,0,0); border-width: 0; color: rgb(184, 154, 110); font-size: 18px;" />
        </engine:VisualElement>

        <engine:VisualElement style="padding: 12px 14px 0;">
            <engine:VisualElement class="narrative-slots">
                <engine:Label name="narrative-beat" text="" class="narrative-beat" />
                <engine:Label name="narrative-charge" text="" class="narrative-charge" />
                <engine:VisualElement name="narrative-stakes-wrap" class="narrative-stakes-wrap tip tip--danger">
                    <engine:Label name="narrative-stakes" text="" class="narrative-stakes tip__text" />
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement style="padding: 16px 14px 6px;">
            <!-- position track 5 -> 6 -> (7) -->
            <engine:VisualElement class="track">
                <engine:VisualElement style="align-items: center;">
                    <engine:VisualElement class="track-node track-node--now"><engine:Label name="track-now-val" text="5" /></engine:VisualElement>
                    <engine:Label name="track-now-label" text="now" style="font-size: 8px; color: rgb(184, 154, 110); margin-top: 3px;" />
                </engine:VisualElement>
                <engine:VisualElement class="track-arrow"><engine:VisualElement class="track-conn" /></engine:VisualElement>
                <engine:VisualElement style="align-items: center;">
                    <engine:VisualElement class="track-node track-node--target"><engine:Label name="track-target-val" text="6" /></engine:VisualElement>
                    <engine:Label name="track-target-label" text="target" style="font-size: 8px; color: rgb(232, 185, 74); margin-top: 3px;" />
                </engine:VisualElement>
                <engine:VisualElement class="track-arrow" style="opacity: 0.4;"><engine:Label text="&#8594;" style="color: rgb(184, 154, 110);" /></engine:VisualElement>
                <engine:VisualElement style="align-items: center; opacity: 0.5;">
                    <engine:VisualElement class="track-node track-node--future" style="width: 32px; height: 32px;"><engine:Label text="7" /></engine:VisualElement>
                    <engine:Label text="Gold" style="font-size: 8px; color: rgb(184, 154, 110); margin-top: 3px;" />
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:Label text="alchemical alignment" class="eyebrow" style="color: rgb(154,90,58);" />
            <engine:Label name="align-formula" text="" style="font-size: 10px; color: rgb(184,148,106); margin-bottom: 6px; white-space: normal;" />
            <engine:VisualElement name="align-cards" class="tray__cards" style="margin-bottom: 8px;" />

            <engine:Label text="crucible slot" class="eyebrow" style="color: rgb(154,90,58);" />
            <engine:VisualElement name="crucible-slots" style="flex-direction: row; flex-wrap: wrap; margin-bottom: 8px;" />

            <engine:Label name="cost-summary" text="Alchemical cost" class="eyebrow" style="color: rgb(154,90,58);" />
            <engine:VisualElement name="supply" style="display: none;" />
        </engine:VisualElement>

        <engine:VisualElement class="tip tip--danger">
            <engine:Label text="Advancing to position 6 keeps your stone forging in the open — still exposed to Opposition this age."
                          class="tip__text forge-tip__text" style="color: rgb(212,160,122);" />
        </engine:VisualElement>

        <engine:VisualElement style="padding: 4px 14px 16px;">
            <engine:Button name="fire-btn" text="Spend 2 to advance" class="btn btn--disabled" />
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
