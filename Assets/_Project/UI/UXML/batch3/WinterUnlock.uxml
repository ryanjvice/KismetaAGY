<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />
    <engine:Style src="../../USS/SpringSteps.uss" />

    <!-- ============================================================
         COMMUNE (#14) — tap-to-swap Minor Arcana between Spread and Hand.
         NATIVE NOTE: card chips are built from game state in C# and tapped
         to move zones. The static chips below are layout samples; clear the
         #spread-cards / #hand-cards containers and repopulate at runtime.
         Tap handler: move the chip's data between zones, re-evaluate the
         readout, rebuild both containers. Major Arcana stay in Arcanum
         (not shown here — they are not movable).
         ============================================================ -->
    <engine:VisualElement name="winter-unlock" class="screen screen--winter">

        <engine:VisualElement class="statusbar">
            <engine:VisualElement class="statusbar__left">
                <engine:VisualElement class="statusbar__sigil" style="border-color: rgb(106, 74, 138);">
                    <engine:Label text="&#xeb56;" class="ti-icon" style="color: rgb(205, 176, 224);" />
                </engine:VisualElement>
                <engine:VisualElement>
                    <engine:Label text="Commune" class="statusbar__title" style="color: rgb(205, 176, 224);" />
                    <engine:Label text="rearrange one last time" class="statusbar__sub" />
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement class="tap-swap-body">
            <engine:Label text="Commune with your Tableau" class="commune-stage__heading h3" />

            <engine:VisualElement class="tip tip--arcanum commune-stage__tip">
                <engine:Label text="Tap a card to move it between zones. Spread cards score alignment but can be dueled; Hand cards are safe but idle. Locks until Winter."
                              class="tip__text" style="color: rgb(184,154,192);" />
            </engine:VisualElement>

            <engine:VisualElement class="commune-stage__zone-wrap">
                <engine:VisualElement class="swap-zone swap-zone--spread">
                    <engine:VisualElement class="swap-zone__header">
                        <engine:VisualElement style="flex-direction: row; align-items: center;">
                            <engine:VisualElement style="width: 12px; height: 12px; border-radius: 6px; background-color: rgb(244, 211, 94); margin-right: 6px;" />
                            <engine:Label text="Spread" style="font-size: 12px; color: rgb(244, 211, 94);" />
                            <engine:Label text="visible · duel-exposed" style="font-size: 9px; color: rgb(154,122,122); margin-left: 6px;" />
                        </engine:VisualElement>
                        <engine:Label name="spread-count" text="4" class="text-count" />
                    </engine:VisualElement>
                    <engine:VisualElement name="spread-cards" class="swap-zone__cards">
                        <engine:VisualElement class="card-chip card-chip--wands"><engine:Label text="7" class="card-chip__rank" /><engine:Label text="+1" class="card-chip__tag" /></engine:VisualElement>
                        <engine:VisualElement class="card-chip card-chip--cups"><engine:Label text="K" class="card-chip__rank" /><engine:Label text="+1" class="card-chip__tag" /></engine:VisualElement>
                        <engine:VisualElement class="card-chip card-chip--pentacles"><engine:Label text="3" class="card-chip__rank" /></engine:VisualElement>
                        <engine:VisualElement class="card-chip card-chip--wands"><engine:Label text="A" class="card-chip__rank" /><engine:Label text="+1" class="card-chip__tag" /></engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement class="commune-stage__swap-indicator" picking-mode="Ignore">
                <engine:VisualElement class="commune-stage__swap-badge">
                    <engine:Label text="&#xedb6;" class="ti-icon commune-stage__swap-icon" />
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement class="commune-stage__zone-wrap">
                <engine:VisualElement class="swap-zone swap-zone--hand">
                    <engine:VisualElement class="swap-zone__header">
                        <engine:VisualElement style="flex-direction: row; align-items: center;">
                            <engine:VisualElement style="width: 12px; height: 12px; border-radius: 6px; background-color: rgb(127, 196, 168); margin-right: 6px;" />
                            <engine:Label text="Hand" style="font-size: 12px; color: rgb(127, 196, 168);" />
                            <engine:Label text="hidden · safe" style="font-size: 9px; color: rgb(122,138,122); margin-left: 6px;" />
                        </engine:VisualElement>
                        <engine:Label name="hand-count" text="5" class="text-count" />
                    </engine:VisualElement>
                    <engine:VisualElement name="hand-cards" class="swap-zone__cards">
                        <engine:VisualElement class="card-chip card-chip--swords"><engine:Label text="9" class="card-chip__rank" /></engine:VisualElement>
                        <engine:VisualElement class="card-chip card-chip--pentacles"><engine:Label text="J" class="card-chip__rank" /></engine:VisualElement>
                        <engine:VisualElement class="card-chip card-chip--cups"><engine:Label text="2" class="card-chip__rank" /><engine:Label text="+1" class="card-chip__tag" /></engine:VisualElement>
                        <engine:VisualElement class="card-chip card-chip--swords"><engine:Label text="5" class="card-chip__rank" /></engine:VisualElement>
                        <engine:VisualElement class="card-chip card-chip--wands"><engine:Label text="4" class="card-chip__rank" /><engine:Label text="+1" class="card-chip__tag" /></engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement class="commune-stage__readout-wrap">
                <engine:VisualElement class="readout">
                    <engine:VisualElement class="readout__metric">
                        <engine:Label name="spread-align" text="+4" class="readout__value" style="color: rgb(244, 211, 94);" />
                        <engine:Label text="spread alignment" class="readout__label" />
                    </engine:VisualElement>
                    <engine:VisualElement class="readout__metric">
                        <engine:Label name="hand-safe" text="5" class="readout__value" style="color: rgb(127, 196, 168);" />
                        <engine:Label text="safe in hand" class="readout__label" />
                    </engine:VisualElement>
                    <engine:VisualElement class="readout__metric">
                        <engine:Label name="verdict" text="balanced" class="readout__value" style="color: rgb(243, 233, 210); font-size: 12px;" />
                        <engine:Label text="verdict" class="readout__label" />
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement style="padding: 2px 14px 16px;">
            <engine:Button name="unlock-done-btn" text="Done · to the Fateful Wager" class="btn btn--primary" />
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
