<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />
    <engine:Style src="../../USS/SpringSteps.uss" />

    <!-- ============================================================
         FATEFUL WAGER (#40) — predict next age's sign + stake cards.
         NATIVE NOTE: the 12-sign grid is built in C# (or authored as 12
         buttons). Tapping a sign selects it; tapping hand cards stakes them.
         Optional step — "Skip" is a first-class equal action.
         ============================================================ -->
    <engine:VisualElement name="wager" class="screen screen--winter">

        <engine:VisualElement class="statusbar" style="background-color: rgb(22,32,46); border-bottom-color: rgb(43,58,74);">
            <engine:VisualElement class="statusbar__left">
                <engine:VisualElement class="statusbar__sigil" style="border-color: var(--arcanum-border);">
                    <engine:Label text="&#xeb6c;" class="ti-icon" style="color: var(--arcanum-text);" />
                </engine:VisualElement>
                <engine:VisualElement>
                    <engine:Label text="Fateful Wager" class="statusbar__title" style="color: var(--arcanum-text);" />
                    <engine:Label text="optional · bet on the next age" class="statusbar__sub" style="color: rgb(122,138,154);" />
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>

        <!-- sign grid: 12 buttons, populated/authored; samples below -->
        <engine:VisualElement style="padding: 12px 14px 4px;">
            <engine:Label text="predict the coming sign" class="eyebrow" />
            <engine:VisualElement name="sign-grid" style="flex-direction: row; flex-wrap: wrap; justify-content: space-between;">
                <!-- NATIVE: instantiate 12 sign buttons here with class .sign-cell -->
                <engine:Button name="sign-aries" text="&#9800;" class="sign-cell" />
                <engine:Button name="sign-taurus" text="&#9801;" class="sign-cell" />
                <engine:Button name="sign-gemini" text="&#9802;" class="sign-cell" />
                <engine:Button name="sign-cancer" text="&#9803;" class="sign-cell" />
                <engine:Button name="sign-leo" text="&#9804;" class="sign-cell" />
                <engine:Button name="sign-virgo" text="&#9805;" class="sign-cell" />
                <engine:Button name="sign-libra" text="&#9806;" class="sign-cell" />
                <engine:Button name="sign-scorpio" text="&#9807;" class="sign-cell" />
                <engine:Button name="sign-sagittarius" text="&#9808;" class="sign-cell" />
                <engine:Button name="sign-capricorn" text="&#9809;" class="sign-cell" />
                <engine:Button name="sign-aquarius" text="&#9810;" class="sign-cell" />
                <engine:Button name="sign-pisces" text="&#9811;" class="sign-cell sign-cell--selected" />
            </engine:VisualElement>
        </engine:VisualElement>

        <!-- stake -->
        <engine:VisualElement style="padding: 10px 14px 4px;">
            <engine:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                <engine:Label text="stake from your hand" class="eyebrow" style="margin-bottom: 0;" />
                <engine:Label name="stake-count" text="3 staked" style="font-size: 10px; color: var(--arcanum-text);" />
            </engine:VisualElement>
            <engine:VisualElement name="stake-cards" class="swap-zone__cards">
                <engine:VisualElement class="card-chip card-chip--swords card-chip--selected"><engine:Label text="9" class="card-chip__rank" /></engine:VisualElement>
                <engine:VisualElement class="card-chip card-chip--pentacles card-chip--selected"><engine:Label text="J" class="card-chip__rank" /></engine:VisualElement>
                <engine:VisualElement class="card-chip card-chip--cups card-chip--selected"><engine:Label text="2" class="card-chip__rank" /></engine:VisualElement>
                <engine:VisualElement class="card-chip card-chip--swords"><engine:Label text="5" class="card-chip__rank" /></engine:VisualElement>
                <engine:VisualElement class="card-chip card-chip--wands"><engine:Label text="4" class="card-chip__rank" /></engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement class="tip tip--arcanum">
            <engine:Label name="odds-line" text="If Pisces rules next age, your 3 staked cards double to 6. If wrong, they're lost. Resolves next Spring."
                          class="tip__text" style="color: rgb(184,154,192);" />
        </engine:VisualElement>

        <engine:VisualElement style="padding: 2px 14px 16px; flex-direction: row;">
            <engine:Button name="skip-btn" text="Skip wager" class="btn btn--secondary" style="flex-grow: 1; margin-right: 8px;" />
            <engine:Button name="place-btn" text="Place wager" class="btn"
                           style="flex-grow: 1.4; background-color: var(--arcanum-bg); border-color: rgb(154,122,192); color: var(--arcanum-text);" />
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
