<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />
    <engine:Style src="../../USS/SpringSteps.uss" />

    <engine:VisualElement name="spring-harvest" class="screen screen--spring">
        <engine:Label text="Spring harvest — itemized tally before cards are dealt." class="sr-only" />

        <engine:VisualElement class="screen__chrome">
            <engine:VisualElement name="cosmic-age-banner" class="cosmic-age-banner">
                <engine:VisualElement class="cosmic-age-banner__sigil" />
                <engine:VisualElement class="cosmic-age-banner__body">
                    <engine:Label text="cosmic age · set by agekeeper" class="eyebrow cosmic-age-banner__eyebrow" />
                    <engine:VisualElement class="cosmic-age-banner__row">
                        <engine:Label name="age-sign" text="Scorpio" class="cosmic-age-banner__sign" />
                        <engine:Label text="·" class="cosmic-age-banner__sep" />
                        <engine:Label name="age-planet" text="Mars" class="cosmic-age-banner__planet" />
                        <engine:Label text="·" class="cosmic-age-banner__sep" />
                        <engine:Label name="age-element" text="Water" class="cosmic-age-banner__element" />
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement class="statusbar">
                <engine:VisualElement class="statusbar__left">
                    <engine:VisualElement class="statusbar__sigil" />
                    <engine:VisualElement>
                        <engine:Label name="status-season" text="Spring" class="statusbar__title" />
                        <engine:Label name="status-step" text="step 2 of 3" class="statusbar__sub" />
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:Label name="status-round" text="Round 1" class="statusbar__sub" />
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:Label name="scene-subtitle" text="each source scores its highest aspect" class="spring-hub__subtitle" />

        <engine:VisualElement class="harvest-hero">
            <engine:Label name="harvest-total" text="12" class="harvest-hero__total" />
            <engine:Label text="cards this harvest" class="harvest-hero__label" />
        </engine:VisualElement>

        <engine:VisualElement class="harvest-sources-header">
            <engine:Label text="your harvest sources" class="eyebrow harvest-sources-header__title" />
            <engine:Label name="harvest-summary" text="BASE 3 + BONUS 7 + BOON 2" class="harvest-sources-header__summary" />
        </engine:VisualElement>

        <engine:ScrollView name="source-scroll" class="harvest-source-scroll">
            <engine:VisualElement name="source-list" class="harvest-source-list" />
        </engine:ScrollView>

        <engine:Label name="harvest-footnote" text="each source counts only its single highest aspect — not stacked" class="harvest-footnote" />

        <engine:VisualElement class="actionbar">
            <engine:Button name="deal-btn" text="Deal harvest &amp; commune" class="actionbtn btn btn--primary" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
