<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />
    <engine:Style src="../../USS/SpringSteps.uss" />
    <engine:Template src="../shell/TableauStage.uxml" name="TableauStage" />

    <engine:VisualElement name="spring-harvest" class="screen screen--spring">
        <engine:Label text="Spring harvest — itemized tally before cards are dealt." class="sr-only" />

        <engine:VisualElement class="screen__chrome">
            <engine:VisualElement class="game-header">
                <engine:VisualElement class="game-header__row">
                    <engine:VisualElement class="game-header__age-cluster">
                        <engine:VisualElement class="cosmic-age-banner__sigil" />
                        <engine:Label text="cosmic age" class="eyebrow cosmic-age-banner__eyebrow" />
                        <engine:VisualElement class="cosmic-age-banner__row">
                            <engine:Label name="age-sign" text="Scorpio" class="cosmic-age-banner__sign" />
                            <engine:Label text="·" class="cosmic-age-banner__sep" />
                            <engine:Label name="age-planet" text="Mars" class="cosmic-age-banner__planet" />
                            <engine:Label text="·" class="cosmic-age-banner__sep" />
                            <engine:Label name="age-element" text="Water" class="cosmic-age-banner__element" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:Label name="status-round" text="Round 1" class="statusbar__sub game-header__round" />
                </engine:VisualElement>
                <engine:VisualElement class="game-header__row game-header__row--phase">
                    <engine:Label name="status-season" text="Spring" class="statusbar__title game-header__season" />
                    <engine:VisualElement name="step-rail" class="steprail steprail--inline">
                        <engine:VisualElement name="step-0" class="step step--inline"><engine:VisualElement class="step__dot" /><engine:Label text="age" class="step__label" /></engine:VisualElement>
                        <engine:VisualElement name="step-1" class="step step--inline"><engine:VisualElement class="step__dot" /><engine:Label text="sign" class="step__label" /></engine:VisualElement>
                        <engine:VisualElement name="step-2" class="step step--inline"><engine:VisualElement class="step__dot" /><engine:Label text="harvest" class="step__label" /></engine:VisualElement>
                        <engine:VisualElement name="step-3" class="step step--inline"><engine:VisualElement class="step__dot" /><engine:Label text="commune" class="step__label" /></engine:VisualElement>
                        <engine:VisualElement name="step-4" class="step step--inline"><engine:VisualElement class="step__dot" /><engine:Label text="lock" class="step__label" /></engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement name="harvest-tally" class="harvest-tally">
        <engine:VisualElement class="harvest-heading-row">
            <engine:Label text="Harvest Results" class="h2 harvest-compare__heading" />
            <engine:Label name="narrative-beat" text="" class="narrative-beat harvest-heading-row__beat" />
        </engine:VisualElement>

        <engine:VisualElement class="harvest-compare">
            <engine:VisualElement name="compare-age-panel" class="harvest-compare__panel">
                <engine:Label text="cosmic age" class="eyebrow harvest-compare__eyebrow" />
                <engine:VisualElement name="compare-age-sigil" class="harvest-compare__sigil" />
                <engine:Label name="compare-age-sign" text="Scorpio" class="harvest-compare__sign" />
                <engine:VisualElement class="harvest-compare__aspects">
                    <engine:Label name="compare-age-planet" text="Mars" class="harvest-compare__chip harvest-compare__chip--planet" />
                    <engine:Label name="compare-age-element" text="Water" class="harvest-compare__chip" />
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:VisualElement name="compare-player-panel" class="harvest-compare__panel">
                <engine:Label text="your sign" class="eyebrow harvest-compare__eyebrow" />
                <engine:VisualElement name="compare-player-sigil" class="harvest-compare__sigil" />
                <engine:Label name="compare-player-sign" text="Pisces" class="harvest-compare__sign" />
                <engine:VisualElement class="harvest-compare__aspects">
                    <engine:Label name="compare-player-planet" text="Neptune" class="harvest-compare__chip harvest-compare__chip--planet" />
                    <engine:Label name="compare-player-element" text="Water" class="harvest-compare__chip" />
                </engine:VisualElement>
                <engine:Label name="compare-alignment" text="+1 element match" class="harvest-compare__alignment" />
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement class="harvest-sources">
            <engine:VisualElement class="harvest-sources-heading-row">
                <engine:Label text="Harvest Sources" class="h2 harvest-sources__title" />
                <engine:Label name="narrative-stakes" text="" class="narrative-stakes harvest-sources-heading-row__rule" />
            </engine:VisualElement>

            <engine:ScrollView name="source-scroll" class="harvest-source-scroll">
                <engine:VisualElement name="source-list" class="harvest-source-list" />
            </engine:ScrollView>
        </engine:VisualElement>

        <engine:VisualElement class="harvest-footer">
            <engine:Button name="deal-btn" class="harvest-hero harvest-hero--action">
                <engine:Label name="harvest-summary" text="BASE 3 + BONUS 0 + BOON 0" class="harvest-hero__breakdown" />
                <engine:Label name="harvest-total-line" text="3 cards this harvest" class="harvest-hero__total" />
                <engine:Label name="deal-cta" text="→ Deal 3 cards" class="harvest-hero__cta" />
            </engine:Button>
        </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement name="harvest-tableau" class="harvest-tableau harvest-tableau--hidden">
            <engine:Instance template="TableauStage" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
