<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />
    <engine:Style src="../../USS/AgeCeremony.uss" />
    <engine:Style src="../../USS/SeasonIntro.uss" />

    <engine:VisualElement name="summer-intro-overview" class="ceremony-reveal-body season-intro-overview">
        <engine:VisualElement class="ceremony-panel-wrap">
            <engine:VisualElement class="panel intro-info-panel">
                <engine:VisualElement class="intro-info-panel__icon-wrap">
                    <engine:Label text="&#xea6c;" class="ti-icon" />
                </engine:VisualElement>
                <engine:VisualElement class="intro-info-panel__body">
                    <engine:Label text="cards are locked · contests await" class="eyebrow intro-info-panel__eyebrow" />
                    <engine:Label name="narrative-charge"
                                  text="take any actions, in any order, as many as you can fuel"
                                  class="intro-info-panel__subtitle narrative-charge" />
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement class="ceremony-panel-wrap">
            <engine:VisualElement class="panel intro-content-panel">
                <engine:Label text="with rivals — contest freely" class="eyebrow intro-content-panel__eyebrow" />
                <engine:VisualElement name="intro-actions" class="intro-actions">
                    <engine:VisualElement class="intro-action-row">
                        <engine:VisualElement class="intro-action-row__icon intro-action-row__icon--blue">
                            <engine:Label text="&#xeb2e;" class="ti-icon" />
                        </engine:VisualElement>
                        <engine:VisualElement class="intro-action-row__text">
                            <engine:Label text="Trade" class="intro-action-row__title" />
                            <engine:Label text="propose a card swap with a rival" class="intro-action-row__subtitle" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement class="intro-action-row">
                        <engine:VisualElement class="intro-action-row__icon intro-action-row__icon--red">
                            <engine:Label text="&#xeb4c;" class="ti-icon" />
                        </engine:VisualElement>
                        <engine:VisualElement class="intro-action-row__text">
                            <engine:Label text="Duel" class="intro-action-row__title" />
                            <engine:Label text="ante a card, roll, winner takes a spread card" class="intro-action-row__subtitle" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement class="intro-action-row">
                        <engine:VisualElement class="intro-action-row__icon intro-action-row__icon--caution">
                            <engine:Label text="&#xed29;" class="ti-icon" />
                        </engine:VisualElement>
                        <engine:VisualElement class="intro-action-row__text">
                            <engine:Label text="Gambit" class="intro-action-row__title" />
                            <engine:Label text="pay the ward fee, stake a card for an active card" class="intro-action-row__subtitle" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement class="intro-action-row">
                        <engine:VisualElement class="intro-action-row__icon intro-action-row__icon--red">
                            <engine:Label text="&#xeb4c;" class="ti-icon" />
                        </engine:VisualElement>
                        <engine:VisualElement class="intro-action-row__text">
                            <engine:Label text="Build Astral House" class="intro-action-row__title" />
                            <engine:Label text="pay planet-matching cards to permanently claim a sign" class="intro-action-row__subtitle" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
