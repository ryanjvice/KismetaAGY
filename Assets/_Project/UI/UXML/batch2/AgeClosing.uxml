<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />
    <engine:Style src="../../USS/AgeCeremony.uss" />

    <!-- AGE CLOSING — close ceremony + standings recap. -->
    <engine:VisualElement name="age-close" class="screen screen--menu">

        <engine:VisualElement class="menu-screen__hero panel--gold">
            <engine:Label text="The Age Sets." class="ceremony-eyebrow" />

            <engine:VisualElement name="age-sigil" class="ceremony-sigil ceremony-sigil--close">
                <engine:Label text="?" class="ceremony-sigil__glyph font-zodiac" />
            </engine:VisualElement>

            <engine:Label text="the age of" class="ceremony-prelabel" />
            <engine:Label name="age-name" text="SCORPIO" class="ceremony-agename ceremony-agename--close" />
            <engine:Label text="has passed" class="ceremony-prelabel ceremony-prelabel--after" />

            <engine:Label text="Turn the wheel. Pass the key and begin the next Cosmic Age."
                          class="ceremony-couplet" />
        </engine:VisualElement>

        <engine:ScrollView class="menu-screen__scroll menu-screen__scroll--grow">
            <engine:VisualElement class="ceremony-panel-wrap">
                <engine:Label text="how the age moved the board" class="eyebrow" />
                <engine:VisualElement name="standings-list" />
            </engine:VisualElement>

            <engine:VisualElement class="ceremony-panel-wrap ceremony-panel-wrap--callout">
                <engine:VisualElement class="panel tip--arcanum">
                    <engine:Label name="keypass-line" text="The key passes to Aurelia. She will cast the next age — its sign is unknown until the dice fall."
                                  class="tip__text ceremony-callout__text" />
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:ScrollView>

        <engine:VisualElement class="menu-screen__footer">
            <engine:Button name="next-age-btn" text="Turn the wheel · cast the next age" class="btn btn--secondary menu-screen__cta" />
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
