<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />
    <engine:Style src="../../USS/AgeCeremony.uss" />
    <engine:Style src="../../USS/SeasonIntro.uss" />

    <engine:VisualElement name="winter-intro-overview" class="ceremony-reveal-body season-intro-overview">
        <engine:VisualElement class="ceremony-panel-wrap">
            <engine:VisualElement class="panel intro-info-panel">
                <engine:VisualElement class="intro-info-panel__icon-wrap">
                    <engine:Label text="&#xec3a;" class="ti-icon" />
                </engine:VisualElement>
                <engine:VisualElement class="intro-info-panel__body">
                    <engine:Label text="the age of Scorpio ends" class="eyebrow intro-info-panel__eyebrow" />
                    <engine:Label name="narrative-charge"
                                  text="mars · water — a strong age for your forging run"
                                  class="intro-info-panel__subtitle narrative-charge" />
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement class="ceremony-panel-wrap">
            <engine:VisualElement class="panel intro-content-panel">
                <engine:Label text="four steps to close the age" class="eyebrow intro-content-panel__eyebrow" />
                <engine:VisualElement name="intro-steps">
                    <engine:VisualElement class="intro-row">
                        <engine:VisualElement class="intro-row__num intro-row__num--winter">
                            <engine:Label text="1" class="intro-row__num-label" />
                        </engine:VisualElement>
                        <engine:Label text="Unlock cards" class="intro-row__label" />
                    </engine:VisualElement>
                    <engine:VisualElement class="intro-row">
                        <engine:VisualElement class="intro-row__num intro-row__num--purple">
                            <engine:Label text="2" class="intro-row__num-label" />
                        </engine:VisualElement>
                        <engine:Label text="Fateful Wager" class="intro-row__label" />
                    </engine:VisualElement>
                    <engine:VisualElement class="intro-row">
                        <engine:VisualElement class="intro-row__num intro-row__num--green">
                            <engine:Label text="3" class="intro-row__num-label" />
                        </engine:VisualElement>
                        <engine:Label text="Card limits" class="intro-row__label" />
                    </engine:VisualElement>
                    <engine:VisualElement class="intro-row">
                        <engine:VisualElement class="intro-row__num intro-row__num--gold">
                            <engine:Label text="4" class="intro-row__num-label" />
                        </engine:VisualElement>
                        <engine:Label text="Transit the age" class="intro-row__label" />
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
