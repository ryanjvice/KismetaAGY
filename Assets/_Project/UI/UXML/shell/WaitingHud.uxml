<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />

    <engine:VisualElement name="waiting-hud" class="screen screen--winter">

        <engine:VisualElement class="screen__body" style="justify-content: center; align-items: center;">
            <engine:Label name="waiting-label" text="Waiting…" class="shell-hud__title" />
            <engine:Label name="season-label" text="" class="shell-hud__subtitle" />
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
