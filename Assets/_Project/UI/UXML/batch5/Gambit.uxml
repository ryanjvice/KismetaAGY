<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />
    <engine:Style src="../../USS/SummerActions.uss" />
    <engine:Style src="../../USS/Contests.uss" />
    <engine:Template src="../shell/NarrativeSlots.uxml" name="NarrativeSlots" />

    <!-- ============================================================
         GAMBIT (#48) — 4-step: target active card → pay ward fee → stake a
         matching-type card → roll. Win swaps; loss arrests your stake.
         NATIVE NOTE: the fee step reuses the ReagentStepper (Batch 4). If the
         target is unwarded, skip the fee step in C#. Arrested cards are valid
         targets. Four step panels stacked; show one at a time.
         ============================================================ -->
    <engine:VisualElement name="gambit" class="screen" style="background-color: rgb(22,18,8);">
        <engine:Label text="Gambit — steal an active rival card by rolling higher than their defense." class="sr-only" />

        <engine:VisualElement class="statusbar" style="border-bottom-color: rgb(74,62,24);">
            <engine:VisualElement class="statusbar__left">
                <engine:Button name="back-btn" text="&#8592;" style="background-color: rgba(0,0,0,0); border-width: 0; color: rgb(184, 154, 110); font-size: 18px;" />
                <engine:Label name="contest-title" text="Gambit · Iolanthe" class="statusbar__title" style="color: rgb(224,200,120); margin-left: 4px;" />
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement class="wizard-steps">
            <engine:VisualElement name="wg-1" class="wizard-dot wizard-dot--active" />
            <engine:VisualElement name="wg-2" class="wizard-dot" />
            <engine:VisualElement name="wg-3" class="wizard-dot" />
            <engine:VisualElement name="wg-4" class="wizard-dot" />
        </engine:VisualElement>

        <engine:VisualElement style="padding: 4px 14px 0;">
            <engine:Instance template="NarrativeSlots" />
        </engine:VisualElement>

        <!-- step 1: target active card -->
        <engine:VisualElement name="step-target" style="padding: 8px 14px 4px;">
            <engine:Label text="choose a rival" class="eyebrow" />
            <engine:VisualElement name="rival-cards" class="tray__cards" style="margin-bottom: 8px;" />
            <engine:Label name="ward-note" text="select a rival to see ward fee" style="font-size: 10px; color: rgb(224,200,120); margin-bottom: 6px;" />
            <engine:Button name="g-target-next" text="Challenge this rival" class="btn btn--primary" style="margin-top: 8px;" />
        </engine:VisualElement>

        <!-- step 2: pay ward fee (reuses stepper; skipped if unwarded) -->
        <engine:VisualElement name="step-fee" style="display: none; padding: 8px 14px 4px;">
            <engine:Label text="rival pays the ward fee to enter" class="eyebrow" />
            <engine:VisualElement class="pay-pill">
                <engine:VisualElement style="flex-direction: row; align-items: center;">
                    <engine:Label text="paying" style="font-size: 10px; color: rgb(184, 154, 110); margin-right: 8px;" />
                    <engine:VisualElement name="fee-slots" style="flex-direction: row;">
                        <engine:VisualElement class="pay-slot pay-slot--empty" />
                        <engine:VisualElement class="pay-slot pay-slot--empty" />
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:Label name="fee-count" text="0 / 2" style="font-size: 11px; color: rgb(184, 154, 110);" />
            </engine:VisualElement>
            <engine:VisualElement name="fee-supply">
                <engine:VisualElement class="stepper-row">
                    <engine:VisualElement class="reagent-dot reagent-dot--salt" style="margin-right: 9px;" />
                    <engine:Label text="Salt" style="flex-grow: 1; font-size: 12px; color: rgb(243, 233, 210);" />
                    <engine:Button name="fee-salt-minus" class="stepper-btn stepper-btn--minus"><engine:Label text="&#8722;" style="color: rgb(212,160,122);" /></engine:Button>
                    <engine:Label name="fee-salt-val" text="0" class="stepper-value" style="color: rgb(184, 154, 110);" />
                    <engine:Button name="fee-salt-plus" class="stepper-btn stepper-btn--plus"><engine:Label text="+" style="color: rgb(232, 185, 74);" /></engine:Button>
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:Button name="g-fee-next" text="Pay 2 more" class="btn btn--disabled" style="margin-top: 8px;" />
        </engine:VisualElement>

        <!-- step 3: stake -->
        <engine:VisualElement name="step-stake" style="display: none; padding: 8px 14px 4px;">
            <engine:Label text="stake a matching-type card" class="eyebrow" />
            <engine:Label text="win to swap · lose and it's arrested (1 Salt to free)" style="font-size: 10px; color: rgb(184, 154, 110); margin-bottom: 8px; white-space: normal;" />
            <engine:VisualElement name="stake-cards" class="tray__cards" />
            <engine:Button name="g-stake-next" text="Stake &amp; roll" class="btn btn--primary" style="margin-top: 12px;" />
        </engine:VisualElement>

        <!-- step 4: roll -->
        <engine:VisualElement name="step-roll" style="display: none; padding: 8px 14px 4px;">
            <engine:VisualElement class="dice-row">
                <engine:VisualElement style="align-items: center;">
                    <engine:VisualElement name="die-you" class="die-big die-big--you"><engine:Label name="die-you-pip" text="?" class="die-big__pip" style="color: rgb(232, 185, 74);" /></engine:VisualElement>
                    <engine:Label text="you" style="font-size: 9px; color: rgb(184, 154, 110); margin-top: 4px;" />
                </engine:VisualElement>
                <engine:Label text="vs" class="die-vs" />
                <engine:VisualElement style="align-items: center;">
                    <engine:VisualElement name="die-foe" class="die-big die-big--foe"><engine:Label name="die-foe-pip" text="?" class="die-big__pip" style="color: rgb(184,154,192);" /></engine:VisualElement>
                    <engine:Label text="Iolanthe" style="font-size: 9px; color: rgb(184, 154, 110); margin-top: 4px;" />
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:Button name="g-roll-btn" text="Roll the dice" class="btn btn--primary" />
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
