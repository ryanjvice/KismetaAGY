<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />

    <!-- ============================================================
         COMPACT SETUP SHEET — bottom sheet that rises over the title.
         NATIVE NOTE: present as an overlay. In Unity add this tree to a
         top-level overlay VisualElement with a dimmed scrim behind, and
         animate translateY in C# (experimental.animation) for the rise.
         ============================================================ -->
    <engine:VisualElement name="setup-sheet" class="sheet sheet--setup">

        <engine:VisualElement class="sheet__header">
            <engine:Label text="New game" class="statusbar__title text-gold" />
            <engine:Button name="close-btn" text="&#10005;" class="btn-back" />
        </engine:VisualElement>

        <engine:VisualElement class="sheet__body">
            <engine:Label text="alchemists" class="eyebrow" />
            <engine:VisualElement name="player-row" class="setup-section" style="flex-direction: row;">
                <engine:Button name="players-2" text="2" class="player-pip" />
                <engine:Button name="players-3" text="3" class="player-pip player-pip--active" />
                <engine:Button name="players-4" text="4" class="player-pip" />
            </engine:VisualElement>

            <engine:Label text="game mode" class="eyebrow" />
            <engine:VisualElement name="mode-list" class="setup-section">
                <engine:Button name="mode-quickplay" class="mode-row">
                    <engine:Label text="Quickplay" style="flex-grow: 1; font-size: 13px; color: rgb(243, 233, 210);" />
                    <engine:Label text="~30 min" class="setup-row__meta" style="color: rgb(127, 196, 168);" />
                </engine:Button>
                <engine:Button name="mode-standard" class="mode-row mode-row--active">
                    <engine:Label text="Standard" style="flex-grow: 1; font-size: 13px; color: rgb(243, 233, 210);" />
                    <engine:Label text="~60 min" class="setup-row__meta" style="color: rgb(201, 150, 47);" />
                </engine:Button>
                <engine:Button name="mode-magnus" class="mode-row">
                    <engine:Label text="Magnus Alchemist" style="flex-grow: 1; font-size: 13px; color: rgb(243, 233, 210);" />
                    <engine:Label text="~90 min" class="setup-row__meta" style="color: rgb(205, 176, 224);" />
                </engine:Button>
            </engine:VisualElement>

            <engine:Label text="crucible deck" class="eyebrow" />
            <engine:VisualElement name="deck-list" class="setup-section">
                <engine:Button name="deck-curated" class="mode-row mode-row--active">
                    <engine:Label text="Curated" style="flex-grow: 1; font-size: 13px; color: rgb(243, 233, 210);" />
                    <engine:Label text="preset for mode" class="setup-row__meta" style="color: rgb(184, 154, 110);" />
                </engine:Button>
                <engine:Button name="deck-random" class="mode-row">
                    <engine:Label text="Let the Fates Decide" style="flex-grow: 1; font-size: 13px; color: rgb(243, 233, 210);" />
                    <engine:Label text="random cards" class="setup-row__meta" style="color: rgb(205, 176, 224);" />
                </engine:Button>
            </engine:VisualElement>

            <engine:Button name="begin-btn" text="Start Game" class="btn btn--primary" />
            <engine:Label name="summary" text="3 alchemists · Standard · curated deck"
                          class="setup-sheet__summary" />
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
