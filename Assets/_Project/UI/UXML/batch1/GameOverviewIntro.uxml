<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />
    <engine:Style src="../../USS/AgeCeremony.uss" />
    <engine:Style src="../../USS/SeasonIntro.uss" />
    <engine:Style src="../../USS/GameOverviewIntro.uss" />

    <engine:VisualElement name="game-overview-intro" class="screen screen--menu intro--overview">

        <engine:VisualElement class="menu-screen__hero panel--gold">
            <engine:VisualElement class="intro-sigil">
                <engine:VisualElement name="intro-sigil-art" class="intro-sigil__art" />
            </engine:VisualElement>
            <engine:Label text="THE GREAT YEAR" class="intro-name" />
            <engine:Label text="YOUR QUEST BEGINS" class="intro-tagline" />
            <engine:Label name="narrative-beat"
                          text="You and your rival Alchemists journey through Cosmic Ages, each shaped by the stars."
                          class="intro-couplet narrative-beat" />
        </engine:VisualElement>

        <engine:VisualElement class="ceremony-reveal-body">
            <engine:VisualElement class="ceremony-panel-wrap">
                <engine:VisualElement class="panel intro-content-panel">
                    <engine:Label text="The Great Work" class="eyebrow intro-content-panel__eyebrow" />
                    <engine:VisualElement name="intro-goals">
                        <engine:VisualElement class="intro-row">
                            <engine:VisualElement class="intro-row__num intro-row__num--gold">
                                <engine:Label text="1" class="intro-row__num-label" />
                            </engine:VisualElement>
                            <engine:Label text="Align with each Cosmic Age to gather the cards you need." class="intro-row__label" />
                        </engine:VisualElement>
                        <engine:VisualElement class="intro-row">
                            <engine:VisualElement class="intro-row__num intro-row__num--purple">
                                <engine:Label text="2" class="intro-row__num-label" />
                            </engine:VisualElement>
                            <engine:Label text="Work with, attack and defend yourself against your Rivals." class="intro-row__label" />
                        </engine:VisualElement>
                        <engine:VisualElement class="intro-row">
                            <engine:VisualElement class="intro-row__num intro-row__num--green">
                                <engine:Label text="3" class="intro-row__num-label" />
                            </engine:VisualElement>
                            <engine:Label text="Win by completing all four Crucible Cards and reaching the Altar before your rivals." class="intro-row__label" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement class="ceremony-panel-wrap">
                <engine:VisualElement class="panel intro-content-panel">
                    <engine:Label text="One Age - Four Seasons" class="eyebrow intro-content-panel__eyebrow" />
                    <engine:VisualElement name="intro-steps">
                        <engine:VisualElement class="intro-row">
                            <engine:VisualElement class="intro-row__num intro-row__num--green">
                                <engine:Label text="1" class="intro-row__num-label" />
                            </engine:VisualElement>
                            <engine:Label text="Spring: Set the Age, Harvest and Commune with your Tableau" class="intro-row__label" />
                        </engine:VisualElement>
                        <engine:VisualElement class="intro-row">
                            <engine:VisualElement class="intro-row__num intro-row__num--gold">
                                <engine:Label text="2" class="intro-row__num-label" />
                            </engine:VisualElement>
                            <engine:Label text="Summer: Craft, Trade, and Duel Rivals" class="intro-row__label" />
                        </engine:VisualElement>
                        <engine:VisualElement class="intro-row">
                            <engine:VisualElement class="intro-row__num intro-row__num--red">
                                <engine:Label text="3" class="intro-row__num-label" />
                            </engine:VisualElement>
                            <engine:Label text="Autumn: Navigate the Crucible and Stasis" class="intro-row__label" />
                        </engine:VisualElement>
                        <engine:VisualElement class="intro-row">
                            <engine:VisualElement class="intro-row__num intro-row__num--winter">
                                <engine:Label text="4" class="intro-row__num-label" />
                            </engine:VisualElement>
                            <engine:Label text="Winter: Fateful Wager, card limits, transit the age" class="intro-row__label" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement class="menu-screen__footer">
            <engine:Button name="continue-btn" text="Determine the Agekeeper" class="btn btn--primary menu-screen__cta" />
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
