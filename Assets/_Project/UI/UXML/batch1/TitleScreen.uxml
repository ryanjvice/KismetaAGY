<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />
    <engine:Style src="../../USS/TitleScreen.uss" />

    <engine:VisualElement name="title-screen" class="screen screen--title">
        <engine:Label text="Title screen — start a new game, resume, join, open the codex, or adjust settings." class="sr-only" />

        <engine:VisualElement name="title-hero" class="title-hero">
            <engine:VisualElement class="title-hero__content">
                <engine:VisualElement name="title-wordmark-img" class="title-wordmark-img" />
                <engine:VisualElement class="title-hero__wheel-stage">
                    <engine:VisualElement name="title-wheel-stack" class="title-wheel-stack">
                        <engine:VisualElement name="title-screen-star" class="title-screen__star-field" />
                        <engine:VisualElement name="title-wheel-zodiac" class="title-wheel-stack__zodiac" />
                        <engine:VisualElement name="title-wheel-mantle" class="title-wheel-stack__mantle" />
                        <engine:VisualElement name="title-wheel-forge" class="title-wheel-stack__forge" />
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement name="title-tagline-img" class="title-tagline-img" />
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement class="title-menu">
            <engine:Button name="new-game-btn" text="New Game" class="btn btn--primary title-menu__primary" />

            <engine:VisualElement class="title-menu__row">
                <engine:Button name="resume-btn" text="Resume" class="btn btn--menu" />
                <engine:Button name="join-btn" text="Join" class="btn btn--menu" />
            </engine:VisualElement>

            <engine:VisualElement class="title-menu__row">
                <engine:Button name="codex-btn" text="Codex" class="btn btn--menu" />
                <engine:Button name="settings-btn" text="Settings" class="btn btn--menu" />
            </engine:VisualElement>
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
