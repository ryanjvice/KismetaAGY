<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />

    <engine:VisualElement name="agekeeper-contest" class="screen screen--menu">
        <engine:Label text="Agekeeper contest — each alchemist rolls; highest becomes first Agekeeper." class="sr-only" />

        <engine:VisualElement class="menu-screen__hero panel--gold">
            <engine:Label text="determine the agekeeper" class="eyebrow" />
            <engine:Label text="Roll the dice" class="statusbar__title text-gold menu-screen__hero-title" />
            <engine:Label name="status-line" text="Each alchemist rolls their zodiac die — highest holds the key first."
                          class="text-muted menu-screen__hero-sub" />
        </engine:VisualElement>

        <engine:ScrollView name="player-rolls" class="menu-screen__scroll menu-screen__scroll--grow" />

        <engine:VisualElement class="menu-screen__footer">
            <engine:Label name="winner-line" text=""
                          class="text-ok menu-screen__winner" />
            <engine:Button name="roll-btn" text="Roll the dice" class="btn btn--primary menu-screen__cta" />
            <engine:Button name="continue-btn" text="Begin the Great Year" class="btn btn--primary menu-screen__cta menu-screen__cta--hidden" />
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
