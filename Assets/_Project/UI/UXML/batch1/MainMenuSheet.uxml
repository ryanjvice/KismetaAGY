<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />

    <engine:VisualElement name="main-menu-sheet" class="sheet sheet--main-menu">

        <engine:VisualElement class="sheet__header">
            <engine:Label text="Menu" class="statusbar__title text-gold" />
            <engine:Button name="main-menu-close-btn" text="&#10005;" class="btn-back" />
        </engine:VisualElement>

        <engine:VisualElement class="sheet__body">
            <engine:VisualElement class="setup-section">
                <engine:Button name="main-menu-return-btn" class="mode-row">
                    <engine:Label text="Return to Main Menu" style="flex-grow: 1; font-size: 13px; color: rgb(243, 233, 210);" />
                </engine:Button>
                <engine:Button name="main-menu-settings-btn" class="mode-row">
                    <engine:Label text="Settings" style="flex-grow: 1; font-size: 13px; color: rgb(243, 233, 210);" />
                </engine:Button>
                <engine:Button name="main-menu-rules-btn" class="mode-row">
                    <engine:Label text="Rules" style="flex-grow: 1; font-size: 13px; color: rgb(243, 233, 210);" />
                </engine:Button>
                <engine:Button name="main-menu-quit-btn" class="mode-row">
                    <engine:Label text="Quit" style="flex-grow: 1; font-size: 13px; color: rgb(243, 233, 210);" />
                </engine:Button>
            </engine:VisualElement>
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
