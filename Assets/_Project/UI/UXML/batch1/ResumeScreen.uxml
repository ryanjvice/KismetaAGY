<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />

    <engine:VisualElement name="resume-screen" class="screen" style="background-color: rgb(19,16,15);">

        <engine:VisualElement class="statusbar">
            <engine:VisualElement class="statusbar__left">
                <engine:Button name="back-btn" text="&#8592;" style="background-color: rgba(0,0,0,0); border-width: 0; color: rgb(184, 154, 110); font-size: 18px;" />
                <engine:Label text="Resume" class="statusbar__title" style="margin-left: 4px;" />
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement class="screen__body" style="padding: 16px;">
            <engine:Label text="saved games" class="eyebrow" style="margin-bottom: 10px;" />
            <engine:ScrollView name="resume-list" style="flex-grow: 1;">
                <!-- Rows populated by ResumeScreenController -->
            </engine:ScrollView>
            <engine:Label name="resume-empty" text="No saved games yet."
                          style="font-size: 11px; color: rgb(184, 154, 110); -unity-text-align: middle-center; margin-top: 24px; white-space: normal; display: none;" />
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
