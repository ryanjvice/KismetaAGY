<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />

    <engine:VisualElement name="resume-screen" class="screen screen--menu">

        <engine:VisualElement class="statusbar">
            <engine:VisualElement class="statusbar__left">
                <engine:Button name="back-btn" text="&#8592;" class="btn-back" />
                <engine:Label text="Resume" class="statusbar__title menu-screen__title" />
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement class="screen__body menu-screen__list-wrap">
            <engine:Label text="saved games" class="eyebrow" />
            <engine:ScrollView name="resume-list" class="menu-screen__scroll">
            </engine:ScrollView>
            <engine:Label name="resume-empty" text="No saved games yet."
                          class="text-muted menu-screen__empty" />
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
