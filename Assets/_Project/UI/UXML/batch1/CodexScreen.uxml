<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />

    <!-- ============================================================
         CODEX — searchable reference (how-to-play uses the same shell).
         NATIVE NOTE: content is data-driven. Bind the search TextField
         and populate #codex-list from a ScriptableObject/JSON of cards,
         ages, states, and glossary terms in C#. Rows shown are samples.
         ============================================================ -->
    <engine:VisualElement name="codex-screen" class="screen screen--menu">

        <engine:VisualElement class="statusbar">
            <engine:VisualElement class="statusbar__left">
                <engine:Button name="back-btn" text="&#8592;" class="btn-back" />
                <engine:Label text="Codex" class="statusbar__title menu-screen__title" />
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement class="menu-screen__search-wrap">
            <engine:TextField name="codex-search" class="menu-screen__search" />
        </engine:VisualElement>

        <engine:VisualElement class="menu-screen__tabs">
            <engine:Button name="tab-cards" text="Cards" class="codex-tab codex-tab--active" />
            <engine:Button name="tab-ages" text="Ages" class="codex-tab" />
            <engine:Button name="tab-states" text="States" class="codex-tab" />
            <engine:Button name="tab-terms" text="Terms" class="codex-tab" />
        </engine:VisualElement>

        <!-- scrollable list -->
        <engine:ScrollView name="codex-list" class="menu-screen__codex-list">
            <engine:VisualElement class="panel menu-screen__panel">
                <engine:Label text="Minor Arcana" class="text-ink" />
                <engine:Label text="Pip cards — rank + suit drive crafting, sets and alignment." class="text-muted menu-screen__panel-sub" />
            </engine:VisualElement>
            <engine:VisualElement class="panel menu-screen__panel">
                <engine:Label text="Adept (Major Arcana)" class="text-ink" />
                <engine:Label text="Active ability placed in your Arcanum; up to 2 active." class="text-muted menu-screen__panel-sub" />
            </engine:VisualElement>
            <engine:VisualElement class="panel menu-screen__panel">
                <engine:Label text="Fate (Major Arcana)" class="text-ink" />
                <engine:Label text="Resolves the instant it's drawn; stays face-up after." class="text-muted menu-screen__panel-sub" />
            </engine:VisualElement>
        </engine:ScrollView>

    </engine:VisualElement>
</engine:UXML>
