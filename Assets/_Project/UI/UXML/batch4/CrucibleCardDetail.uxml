<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />
    <engine:Style src="../../USS/SummerActions.uss" />

    <engine:VisualElement name="crucible-card-detail" class="screen" style="background-color: rgb(14,10,20);">

        <engine:VisualElement class="statusbar" style="border-bottom-color: rgb(74,58,42);">
            <engine:VisualElement class="statusbar__left">
                <engine:VisualElement class="statusbar__sigil" style="background-color: rgb(42,31,14); border-color: rgb(201, 150, 47);">
                    <engine:Label text="&#xea6f;" class="ti-icon" style="color: rgb(232, 185, 74);" />
                </engine:VisualElement>
                <engine:VisualElement>
                    <engine:Label text="Crucible card" class="statusbar__title" style="color: rgb(232, 185, 74);" />
                    <engine:Label name="crucible-slot-label" text="" class="statusbar__sub" />
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:Button name="close-btn" text="&#10005;" style="background-color: rgba(0,0,0,0); border-width: 0; color: rgb(184, 154, 110); font-size: 18px;" />
        </engine:VisualElement>

        <engine:VisualElement class="tip tip--arcanum">
            <engine:Label text="Collect the card set and reagents below to complete this crucible in Autumn."
                          class="tip__text" style="color: rgb(184,154,192);" />
        </engine:VisualElement>

        <engine:VisualElement style="padding: 12px 14px 4px;">
            <engine:Label text="name" class="eyebrow" />
            <engine:Label name="crucible-name" text="" style="font-size: 16px; color: rgb(232, 185, 74); white-space: normal;" />
        </engine:VisualElement>

        <engine:VisualElement style="padding: 8px 14px 4px;">
            <engine:Label text="arcana number" class="eyebrow" />
            <engine:Label name="crucible-number" text="" style="font-size: 14px; color: rgb(232, 185, 74); -unity-font-style: bold;" />
        </engine:VisualElement>

        <engine:VisualElement style="padding: 10px 14px 4px;">
            <engine:Label text="alchemical formula · card set" class="eyebrow" style="color: rgb(244, 211, 94);" />
            <engine:Label name="crucible-formula" text="" style="font-size: 11px; color: rgb(243, 233, 210); white-space: normal; margin-top: 4px;" />
        </engine:VisualElement>

        <engine:VisualElement style="padding: 8px 14px 16px;">
            <engine:Label text="reagents required" class="eyebrow" />
            <engine:VisualElement name="crucible-cost" class="panel" style="flex-direction: row; align-items: center; flex-wrap: wrap;" />
        </engine:VisualElement>

        <engine:VisualElement style="padding: 0 14px 16px;">
            <engine:Button name="back-btn" text="Back To The Forge" class="btn btn--primary" />
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
