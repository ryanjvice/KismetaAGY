<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />
    <engine:Style src="../../USS/SummerActions.uss" />

    <!-- ============================================================
         CRAFT A REAGENT (#19) -> FORGE RESULT (#20)
         Pick phase: reagent + card pool + forge. Result phase: txn strip
         populated in C# after a successful craft.
         ============================================================ -->
    <engine:VisualElement name="craft-reagent" class="screen screen--summer">

        <engine:VisualElement name="craft-pick" class="craft-pick">

            <engine:VisualElement class="statusbar">
                <engine:VisualElement class="statusbar__left">
                    <engine:Button name="back-btn" text="&#8592;" style="background-color: rgba(0,0,0,0); border-width: 0; color: rgb(184, 154, 110); font-size: 18px;" />
                    <engine:VisualElement style="margin-left: 4px;">
                        <engine:Label text="Craft a reagent" class="statusbar__title" style="color: rgb(127, 196, 168);" />
                        <engine:Label name="narrative-beat" text="" class="statusbar__sub narrative-beat" />
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement class="craft-charge">
                <engine:Label name="narrative-charge" text="" class="narrative-charge" />
            </engine:VisualElement>

            <engine:VisualElement name="modifier-preview" class="modifier-preview" style="padding: 0 14px;" />

            <engine:ScrollView name="craft-scroll" class="craft-scroll">
                <engine:VisualElement class="craft-scroll__content">

                    <!-- reagent picker -->
                    <engine:VisualElement style="padding: 8px 14px 2px;">
                        <engine:Label text="choose a reagent to forge" class="eyebrow" />
                        <engine:Button name="pick-salt" class="reagent-pick reagent-pick--salt">
                            <engine:VisualElement class="reagent-dot reagent-dot--salt" style="margin-right: 6px;" />
                            <engine:Label text="Salt (any 3)" style="font-size: 11px; color: rgb(243, 233, 210);" />
                        </engine:Button>
                        <engine:Label text="Elemental Reagents" class="eyebrow" style="margin-top: 4px;" />
                        <engine:Label text="Each Elemental Reagent requires its Cauldron to be lit in order to craft."
                                      style="font-size: 10px; color: rgb(184, 154, 110); margin-bottom: 5px; white-space: normal;" />
                        <engine:VisualElement name="reagent-picker" class="reagent-picker">
                            <engine:Button name="pick-sulphur" class="reagent-pick">
                                <engine:VisualElement class="reagent-dot reagent-dot--sulphur" style="margin-right: 6px;" />
                                <engine:Label text="Sulphur" style="font-size: 11px; color: rgb(243, 233, 210);" />
                            </engine:Button>
                            <engine:Button name="pick-vitriol" class="reagent-pick">
                                <engine:VisualElement class="reagent-dot reagent-dot--vitriol" style="margin-right: 6px;" />
                                <engine:Label text="Vitriol" style="font-size: 11px; color: rgb(243, 233, 210);" />
                            </engine:Button>
                            <engine:Button name="pick-aqua" class="reagent-pick">
                                <engine:VisualElement class="reagent-dot reagent-dot--aqua" style="margin-right: 6px;" />
                                <engine:Label text="Aqua Regia" style="font-size: 11px; color: rgb(243, 233, 210);" />
                            </engine:Button>
                            <engine:Button name="pick-quicksilver" class="reagent-pick">
                                <engine:VisualElement class="reagent-dot reagent-dot--quick" style="margin-right: 6px;" />
                                <engine:Label text="Quicksilver" style="font-size: 11px; color: rgb(243, 233, 210);" />
                            </engine:Button>
                        </engine:VisualElement>
                    </engine:VisualElement>

                    <!-- card pick -->
                    <engine:VisualElement style="padding: 6px 14px 2px;">
                        <engine:Label name="cauldron-note" text=""
                                      style="font-size: 10px; color: rgb(184, 154, 110); margin-bottom: 5px; white-space: normal;" />
                        <engine:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 5px;">
                            <engine:Label text="tap cards to discard" class="eyebrow" style="margin-bottom: 0;" />
                            <engine:Label name="pick-count" text="0 / 3" style="font-size: 11px; color: rgb(127, 196, 168);" />
                        </engine:VisualElement>
                        <engine:VisualElement name="card-pool" class="formula card-pool" />
                    </engine:VisualElement>

                </engine:VisualElement>
            </engine:ScrollView>

            <engine:VisualElement class="craft-footer">
                <engine:VisualElement class="tip tip--ok">
                    <engine:Label name="contract-line" text="3 cards → 1 Salt"
                                  class="tip__text" style="color: rgb(159,196,180);" />
                </engine:VisualElement>

                <engine:VisualElement style="padding: 2px 14px 10px;">
                    <engine:Button name="forge-btn" text="Forge — needs 3 more cards" class="btn btn--disabled" />
                </engine:VisualElement>
            </engine:VisualElement>

        </engine:VisualElement>

        <!-- ===== RESULT (#20) — hidden until forged ===== -->
        <engine:VisualElement name="forge-result" style="display: none;">
            <engine:VisualElement class="statusbar">
                <engine:VisualElement class="statusbar__left">
                    <engine:VisualElement style="margin-left: 4px;">
                        <engine:Label text="Reagent forged" class="statusbar__title" style="color: rgb(127, 196, 168);" />
                        <engine:Label name="result-subtitle" text="" class="statusbar__sub" />
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:VisualElement style="padding: 0 14px 16px;">
                <engine:VisualElement name="txn-strip" class="txn" />
                <engine:Button name="result-done-btn" text="Back To The Workshop" class="btn btn--primary" style="margin-top: 8px;" />
            </engine:VisualElement>
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
