<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />
    <engine:Style src="../../USS/SummerActions.uss" />

    <!-- ============================================================
         ACTIVATE A CRUCIBLE CARD (#21) — 2×2 slot grid + formula reveal.
         Inline styles use literal rgb (not var()) — var() in UXML NREs during clone.
         ============================================================ -->
    <engine:VisualElement name="activate" class="screen screen--summer">

        <engine:VisualElement class="statusbar">
            <engine:VisualElement class="statusbar__left">
                <engine:Button name="back-btn" text="&#8592;" style="background-color: rgba(0,0,0,0); border-width: 0; color: rgb(184, 154, 110); font-size: 18px;" />
                <engine:VisualElement style="margin-left: 4px;">
                    <engine:Label text="Activate a Crucible card" class="statusbar__title" style="color: rgb(232, 185, 74);" />
                    <engine:Label text="collect the formula, light its cauldron, flip it" class="statusbar__sub" />
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:ScrollView name="activate-scroll" class="screen__body activate-scroll">
            <engine:VisualElement style="flex-shrink: 0;">
                <engine:VisualElement name="activate-intro-wrap" class="tip tip--caution">
                    <engine:Label name="activate-intro"
                                  text="Activating a crucible card moves its coal to the matching cauldron — lighting it. A lit cauldron lets you craft that element's reagent."
                                  class="tip__text" style="color: rgb(212,184,122);" />
                </engine:VisualElement>
                <engine:VisualElement class="activate-section">
                    <engine:Label text="1 · choose a dormant crucible card" class="eyebrow" />
                    <engine:VisualElement name="crucible-slots" class="crucible-slots">

                        <engine:VisualElement class="crucible-slots__row">
                            <engine:Button name="slot-A" class="crucible-slot">
                                <engine:VisualElement class="crucible-slot__head">
                                    <engine:Label text="slot A" style="font-size: 10px; color: rgb(184, 154, 110);" />
                                    <engine:VisualElement class="crucible-slot__ring ring--red">
                                        <engine:Label text="&#xec3a;" class="ti-icon" style="font-size: 13px; color: rgb(229,115,115);" />
                                    </engine:VisualElement>
                                </engine:VisualElement>
                                <engine:Label name="slot-A-reagent" text="Sulphur" class="crucible-slot__reagent" />
                                <engine:Label name="slot-A-progress" text="0 / 3 Mars" class="crucible-slot__progress" style="color: rgb(184, 154, 110);" />
                            </engine:Button>

                            <engine:Button name="slot-B" class="crucible-slot">
                                <engine:VisualElement class="crucible-slot__head">
                                    <engine:Label text="slot B" style="font-size: 10px; color: rgb(184, 154, 110);" />
                                    <engine:VisualElement class="crucible-slot__ring ring--blue">
                                        <engine:Label text="&#xea77;" class="ti-icon" style="font-size: 13px; color: rgb(111,168,212);" />
                                    </engine:VisualElement>
                                </engine:VisualElement>
                                <engine:Label name="slot-B-reagent" text="Aqua Regia" class="crucible-slot__reagent" />
                                <engine:Label name="slot-B-progress" text="0 / 3 Venus" class="crucible-slot__progress" style="color: rgb(184, 154, 110);" />
                            </engine:Button>
                        </engine:VisualElement>

                        <engine:VisualElement class="crucible-slots__row">
                            <engine:Button name="slot-C" class="crucible-slot">
                                <engine:VisualElement class="crucible-slot__head">
                                    <engine:Label text="slot C" style="font-size: 10px; color: rgb(184, 154, 110);" />
                                    <engine:VisualElement class="crucible-slot__ring ring--green">
                                        <engine:Label text="&#xea5e;" class="ti-icon" style="font-size: 13px; color: rgb(93,202,165);" />
                                    </engine:VisualElement>
                                </engine:VisualElement>
                                <engine:Label name="slot-C-reagent" text="Vitriol" class="crucible-slot__reagent" />
                                <engine:Label name="slot-C-progress" text="0 / 3 Jupiter" class="crucible-slot__progress" style="color: rgb(184, 154, 110);" />
                            </engine:Button>

                            <engine:Button name="slot-D" class="crucible-slot">
                                <engine:VisualElement class="crucible-slot__head">
                                    <engine:Label text="slot D" style="font-size: 10px; color: rgb(184, 154, 110);" />
                                    <engine:VisualElement class="crucible-slot__ring ring--yellow">
                                        <engine:Label text="&#xec3a;" class="ti-icon" style="font-size: 13px; color: rgb(224,192,96);" />
                                    </engine:VisualElement>
                                </engine:VisualElement>
                                <engine:Label name="slot-D-reagent" text="Quicksilver" class="crucible-slot__reagent" />
                                <engine:Label name="slot-D-progress" text="0 / 3 Saturn" class="crucible-slot__progress" style="color: rgb(184, 154, 110);" />
                            </engine:Button>
                        </engine:VisualElement>

                    </engine:VisualElement>
                </engine:VisualElement>

                <engine:VisualElement name="formula-detail" class="activate-section activate-section--detail" style="display: none;">
                    <engine:Label text="2 · the formula" class="eyebrow" />

                    <engine:VisualElement name="formula-card-panel" class="formula-card">
                        <engine:VisualElement class="formula-card__head">
                            <engine:VisualElement class="formula-card__ring ring--red">
                                <engine:Label text="&#xec3a;" class="ti-icon" style="font-size: 16px; color: rgb(229,115,115);" />
                            </engine:VisualElement>
                            <engine:VisualElement style="flex-grow: 1;">
                                <engine:Label name="formula-reagent" text="Sulphur" style="font-size: 14px; -unity-font-style: bold; color: rgb(243, 233, 210);" />
                                <engine:Label name="formula-req" text="any 3 Mars · Red cauldron" style="font-size: 10px; color: rgb(184, 154, 110);" />
                            </engine:VisualElement>
                            <engine:VisualElement style="-unity-text-align: upper-right;">
                                <engine:Label name="formula-count" text="0/3" class="formula-card__count" style="color: rgb(232, 185, 74);" />
                                <engine:Label text="collected" style="font-size: 7px; color: rgb(184, 154, 110);" />
                            </engine:VisualElement>
                        </engine:VisualElement>

                        <engine:VisualElement name="formula-chips" style="flex-direction: row; justify-content: center; flex-wrap: wrap;" />

                        <engine:Label name="formula-status" text=""
                                      class="formula-status" style="font-size: 9px; color: rgb(138,122,106); -unity-text-align: middle-center; white-space: normal;" />
                    </engine:VisualElement>

                    <engine:VisualElement class="tip tip--caution" style="margin-top: 6px; margin-bottom: 0;">
                        <engine:Label name="formula-consequence" text=""
                                      class="tip__text" style="color: rgb(212,184,122);" />
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:ScrollView>

        <engine:VisualElement class="activate-footer">
            <engine:Button name="activate-btn" text="Select a card to activate" class="btn btn--disabled" />
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
