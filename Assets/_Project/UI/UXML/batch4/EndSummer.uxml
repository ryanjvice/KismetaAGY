<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />
    <engine:Style src="../../USS/SummerActions.uss" />

    <!-- ============================================================
         END SUMMER CTA (#27)
         NATIVE NOTE: the recap and "still available" flags are built from
         game state in C# — what the player did this season, and what
         productive moves / exposures remain.
         ============================================================ -->
    <engine:VisualElement name="end-summer" class="sheet end-summer">

        <engine:VisualElement class="sheet__header end-summer__header">
            <engine:VisualElement class="statusbar__left">
                <engine:VisualElement class="statusbar__sigil" style="background-color: rgb(46,28,10); border-color: rgb(240, 176, 96);">
                    <engine:Label text="&#xed5a;" class="ti-icon" style="color: rgb(240, 176, 96);" />
                </engine:VisualElement>
                <engine:VisualElement class="end-pass__heading">
                    <engine:Label text="Pass your turn?" class="statusbar__title end-summer__title" />
                    <engine:Label text="yield the contest — summer ends when everyone passes in a row" class="statusbar__sub" />
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:Button name="close-btn" text="&#10005;" class="end-summer__close" />
        </engine:VisualElement>

        <engine:VisualElement class="sheet__body end-summer__body">
            <engine:VisualElement class="end-summer__section">
                <engine:Label text="your standing this summer" class="end-summer__eyebrow" />
                <engine:VisualElement name="recap-list" class="end-summer__recap-list" />
            </engine:VisualElement>

            <engine:VisualElement class="end-summer__section">
                <engine:Label text="still available this summer" class="end-summer__eyebrow" />
                <engine:VisualElement name="still-available" class="end-summer__hints tip tip--caution" />
                <engine:Label text="passing forfeits any remaining actions this turn" class="end-summer__footnote" />
            </engine:VisualElement>

            <engine:VisualElement class="end-summer__actions">
                <engine:Button name="keep-btn" text="Keep working" class="btn btn--secondary end-summer__btn" />
                <engine:Button name="end-btn" text="Finish Turn" class="btn btn--primary end-summer__btn end-summer__btn--pass" />
            </engine:VisualElement>
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
