<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../../USS/Kismeta.uss" />
    <engine:Style src="../../USS/EndAndOverlays.uss" />

    <!-- ============================================================
         CARD MODALS (#53 inspect, #54 adept, #55 fate)
         Three sibling roots; show one at a time. All present as overlays.
         NATIVE NOTE: tarot art is a sprite per card; alignment values in the
         inspect modal are computed vs the current age in C#.
         ============================================================ -->
    <engine:VisualElement name="card-modals">

        <!-- ===== #53 Minor Arcana inspect ===== -->
        <engine:VisualElement name="inspect-modal" class="card-modal card-modal--inspect">
            <engine:VisualElement class="modal__header" style="background-color: rgb(28,16,16); border-bottom-color: rgb(74,32,32);">
                <engine:Label text="Card detail" style="flex-grow: 1; font-size: 12px; color: rgb(240,176,160);" />
                <engine:Button name="inspect-close" text="&#10005;" style="background-color: rgba(0,0,0,0); border-width: 0; color: rgb(184, 154, 110); font-size: 18px;" />
            </engine:VisualElement>

            <engine:VisualElement class="card-modal__hero card-modal__hero--inspect">
                <engine:VisualElement name="inspect-hero-tarot" class="tarot tarot--big" style="border-color: rgb(201, 150, 47);">
                    <engine:Label name="inspect-hero-icon" text="&#xebcb;" class="ti-icon inspect-hero-icon" style="color: rgb(244,216,192);" />
                </engine:VisualElement>
                <engine:Label name="inspect-name" text="Seven of Wands" class="tarot__name" style="color: rgb(244,216,192);" />
                <engine:Label name="inspect-subtitle" text="minor arcana · rank 7" class="inspect-subtitle" style="color: rgb(208,144,128);" />
            </engine:VisualElement>

            <engine:ScrollView class="card-modal__body-scroll card-modal__body--inspect" horizontal-scroller-visibility="Hidden">
                <engine:VisualElement class="card-modal__body-scroll-content">
                <engine:VisualElement name="inspect-minor-detail" class="inspect-minor-detail">
                    <engine:VisualElement class="inspect-block">
                        <engine:Label text="aspects" class="eyebrow" />
                        <engine:VisualElement name="inspect-aspects" class="inspect-aspects">
                            <engine:VisualElement class="aspect-tile">
                                <engine:Label name="inspect-aspect-element-icon" text="&#xec2c;" class="ti-icon aspect-tile__icon" style="color: rgb(240,153,123);" />
                                <engine:Label name="inspect-aspect-element" text="Fire" style="font-size: 11px; color: rgb(243, 233, 210);" />
                                <engine:Label text="element" class="aspect-tile__kind" />
                            </engine:VisualElement>
                            <engine:VisualElement class="aspect-tile">
                                <engine:Label name="inspect-aspect-planet-icon" text="&#xeb4c;" class="font-zodiac aspect-tile__icon" style="color: rgb(224,138,106);" />
                                <engine:Label name="inspect-aspect-planet" text="Mars" style="font-size: 11px; color: rgb(243, 233, 210);" />
                                <engine:Label text="planet" class="aspect-tile__kind" />
                            </engine:VisualElement>
                            <engine:VisualElement class="aspect-tile">
                                <engine:Label name="inspect-aspect-suit-icon" text="&#xebcb;" class="ti-icon aspect-tile__icon" style="color: rgb(244,200,154);" />
                                <engine:Label name="inspect-aspect-suit" text="Wands" style="font-size: 11px; color: rgb(243, 233, 210);" />
                                <engine:Label text="suit" class="aspect-tile__kind" />
                            </engine:VisualElement>
                        </engine:VisualElement>
                    </engine:VisualElement>

                    <engine:VisualElement name="inspect-effect-section" class="inspect-block">
                        <engine:Label name="inspect-effect-eyebrow" text="effect" class="eyebrow" />
                        <engine:VisualElement class="panel inspect-effect-panel">
                            <engine:Label name="inspect-effect" text="When you Fire the Stone, gain 1 Sulphur." class="inspect-effect__text" />
                        </engine:VisualElement>
                    </engine:VisualElement>

                    <engine:VisualElement class="inspect-block">
                        <engine:Label text="good for" class="eyebrow" />
                        <engine:VisualElement name="inspect-good-for" class="inspect-good-for" />
                    </engine:VisualElement>
                </engine:VisualElement>

                <engine:VisualElement name="inspect-major-detail" class="inspect-major-detail" style="display: none;">
                    <engine:VisualElement name="inspect-major-effect-section" class="inspect-block">
                        <engine:Label name="inspect-major-effect-eyebrow" text="effect" class="eyebrow" />
                        <engine:VisualElement class="panel inspect-effect-panel">
                            <engine:Label name="inspect-major-effect" text="" class="inspect-effect__text" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>

                <engine:VisualElement class="inspect-block">
                    <engine:Label text="alignment this age" class="eyebrow" />
                    <engine:VisualElement class="panel inspect-align-panel">
                        <engine:VisualElement class="inspect-align-copy">
                            <engine:Label name="inspect-align-age" text="Age of Scorpio · Mars · Water" class="inspect-align-age" />
                            <engine:Label name="inspect-align-why" text="its Mars matches the age's planet" class="inspect-align-why" />
                        </engine:VisualElement>
                        <engine:Label name="inspect-align-pts" text="+2" class="inspect-align-pts" />
                    </engine:VisualElement>
                </engine:VisualElement>
                </engine:VisualElement>
            </engine:ScrollView>

            <engine:VisualElement class="card-modal__footer">
                <engine:Button name="inspect-done" text="Done" class="btn btn--secondary inspect-done" style="color: rgb(240,176,160);" />
            </engine:VisualElement>
        </engine:VisualElement>

        <!-- ===== #54 Adept received ===== -->
        <engine:VisualElement name="adept-modal" class="card-modal card-modal--adept" style="display: none;">
            <engine:VisualElement class="card-modal__hero card-modal__hero--adept">
                <engine:Label text="you drew an adept" class="eyebrow" style="color: rgb(176,144,208); -unity-text-align: middle-center;" />
                <engine:VisualElement class="tarot tarot--adept">
                    <engine:Label text="&#xea8a;" class="ti-icon" style="font-size: 40px; color: rgb(224,200,240);" />
                </engine:VisualElement>
                <engine:Label name="adept-name" text="Adept" class="tarot__name" style="color: rgb(224,200,240);" />
                <engine:Label text="active adept · major arcana" style="font-size: 10px; color: rgb(168,144,192);" />
            </engine:VisualElement>

            <engine:VisualElement class="card-modal__body">
                <engine:VisualElement class="panel" style="border-color: rgb(74,58,106); margin-bottom: 10px;">
                    <engine:Label text="its power" class="eyebrow" style="color: rgb(138,106,170);" />
                    <engine:Label name="adept-power" text="Counts as a Sign alignment toward the Cosmic Age — adding to your Harvest and every Opposition while active."
                                  style="font-size: 12px; color: rgb(243, 233, 210); white-space: normal;" />
                </engine:VisualElement>

                <engine:VisualElement class="tip tip--ok" style="margin-bottom: 10px; margin-left: 0; margin-right: 0;">
                    <engine:Label name="adept-tip" text="Your Arcanum has open slots for active Adepts."
                                  class="tip__text" style="color: rgb(159,196,180);" />
                </engine:VisualElement>

                <engine:VisualElement name="adept-actions" style="flex-direction: row;">
                    <engine:Button name="adept-hold" text="Hold inactive" class="btn btn--secondary" style="flex-grow: 1; margin-right: 8px;" />
                    <engine:Button name="adept-place" text="Place active" class="btn" style="flex-grow: 1.4; background-color: rgb(46,26,68); border-color: rgb(154,122,192); color: rgb(224,200,240);" />
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>

        <!-- ===== #55 Fate received ===== -->
        <engine:VisualElement name="fate-modal" class="card-modal card-modal--fate" style="display: none;">
            <engine:VisualElement class="card-modal__hero card-modal__hero--fate">
                <engine:Label text="the fates intervene" class="eyebrow" style="color: rgb(138,176,224); -unity-text-align: middle-center;" />
                <engine:VisualElement class="tarot tarot--fate">
                    <engine:Label text="&#xed1d;" class="ti-icon" style="font-size: 40px; color: rgb(188,216,240);" />
                </engine:VisualElement>
                <engine:Label name="fate-name" text="Wheel of Fortune" class="tarot__name" style="color: rgb(188,216,240);" />
                <engine:Label text="fate · resolves at once" style="font-size: 10px; color: rgb(127,160,196);" />
            </engine:VisualElement>

            <engine:VisualElement class="card-modal__body">
                <engine:Label text="the wheel turns — now" class="eyebrow" style="-unity-text-align: middle-center; color: rgb(127,160,196);" />
                <engine:VisualElement name="fate-effects" style="margin-bottom: 10px;">
                    <engine:VisualElement class="effect-row effect-row--gain">
                        <engine:VisualElement style="flex-grow: 1;">
                            <engine:Label text="Fortune favors you" style="font-size: 12px; color: rgb(159,225,203);" />
                            <engine:Label text="draw 3 cards from the common deck" style="font-size: 10px; color: rgb(138,172,154);" />
                        </engine:VisualElement>
                        <engine:Label text="+3" style="font-size: 13px; color: rgb(127, 196, 168); -unity-font-style: bold;" />
                    </engine:VisualElement>
                    <engine:VisualElement class="effect-row effect-row--loss">
                        <engine:VisualElement style="flex-grow: 1;">
                            <engine:Label text="but the wheel takes too" style="font-size: 12px; color: rgb(240,168,160);" />
                            <engine:Label text="a random reagent returns to the supply" style="font-size: 10px; color: rgb(196,144,144);" />
                        </engine:VisualElement>
                        <engine:Label text="&#8722;1" style="font-size: 13px; color: rgb(240, 144, 138); -unity-font-style: bold;" />
                    </engine:VisualElement>
                </engine:VisualElement>

                <engine:VisualElement class="tip" style="background-color: rgb(26,32,48); border-width: 1px; border-color: rgb(58,74,106); margin-bottom: 10px;">
                    <engine:Label text="Fates resolve the instant they're drawn — you don't choose when. After resolving, it stays face-up in your Arcanum."
                                  class="tip__text" style="color: rgb(160,180,208);" />
                </engine:VisualElement>

                <engine:Button name="fate-accept" text="Accept your fate" class="btn" style="background-color: rgb(22,51,90); border-color: rgb(90,138,192); color: rgb(188,216,240);" />
            </engine:VisualElement>
        </engine:VisualElement>

        <!-- ===== The Moon — meaningful gift ===== -->
        <engine:VisualElement name="moon-modal" class="card-modal card-modal--fate-decision" style="display: none;">
            <engine:Label name="moon-sr" text="The Moon — give a meaningful gift of cards and/or reagents." class="sr-only" />
            <engine:VisualElement class="card-modal__hero card-modal__hero--fate-decision">
                <engine:Label text="the moon" class="eyebrow" style="color: rgb(138,176,224); -unity-text-align: middle-center;" />
                <engine:Label text="Meaningful Gift" class="tarot__name" style="color: rgb(188,216,240); font-size: 16px;" />
                <engine:Label text="Select minor cards from Hand or Spread, and/or reagents to gift." style="font-size: 10px; color: rgb(127,160,196); white-space: normal; -unity-text-align: middle-center;" />
            </engine:VisualElement>
            <engine:VisualElement class="card-modal__body card-modal__body--grow">
                <engine:VisualElement name="moon-cards" class="fate-chip-row moon-cards" />
                <engine:VisualElement name="moon-reagents" style="margin-top: 8px; margin-bottom: 8px;" />
                <engine:Label name="moon-count" text="Gift: 0 items selected" style="font-size: 10px; color: rgb(184, 154, 110); margin-top: 8px; margin-bottom: 8px;" />
                <engine:Button name="moon-confirm" text="Confirm Gift" class="btn btn--primary" />
            </engine:VisualElement>
        </engine:VisualElement>

        <!-- ===== Fool altar claim ===== -->
        <engine:VisualElement name="fool-altar-modal" class="card-modal card-modal--fate-decision" style="display: none;">
            <engine:Label name="fool-altar-sr" text="Claim the Fool altar Crucible card." class="sr-only" />
            <engine:VisualElement class="card-modal__hero card-modal__hero--fate-decision">
                <engine:Label text="the fool · altar" class="eyebrow" style="color: rgb(138,176,224); -unity-text-align: middle-center;" />
                <engine:Label name="fool-altar-name" text="Altar Crucible" class="tarot__name" style="color: rgb(188,216,240); font-size: 16px;" />
                <engine:Label name="fool-altar-formula" text="" style="font-size: 10px; color: rgb(127,160,196); white-space: normal; -unity-text-align: middle-center;" />
                <engine:Label name="fool-altar-slot" text="" style="font-size: 10px; color: rgb(184, 154, 110); white-space: normal; -unity-text-align: middle-center;" />
            </engine:VisualElement>
            <engine:VisualElement class="card-modal__body card-modal__body--grow">
                <engine:VisualElement name="fool-altar-cards" class="fate-chip-row moon-cards" />
                <engine:Button name="fool-altar-confirm" text="Claim Altar Card" class="btn btn--primary" style="margin-top: 8px;" />
            </engine:VisualElement>
        </engine:VisualElement>

        <!-- ===== The Emperor — protect 2 cards ===== -->
        <engine:VisualElement name="emperor-modal" class="card-modal card-modal--fate-decision" style="display: none;">
            <engine:Label name="emperor-sr" text="The Emperor — protect two cards from duel and gambit loss." class="sr-only" />
            <engine:VisualElement class="card-modal__hero card-modal__hero--fate-decision">
                <engine:Label text="the emperor" class="eyebrow" style="color: rgb(176,144,208); -unity-text-align: middle-center;" />
                <engine:Label text="Imperial Protection" class="tarot__name" style="color: rgb(224,200,240); font-size: 16px;" />
                <engine:Label name="emperor-subtitle" text="Select 2 minor cards from your Spread." style="font-size: 10px; color: rgb(168,144,192); white-space: normal; -unity-text-align: middle-center;" />
            </engine:VisualElement>
            <engine:VisualElement class="card-modal__body card-modal__body--grow">
                <engine:VisualElement name="emperor-cards" class="fate-chip-row moon-cards" />
                <engine:Label name="emperor-count" text="0 / 2 selected" style="font-size: 10px; color: rgb(184, 154, 110); margin-top: 8px; margin-bottom: 8px;" />
                <engine:VisualElement style="flex-direction: row;">
                    <engine:Button name="emperor-cancel" text="Cancel" class="btn btn--secondary" style="flex-grow: 1; margin-right: 8px;" />
                    <engine:Button name="emperor-confirm" text="Protect Cards" class="btn btn--primary" style="flex-grow: 1.4;" />
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>

        <!-- ===== Legacy reagent modal (Lovers uses lovers-choice) ===== -->
        <engine:VisualElement name="fate-reagent-modal" class="card-modal card-modal--fate-decision" style="display: none;">
            <engine:Label name="reagent-sr" text="Choose one reagent to receive from the Fool fate." class="sr-only" />
            <engine:VisualElement class="card-modal__hero card-modal__hero--fate-decision">
                <engine:VisualElement name="reagent-card-art" class="tarot tarot--fate">
                    <engine:Label name="reagent-card-art-fallback" text="&#xed1d;" class="ti-icon" style="font-size: 40px; color: rgb(188,216,240);" />
                </engine:VisualElement>
                <engine:Label name="reagent-card-name" text="The Fool." class="tarot__name" style="color: rgb(188,216,240);" />
                <engine:Label name="reagent-card-description" text="Draw 2 cards. Your Opponents receive 1 Reagent of their choice." class="card-modal__description" />
            </engine:VisualElement>
            <engine:VisualElement class="card-modal__body">
                <engine:Label name="reagent-prompt" text="Choose 1 Reagent" class="card-modal__prompt" />
                <engine:VisualElement name="reagent-buttons" class="fate-reagent-grid" />
            </engine:VisualElement>
        </engine:VisualElement>

        <!-- ===== The Lovers — pick target ===== -->
        <engine:VisualElement name="lovers-target-modal" class="card-modal card-modal--fate-decision" style="display: none;">
            <engine:Label name="lovers-target-sr" text="Pick an opponent to choose your Lovers reward." class="sr-only" />
            <engine:VisualElement class="card-modal__hero card-modal__hero--lovers">
                <engine:Label text="The Lovers" class="eyebrow" style="color: rgb(176,144,208); -unity-text-align: middle-center;" />
                <engine:Label text="Pick who chooses" class="tarot__name" style="color: rgb(224,200,240); font-size: 16px;" />
                <engine:Label text="An opponent will decide your reward." style="font-size: 10px; color: rgb(168,144,192); white-space: normal; -unity-text-align: middle-center;" />
            </engine:VisualElement>
            <engine:VisualElement class="card-modal__body">
                <engine:VisualElement name="lovers-target-buttons" />
            </engine:VisualElement>
        </engine:VisualElement>

        <!-- ===== The Lovers — target chooses reward ===== -->
        <engine:VisualElement name="lovers-choice-modal" class="card-modal card-modal--fate-decision" style="display: none;">
            <engine:Label name="lovers-choice-sr" text="Choose the drawer's Lovers reward — two cards or one reagent." class="sr-only" />
            <engine:VisualElement class="card-modal__hero card-modal__hero--lovers">
                <engine:Label text="The Lovers" class="eyebrow" style="color: rgb(176,144,208); -unity-text-align: middle-center;" />
                <engine:Label name="lovers-choice-sub" text="Choose their reward" class="tarot__name" style="color: rgb(224,200,240); font-size: 16px;" />
            </engine:VisualElement>
            <engine:VisualElement class="card-modal__body">
                <engine:Button name="lovers-draw-btn" text="Drawer draws 2 cards" class="btn btn--secondary" style="margin-bottom: 8px;" />
                <engine:Label text="— or one reagent —" style="font-size: 9px; color: rgb(168,144,192); -unity-text-align: middle-center; margin-bottom: 8px;" />
                <engine:VisualElement name="lovers-reagent-buttons" class="fate-reagent-grid" />
            </engine:VisualElement>
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
