/* Kismeta — EndAndOverlays.uss
   Shared styling for victory, chronicle, card table, and the three card
   modals (#50-55). Builds on Kismeta.uss + reuses earlier component classes. */

/* ---------- Victory (frame broken, ceremonial) ---------- */
.victory-hero {
    align-items: center;
    padding: 30px 20px 18px;
    position: relative;
    overflow: hidden;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/splashBackground.png");
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgba(42, 30, 8, 0.88);
    border-bottom-width: 3px;
    border-bottom-color: var(--gold-deep);
}

.victory-halo {
    position: absolute;
    left: 15%;
    right: 15%;
    top: 12%;
    height: 120px;
    opacity: 0.35;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/crucibleForge.png");
    -unity-background-scale-mode: scale-to-fit;
}

.victory-sigil {
    width: 92px;
    height: 92px;
    border-radius: 46px;
    background-color: rgba(201, 150, 47, 0.35);
    border-width: 3px;
    border-color: var(--gold-bright);
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    position: relative;
}
.victory-title {
    font-size: 16px; color: var(--gold-bright);
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/Amarante-Regular.asset");
}
.win-condition {
    flex-direction: row;
    align-items: center;
    background-color: rgba(16, 10, 18, 0.9);
    border-width: 2px;
    border-color: var(--border-gold);
    border-radius: var(--radius-md);
    padding: 8px 11px;
    margin-bottom: 6px;
}

/* standings row */
.standing {
    flex-direction: row;
    align-items: center;
    background-color: rgba(16, 10, 18, 0.9);
    border-width: 2px;
    border-color: var(--border-gold);
    border-radius: var(--radius-md);
    padding: 8px 11px;
    margin-bottom: 5px;
}
.standing__rank { width: 18px; font-size: 12px; -unity-font-style: bold; color: var(--muted); }

/* ---------- Chronicle ---------- */
.chart-host {
    height: 170px;
    background-color: rgba(16, 10, 18, 0.9);
    border-width: 2px;
    border-color: var(--border-gold);
    border-radius: var(--radius-md);
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
}
.stat-cell {
    flex-grow: 1;
    align-items: center;
    background-color: rgba(16, 10, 18, 0.9);
    border-width: 2px;
    border-color: var(--border-gold);
    border-radius: var(--radius-md);
    padding: 9px 2px;
    margin-right: 7px;
}
.stat-cell:last-child { margin-right: 0; }
.stat-cell__value { font-size: 18px; -unity-font-style: bold; }

/* ---------- Card table (overlay) ---------- */
.card-table {
    width: 100%;
    height: 88%;
    min-height: 520px;
    max-height: 100%;
    flex-grow: 1;
    flex-direction: column;
}
.card-table__players {
    flex-grow: 1;
    min-height: 0;
    padding: 0 12px 14px;
}
.player-block {
    background-color: rgb(26,20,13);
    border-width: 1px; border-color: var(--border-subtle);
    border-left-width: 3px;
    border-top-right-radius: var(--radius-md);
    border-bottom-right-radius: var(--radius-md);
    padding: 10px 12px;
    margin-bottom: 9px;
}
.threat-badge {
    background-color: rgb(42,16,16);
    border-width: 1px; border-color: rgb(90,32,32);
    border-radius: var(--radius-sm);
    padding: 2px 6px;
    font-size: 9px; color: var(--danger-text);
}
.table-action {
    flex-grow: 1;
    border-radius: var(--radius-sm);
    border-width: 1px;
    padding: 6px;
    margin-right: 6px;
    font-size: 10px;
    -unity-text-align: middle-center;
}
.table-action:last-child { margin-right: 0; }

.player-block__zone {
    flex-direction: row;
    flex-wrap: wrap;
    min-height: var(--card-chip-h);
    margin-bottom: 8px;
}
.player-block__zone > .card-chip {
    width: var(--card-chip-w);
    min-width: var(--card-chip-w);
    max-width: var(--card-chip-w);
    height: var(--card-chip-h);
    min-height: var(--card-chip-h);
    max-height: var(--card-chip-h);
    margin-right: 4px;
    margin-bottom: 4px;
}
.card-chip--hidden {
    background-color: rgb(32, 28, 36);
    border-color: rgb(58, 48, 64);
    opacity: 0.6;
}

/* ---------- Card modals (inspect / adept / fate) ---------- */
.overlay-clone-host > #card-modals {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    max-height: 100%;
    overflow: hidden;
}

.card-modals {
    width: 100%;
    min-width: 0;
    flex-direction: column;
    align-items: stretch;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.card-modals > .card-modal {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    max-height: 100%;
    overflow: hidden;
}

.card-modal--inspect {
    background-color: rgb(14,10,20);
    border-color: rgb(90,43,43);
}
.card-modal--adept {
    background-color: rgb(18,10,24);
    border-color: rgb(90,58,122);
}
.card-modal--fate { background-color: rgb(10,14,24); border-color: rgb(58,90,138); }
.card-modal--fate-decision {
    background-color: rgb(14,12,28);
    border-color: rgb(74,58,106);
}

.card-modal__body--grow {
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 0;
    overflow: visible;
}

.moon-cards {
    flex-shrink: 0;
}
.card-modal__hero--inspect {
    background-color: rgb(36,16,16);
    flex-shrink: 0;
}
.card-modal__hero--adept { background-color: rgb(46,26,68); }
.card-modal__hero--fate { background-color: rgb(22,51,90); }
.card-modal__hero--fate-decision { background-color: rgb(18,22,42); }
.card-modal__hero--lovers { background-color: rgb(28,18,36); }
.card-modal__description {
    font-size: 11px;
    color: rgb(127,160,196);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 6px;
    padding-left: 8px;
    padding-right: 8px;
}
.card-modal__prompt {
    font-size: 13px;
    color: rgb(188,216,240);
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.adept-payment {
    flex-shrink: 0;
    margin-bottom: 12px;
    min-width: 0;
}

.adept-payment__chips {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    align-content: flex-start;
    min-width: 0;
    margin-top: 6px;
}

.adept-payment__chips > .card-chip {
    margin-right: 6px;
    margin-bottom: 6px;
}

.adept-payment__swap {
    flex-direction: row;
    flex-wrap: wrap;
    min-width: 0;
    margin-top: 6px;
}

.card-modal--adept #adept-actions {
    flex-shrink: 0;
    margin-top: 4px;
}

.card-modal--adept .card-modal__body > * {
    flex-shrink: 0;
}

.card-modal--adept .card-modal__body {
    flex-shrink: 0;
    flex-grow: 0;
    overflow: visible;
}

.adept-payment__swap > .btn {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 45%;
    margin-right: 6px;
    margin-bottom: 6px;
    white-space: normal;
}

.fate-chip-row {
    flex-direction: row;
    flex-wrap: wrap;
}
.fate-reagent-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}
.fate-reagent-btn {
    width: 48%;
    flex-grow: 0;
    flex-shrink: 0;
    min-height: var(--touch-min);
    margin-bottom: 7px;
    padding: 11px 10px;
    font-size: 12px;
    -unity-text-align: middle-center;
    background-color: var(--panel-darker);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    color: rgb(243, 233, 210);
}
.fate-reagent-btn:hover {
    border-color: rgb(90, 138, 192);
    opacity: 1;
}

.card-hero {
    align-items: center;
    padding: 18px 16px 12px;
}
.tarot {
    width: 96px; height: 134px;
    border-radius: 11px;
    border-width: 2px;
    align-items: center; justify-content: center;
}
.tarot--big { width: 108px; height: 150px; }
.tarot--adept { border-color: rgb(154,122,192); background-color: rgb(46,26,68); }
.tarot--fate { border-color: rgb(90,138,192); background-color: rgb(22,51,90); }
.tarot--lovers { border-color: rgb(154,122,192); background-color: rgb(28,18,36); }
.tarot__name {
    font-size: 19px;
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/Amarante-Regular.asset");
    margin-top: 12px;
    white-space: normal;
    -unity-text-align: middle-center;
    width: 100%;
    padding-left: 8px;
    padding-right: 8px;
}

.inspect-subtitle {
    font-size: 10px;
    white-space: normal;
    -unity-text-align: middle-center;
    width: 100%;
    padding-left: 8px;
    padding-right: 8px;
    margin-top: 4px;
}

.inspect-hero-numeral {
    font-size: 46px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.inspect-hero-numeral--compact {
    font-size: 34px;
}

/* aspect tiles (inspect) */
.aspect-tile {
    flex-grow: 1;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: 84px;
    background-color: rgb(28,16,16);
    border-width: 1px; border-color: rgb(90,43,26);
    border-radius: var(--radius-md);
    padding: 10px 4px 12px;
    margin-right: 7px;
    overflow: visible;
}
.aspect-tile:last-child { margin-right: 0; }
.aspect-tile__icon {
    font-size: 18px;
    margin-bottom: 2px;
    -unity-text-align: middle-center;
}

.inspect-hero-icon {
    font-size: 46px;
}

.aspect-tile__kind {
    font-size: 8px;
    color: rgb(184, 154, 110);
    margin-top: 2px;
    -unity-text-align: middle-center;
}

/* inspect modal layout */
.card-modal__body-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    min-width: 0;
}

.card-modal__body-scroll-content {
    flex-shrink: 0;
    flex-direction: column;
    align-items: stretch;
    padding: var(--space-md) var(--space-lg) var(--space-md);
}

.card-modal__footer {
    flex-shrink: 0;
    padding: 0 var(--space-lg) var(--space-lg);
}

/* Clip header/hero fills to the modal's rounded frame */
.card-modal > .modal__header:first-child,
.card-modal > .card-modal__hero:first-child {
    border-top-left-radius: calc(var(--radius-xl) - 2px);
    border-top-right-radius: calc(var(--radius-xl) - 2px);
}

.card-modal > .card-modal__footer:last-child,
.card-modal > .card-modal__body:last-child {
    border-bottom-left-radius: calc(var(--radius-xl) - 2px);
    border-bottom-right-radius: calc(var(--radius-xl) - 2px);
}

.card-modal__body--inspect {
    flex-direction: column;
    align-items: stretch;
}

.inspect-major-detail {
    flex-direction: column;
    align-items: stretch;
    flex-shrink: 0;
}

.card-modal__body-scroll-content > .inspect-block,
.card-modal__body-scroll-content > .inspect-minor-detail,
.card-modal__body-scroll-content > .inspect-major-detail,
.inspect-minor-detail > .inspect-block,
.inspect-major-detail > .inspect-block {
    margin-bottom: var(--space-md);
}

.card-modal__body-scroll-content > .inspect-block:last-child,
.card-modal__body-scroll-content > .inspect-minor-detail:last-child,
.card-modal__body-scroll-content > .inspect-major-detail:last-child,
.inspect-minor-detail > .inspect-block:last-child,
.inspect-major-detail > .inspect-block:last-child {
    margin-bottom: 0;
}

.inspect-minor-detail {
    flex-direction: column;
    align-items: stretch;
    flex-shrink: 0;
}

.inspect-block {
    flex-direction: column;
    align-items: stretch;
    flex-shrink: 0;
}

.inspect-aspects {
    flex-direction: row;
    flex-shrink: 0;
    align-items: stretch;
    width: 100%;
}

.inspect-good-for {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    align-items: flex-start;
    width: 100%;
}

.inspect-effect-panel {
    flex-direction: column;
    flex-shrink: 0;
    align-items: stretch;
    border-color: rgb(90,43,26);
}

.inspect-effect__text {
    font-size: 12px;
    color: var(--ink);
    white-space: normal;
    -unity-text-align: upper-left;
    flex-shrink: 0;
}

.inspect-align-panel {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
    border-color: rgb(106,80,32);
}

.inspect-align-copy {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.inspect-align-age {
    font-size: 11px;
    color: rgb(243, 233, 210);
    white-space: normal;
}

.inspect-align-why {
    font-size: 10px;
    color: rgb(184, 154, 110);
    white-space: normal;
    margin-top: 4px;
}

.inspect-align-pts {
    font-size: 17px;
    color: rgb(240,153,123);
    -unity-font-style: bold;
    flex-shrink: 0;
    margin-left: var(--space-sm);
    align-self: flex-start;
}

.inspect-done {
    flex-shrink: 0;
    margin-top: var(--space-xs);
}

.inspect-tag {
    font-size: 10px;
    border-radius: 6px;
    padding: 4px 9px;
    margin-right: 6px;
    margin-bottom: 6px;
}
.inspect-tag--craft { color: rgb(240,176,160); background-color: rgb(42,18,18); }
.inspect-tag--set { color: rgb(224,200,120); background-color: rgb(42,35,14); }
.inspect-tag--align { color: rgb(127, 196, 168); background-color: rgb(19,36,26); }

/* fired-effect rows (fate) */
.effect-row {
    flex-direction: row; align-items: center;
    border-radius: var(--radius-md);
    border-width: 1px;
    padding: 10px 12px;
    margin-bottom: 7px;
}
.effect-row--gain { background-color: rgb(19,36,26); border-color: var(--ok-border); }
.effect-row--loss { background-color: rgb(36,18,24); border-color: rgb(106,48,64); }

.table-action--active {
    background-color: rgb(42,31,14);
    border-color: rgb(90,68,32);
    color: rgb(224,200,120);
}

/* ---------- Card table player detail (expandable) ---------- */
.player-block__header {
    cursor: link;
}
.player-block__header:hover {
    opacity: 0.92;
}
.player-block__expand-hint {
    font-size: 13px;
    color: var(--gold);
    flex-shrink: 0;
    margin-right: 4px;
}
.player-block__chevron {
    font-size: 12px;
    color: var(--gold);
    flex-shrink: 0;
}
.player-block--expanded {
    border-color: var(--border-gold);
}
.player-block__detail {
    flex-direction: column;
    background-color: rgba(12, 8, 16, 0.55);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 8px 10px;
    margin-bottom: 8px;
}
.player-block__detail-section {
    flex-direction: column;
    margin-bottom: 8px;
}
.player-block__detail-section:last-child {
    margin-bottom: 0;
}
.player-block__detail-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}
.detail-zodiac__glyph {
    font-size: 18px;
    margin-right: 8px;
    color: var(--gold-bright);
}
.detail-zodiac__name {
    font-size: 12px;
    color: var(--gold-bright);
}
.detail-meta {
    font-size: 9px;
    color: var(--muted);
    margin-left: 8px;
}
.house-chip-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}
.house-chip {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--border-subtle);
    background-color: rgba(16, 10, 18, 0.9);
    align-items: center;
    justify-content: center;
    margin-right: 4px;
    margin-bottom: 4px;
}
.house-chip__glyph {
    font-size: 14px;
}
.reagent-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}
.reagent-row > .reagent-chip {
    margin-right: 6px;
    margin-bottom: 4px;
}
.crucible-slot-list {
    flex-direction: column;
}
.crucible-slot-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 6px;
}
.crucible-slot-row:last-child {
    margin-bottom: 0;
}
.crucible-slot-row__meta {
    font-size: 9px;
    color: var(--muted);
    margin-left: 8px;
    margin-right: 6px;
}
.ward-badge {
    background-color: rgb(28, 22, 42);
    border-width: 1px;
    border-color: rgb(106, 80, 138);
    border-radius: var(--radius-sm);
    padding: 2px 6px;
    font-size: 9px;
    color: rgb(184, 154, 192);
    margin-right: 4px;
    margin-bottom: 4px;
}
.stone-status {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}
.stone-status__label {
    font-size: 11px;
    color: var(--ink);
    margin-right: 8px;
}

/* ---------- Resource exchange summary ---------- */
.card-modal--exchange {
    background-color: rgb(12, 18, 26);
    border-color: rgb(58, 90, 138);
    max-height: none;
    flex-shrink: 0;
}
.exchange__header {
    background-color: rgb(18, 28, 42);
    border-bottom-color: rgb(43, 58, 74);
    padding: 12px 14px;
}
.exchange__title {
    font-size: 13px;
    color: rgb(168, 205, 240);
}
.exchange__body {
    flex-direction: column;
    padding: 12px 14px 16px;
}
.exchange__subtitle {
    font-size: 11px;
    color: rgb(184, 154, 110);
    margin-bottom: 10px;
    white-space: normal;
}
.exchange__subtitle--verdict {
    font-size: 17px;
    color: rgb(168, 205, 240);
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/Amarante-Regular.asset");
    -unity-text-align: middle-center;
    margin-bottom: 14px;
    margin-top: 2px;
}
.exchange__bilateral {
    flex-direction: column;
    margin-bottom: 12px;
}
.exchange__arrow {
    font-size: 18px;
    color: rgb(184, 154, 110);
    -unity-text-align: middle-center;
    margin: 4px 0;
}
.exchange__tray-label {
    font-size: 11px;
    margin-bottom: 6px;
}
.tray--give .exchange__tray-label {
    color: rgb(220, 180, 140);
}
.tray--get .exchange__tray-label {
    color: rgb(180, 220, 200);
}
.tray--get .exchange__tray-label.exchange__tray-label--sink {
    color: rgb(168, 205, 240);
}
.exchange__items {
    flex-direction: row;
    flex-wrap: wrap;
    min-height: var(--card-chip-h);
}
.exchange__confirm {
    margin-top: 4px;
}
.exchange__legs {
    flex-direction: column;
    margin-bottom: 12px;
}
.exchange__leg-row {
    flex-direction: column;
    margin-bottom: 10px;
}
.exchange__leg-label {
    font-size: 10px;
    color: rgb(184, 154, 110);
    margin-bottom: 4px;
}
.exchange__more-label {
    font-size: 10px;
    color: rgb(127, 160, 196);
    padding: 8px 6px;
}
.exchange__status-badge {
    font-size: 8px;
    color: rgb(224, 160, 120);
    -unity-text-align: middle-center;
}
