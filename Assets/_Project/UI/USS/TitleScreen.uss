/* Kismeta — TitleScreen.uss (per-screen styling) */

.title-hero {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
    padding: 0;
    align-items: stretch;
    justify-content: flex-start;
    position: relative;
    overflow: hidden;
}

.title-hero__bg {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/splashBackground.png");
    -unity-background-scale-mode: scale-and-crop;
}

.title-hero__content {
    position: relative;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 12px 20px 8px;
    overflow: hidden;
}

.title-wordmark-img {
    width: 240px;
    height: 62px;
    margin-top: 8px;
    margin-bottom: 6px;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/kismeta_metallic_1.png");
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.title-hero__wheel-stage {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    align-items: center;
    justify-content: center;
    margin-top: 0;
    margin-bottom: 0;
}

.title-wheel-stack {
    position: relative;
    width: 400px;
    height: 300px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.title-wheel-stack__star {
    position: absolute;
    left: -100px;
    right: -100px;
    top: -100px;
    bottom: -100px;
    opacity: 0.15;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/starChart.png");
    -unity-background-scale-mode: scale-to-fit;
}

.title-wheel-stack__zodiac {
    position: absolute;
    left: 2.5%;
    right: 2.5%;
    top: 2.5%;
    bottom: 2.5%;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/zodiacWheel.png");
    -unity-background-scale-mode: scale-to-fit;
}

.title-wheel-stack__mantle {
    position: absolute;
    left: 16.9%;
    right: 16.9%;
    top: 16.9%;
    bottom: 16.9%;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/mantleRing.png");
    -unity-background-scale-mode: scale-to-fit;
}

.title-wheel-stack__forge {
    position: absolute;
    left: 30%;
    right: 30%;
    top: 30%;
    bottom: 30%;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/crucibleForge.png");
    -unity-background-scale-mode: scale-to-fit;
}

.title-tagline-img {
    width: 260px;
    height: 42px;
    margin-top: 6px;
    margin-bottom: 12px;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/alchemists_metallic.png");
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.title-menu {
    padding: 8px 16px 16px;
    background-color: transparent;
    border-top-width: 0;
    flex-shrink: 0;
}

.title-menu__primary {
    font-size: 14px;
    margin-bottom: 4px;
}

.title-menu__row {
    flex-direction: row;
    margin-top: 8px;
}

.title-menu__row--secondary {
    margin-top: 2px;
}

.btn--menu {
    flex-grow: 1;
    background-color: rgba(28, 18, 8, 0.92);
    border-width: 2px;
    border-color: var(--gold-deep);
    color: rgb(201, 168, 74);
    border-radius: var(--radius-md);
    padding: 11px;
    -unity-text-align: middle-center;
    margin-right: 8px;
}
.btn--menu:last-child { margin-right: 0; }

.btn--menu-sm {
    flex-grow: 1;
    background-color: rgba(16, 10, 18, 0.9);
    border-width: 1px;
    border-color: var(--border-gold);
    color: rgb(184, 154, 138);
    border-radius: var(--radius-md);
    padding: 10px;
    font-size: 11px;
    -unity-text-align: middle-center;
    margin-right: 8px;
}
.btn--menu-sm:last-child { margin-right: 0; }

/* Tablet+: larger art, wheel centered between wordmark and tagline */
.viewport--tablet .title-hero__content {
    justify-content: flex-start;
    padding: 24px 20px 8px;
}

.viewport--tablet .title-wordmark-img {
    width: 280px;
    height: 72px;
    margin-top: 0;
    margin-bottom: 4px;
}

.viewport--tablet .title-hero__wheel-stage {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.viewport--tablet .title-wheel-stack {
    width: 400px;
    height: 400px;
}

.viewport--tablet .title-tagline-img {
    width: 300px;
    height: 48px;
    margin-top: 4px;
    margin-bottom: 4px;
}

/* Very narrow phones: slightly smaller wheel */
.viewport--compact .title-wheel-stack {
    width: 280px;
    height: 280px;
}

.viewport--compact .title-wordmark-img {
    width: 220px;
    height: 56px;
}

.viewport--compact .title-tagline-img {
    width: 240px;
    height: 38px;
}
