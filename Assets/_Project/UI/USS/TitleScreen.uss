/* Kismeta — TitleScreen.uss (per-screen styling) */

.screen--title {
    background-color: transparent;
    overflow: visible;
}

.title-screen__star-field {
    position: absolute;
    left: -30%;
    right: -30%;
    top: -30%;
    bottom: -30%;
    opacity: 0.15;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/starChart.png");
    -unity-background-scale-mode: scale-to-fit;
}

.title-hero {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
    padding: 0;
    align-items: stretch;
    justify-content: flex-start;
    position: relative;
    overflow: visible;
}

.title-hero__content {
    position: relative;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 12px 20px 8px;
    overflow: visible;
}

.title-wordmark-img {
    /* GameSplashScreen Kismeta: 500×124 canvas units at 1080 ref → ~46% screen width */
    width: 438px;
    height: 110px;
    margin-top: 24px;
    margin-bottom: 2px;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/kismeta_metallic_1.png");
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.title-hero__wheel-stage {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    align-items: center;
    justify-content: center;
    margin-top: 0;
    margin-bottom: 0;
}

.title-wheel-stack {
    position: relative;
    width: 400px;
    height: 300px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.title-wheel-stack__zodiac {
    position: absolute;
    left: 2.5%;
    right: 2.5%;
    top: 2.5%;
    bottom: 2.5%;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/zodiacWheel.png");
    -unity-background-scale-mode: scale-to-fit;
}

.title-wheel-stack__mantle {
    position: absolute;
    left: 2%;
    right: 2%;
    top: 2%;
    bottom: 2%;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/mantleRing.png");
    -unity-background-scale-mode: scale-to-fit;
}

.title-wheel-stack__forge {
    position: absolute;
    left: 25%;
    right: 25%;
    top: 25%;
    bottom: 25%;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/crucibleForge.png");
    -unity-background-scale-mode: scale-to-fit;
}

.title-tagline-img {
    /* GameSplashScreen AGY: 500×141 canvas units — height must match ~3.5:1 sprite aspect */
    width: 375px;
    height: 106px;
    margin-top: 6px;
    margin-bottom: 12px;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/alchemists_metallic.png");
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.title-menu {
    padding: 8px 16px 16px;
    background-color: transparent;
    border-top-width: 0;
    flex-shrink: 0;
}

.title-menu__primary {
    margin-bottom: 4px;
}

.title-menu__row {
    flex-direction: row;
    margin-top: 8px;
    column-gap: 8px;
}

.btn--menu {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    background-color: rgba(28, 18, 8, 0.92);
    border-width: 2px;
    border-color: var(--gold-deep);
    color: rgb(201, 168, 74);
    border-radius: var(--radius-md);
    padding: 11px;
    -unity-text-align: middle-center;
}

.title-menu__rules-btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.title-menu__link-icon {
    font-size: 14px;
    color: rgb(184, 154, 110);
    margin-left: 6px;
}

/* Tablet+: larger art, wheel centered between wordmark and tagline */
.viewport--tablet .title-hero__content {
    justify-content: flex-start;
    padding: 24px 20px 8px;
}

.viewport--tablet .title-wordmark-img {
    width: 500px;
    height: 125px;
    margin-top: 0;
    margin-bottom: 4px;
}

.viewport--tablet .title-hero__wheel-stage {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.viewport--tablet .title-wheel-stack {
    width: 400px;
    height: 400px;
}

.viewport--tablet .title-tagline-img {
    width: 425px;
    height: 120px;
    margin-top: 4px;
    margin-bottom: 4px;
}

/* Very narrow phones: slightly smaller wheel */
.viewport--compact .title-wheel-stack {
    width: 280px;
    height: 280px;
}

.viewport--compact .title-wordmark-img {
    width: 391px;
    height: 98px;
}

.viewport--compact .title-tagline-img {
    width: 338px;
    height: 95px;
}
