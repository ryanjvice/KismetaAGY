/* Kismeta — TitleScreen.uss (per-screen styling) */

.title-hero {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
    padding: 0;
    align-items: stretch;
    justify-content: flex-start;
    position: relative;
    overflow: hidden;
}

.title-hero__bg {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/splashBackground.png");
    -unity-background-scale-mode: scale-and-crop;
}

.title-hero__content {
    position: relative;
    flex-direction: column;
    flex-shrink: 0;
    align-items: center;
    justify-content: flex-start;
    padding: 36px 20px 16px;
}

.title-wheel-stack {
    position: relative;
    width: 300px;
    height: 300px;
    margin-bottom: 10px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.title-wheel-stack__star {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0.15;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/starChart.png");
    -unity-background-scale-mode: scale-to-fit;
}

.title-wheel-stack__zodiac {
    position: absolute;
    left: 28.75%;
    right: 28.75%;
    top: 28.75%;
    bottom: 28.75%;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/zodiacWheel.png");
    -unity-background-scale-mode: scale-to-fit;
}

.title-wheel-stack__mantle {
    position: absolute;
    left: 36.9%;
    right: 36.9%;
    top: 36.9%;
    bottom: 36.9%;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/mantleRing.png");
    -unity-background-scale-mode: scale-to-fit;
}

.title-wheel-stack__forge {
    position: absolute;
    left: 42%;
    right: 42%;
    top: 42%;
    bottom: 42%;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/crucibleForge.png");
    -unity-background-scale-mode: scale-to-fit;
}

.title-wordmark-img {
    width: 280px;
    height: 72px;
    margin-bottom: 2px;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/kismeta_metallic_1.png");
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.title-tagline-img {
    width: 300px;
    height: 48px;
    margin-bottom: 2px;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/alchemists_metallic.png");
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.title-flavor {
    font-size: 10px;
    color: rgb(201, 168, 120);
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/Amarante-Regular.asset");
    -unity-font-style: normal;
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 85%;
    margin-top: 8px;
    flex-shrink: 0;
}

.title-menu {
    padding: 8px 16px 16px;
    background-color: transparent;
    border-top-width: 0;
    flex-shrink: 0;
}

.title-menu__primary {
    font-size: 14px;
    margin-bottom: 4px;
}

.title-menu__row {
    flex-direction: row;
    margin-top: 8px;
}

.title-menu__row--secondary {
    margin-top: 2px;
}

.btn--menu {
    flex-grow: 1;
    background-color: rgba(28, 18, 8, 0.92);
    border-width: 2px;
    border-color: var(--gold-deep);
    color: rgb(201, 168, 74);
    border-radius: var(--radius-md);
    padding: 11px;
    -unity-text-align: middle-center;
    margin-right: 8px;
}
.btn--menu:last-child { margin-right: 0; }

.btn--menu-sm {
    flex-grow: 1;
    background-color: rgba(16, 10, 18, 0.9);
    border-width: 1px;
    border-color: var(--border-gold);
    color: rgb(184, 154, 138);
    border-radius: var(--radius-md);
    padding: 10px;
    font-size: 11px;
    -unity-text-align: middle-center;
    margin-right: 8px;
}
.btn--menu-sm:last-child { margin-right: 0; }
