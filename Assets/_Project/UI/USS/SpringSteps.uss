/* Kismeta — SpringSteps.uss
   Shared styling for the Spring step screens (#11-15) and reused by Winter
   tap-to-swap. Builds on Kismeta.uss tokens. */

/* tap-to-swap: two stacked zones (Spread / Hand) with movable chips */
.swap-zone {
    border-radius: var(--radius-lg);
    border-width: 1px;
    padding: 10px 12px;
    margin-bottom: 8px;
}
.swap-zone--spread {
    background-color: rgb(19,32,26);
    border-color: rgb(43,74,58);
}
.swap-zone--hand {
    background-color: rgb(22,16,28);
    border-color: var(--border-subtle);
}
.swap-zone__header {
    flex-direction: row; align-items: center; justify-content: space-between;
    margin-bottom: 8px;
}
.swap-zone__cards {
    flex-direction: row;
    flex-wrap: wrap;
}
.swap-zone__cards > .card-chip { margin-right: 5px; margin-bottom: 5px; }

/* a card showing its alignment value tag */
.card-chip__tag {
    position: absolute;
    top: -5px; right: -5px;
    background-color: var(--gold-bright);
    border-radius: 6px;
    padding: 0 3px;
    font-size: 8px;
    color: rgb(26,14,31);
    -unity-font-style: bold;
}

/* live readout row */
.readout {
    flex-direction: row; align-items: center; justify-content: space-between;
    background-color: var(--panel-darker);
    border-width: 1px; border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 9px 12px;
    margin-bottom: 8px;
}
.readout__metric { align-items: center; }
.readout__value { font-size: 15px; -unity-font-style: bold; }
.readout__label { font-size: 8px; color: var(--muted); }

/* big roll button / die host */
.roll-host {
    align-items: center; justify-content: center;
    margin: 8px 0 14px;
}
.die {
    width: 70px; height: 70px; border-radius: var(--radius-md);
    border-width: 2px; border-color: var(--gold-deep);
    background-color: rgb(36,20,18);
    align-items: center; justify-content: center;
}

/* harvest tally row */
.tally-row {
    flex-direction: row; align-items: center;
    background-color: var(--panel-darker);
    border-width: 1px; border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 8px 11px;
    margin-bottom: 6px;
}
.tally-row__pts { font-size: 14px; -unity-font-style: bold; }

/* Spring hub — roll scene */
.spring-hub__subtitle {
    font-size: 11px;
    color: rgb(154, 172, 146);
    -unity-text-align: middle-center;
    margin-top: 4px;
    margin-bottom: 8px;
    padding-left: 14px;
    padding-right: 14px;
}
.spring-hub__stage { align-items: center; }
.spring-hub__wheel {
    width: 120px;
    height: 120px;
    border-radius: 60px;
    border-width: 1px;
    border-color: rgb(43, 106, 74);
    background-color: rgb(19, 32, 26);
    margin-bottom: 8px;
    align-items: center;
    justify-content: center;
}
.spring-hub__wheel-glyph {
    font-size: 40px;
    color: rgb(244, 211, 94);
    -unity-text-align: middle-center;
}
.spring-hub__rolled-sign {
    font-size: 18px;
    color: rgb(244, 211, 94);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}
.spring-hub__sign-match {
    font-size: 10px;
    color: rgb(154, 172, 146);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}
.spring-hub__harvest-count {
    font-size: 13px;
    color: rgb(127, 196, 168);
}
.spring-hub__hint {
    font-size: 11px;
    color: rgb(184, 154, 110);
    margin-top: 8px;
}

/* Spring harvest tally screen */
.harvest-hero {
    align-items: center;
    justify-content: center;
    margin: 10px 14px 12px;
    padding: 16px 12px;
    border-radius: var(--radius-lg);
    border-width: 1px;
    border-color: rgb(43, 106, 74);
    background-color: rgb(22, 38, 31);
}
.harvest-hero__total {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(127, 196, 168);
}
.harvest-hero__label {
    font-size: 11px;
    color: rgb(154, 172, 146);
    margin-top: 4px;
}
.harvest-sources-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 14px;
    padding-right: 14px;
    margin-bottom: 6px;
}
.harvest-sources-header__title {
    font-size: 9px;
    color: rgb(122, 154, 130);
    letter-spacing: 0.5px;
}
.harvest-sources-header__summary {
    font-size: 9px;
    color: rgb(184, 154, 110);
}
.harvest-source-scroll {
    flex-grow: 1;
    max-height: 240px;
    margin-left: 14px;
    margin-right: 14px;
}
.harvest-source-list { flex-grow: 1; }
.harvest-source-row {
    flex-direction: row;
    align-items: center;
    background-color: var(--panel-darker);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 8px 11px;
    margin-bottom: 6px;
}
.harvest-source-row--boon {
    border-color: rgb(122, 100, 154);
    background-color: rgb(28, 22, 36);
}
.harvest-source-row__text { flex-grow: 1; }
.harvest-source-row__title {
    font-size: 11px;
    color: rgb(243, 233, 210);
}
.harvest-source-row__subtitle {
    font-size: 9px;
    color: rgb(154, 172, 146);
    margin-top: 2px;
}
.harvest-source-row__pts {
    font-size: 14px;
    -unity-font-style: bold;
}
.harvest-source-row__pts--neutral { color: rgb(184, 154, 110); }
.tally__pts--sign { color: rgb(244, 211, 94); }
.tally__pts--planet { color: rgb(224, 128, 96); }
.tally__pts--element { color: rgb(127, 196, 168); }
.harvest-footnote {
    font-size: 9px;
    color: rgb(122, 154, 130);
    -unity-text-align: middle-center;
    padding: 6px 14px 8px;
}

/* ---------- Winter wager sign grid (also used by Spring if needed) ---------- */
.sign-cell {
    width: 22%;
    height: 44px;
    margin-bottom: 8px;
    border-radius: var(--radius-md);
    background-color: var(--panel-darker);
    border-width: 1px; border-color: var(--border-subtle);
    color: var(--muted);
    font-size: 18px;
    -unity-text-align: middle-center;
}
.sign-cell--selected {
    background-color: var(--arcanum-bg);
    border-width: 2px; border-color: rgb(154,122,192);
    color: var(--arcanum-text);
}

/* over-limit card flag (Winter card limits) */
.card-chip--overlimit { border-width: 2px; border-color: rgb(224,160,96); }
