/* Kismeta — SpringSteps.uss
   Shared styling for the Spring step screens (#11-15) and reused by Winter
   tap-to-swap. Builds on Kismeta.uss tokens. */

/* tap-to-swap: two stacked zones (Spread / Hand) with movable chips */
.swap-zone {
    border-radius: var(--radius-lg);
    border-width: 1px;
    padding: 10px 12px;
    margin-bottom: 8px;
}
.swap-zone--spread {
    background-color: rgb(19,32,26);
    border-color: rgb(43,74,58);
}
.swap-zone--hand {
    background-color: rgb(22,16,28);
    border-color: var(--border-subtle);
}
.swap-zone__header {
    flex-direction: row; align-items: center; justify-content: space-between;
    margin-bottom: 8px;
}
.swap-zone__cards {
    flex-direction: row;
    flex-wrap: wrap;
}
.swap-zone__cards > .card-chip { margin-right: 6px; margin-bottom: 6px; }

/* a card showing its alignment value tag */
.card-chip__tag {
    position: absolute;
    top: -5px; right: -5px;
    background-color: var(--gold-bright);
    border-radius: 6px;
    padding: 0 3px;
    font-size: 8px;
    color: rgb(26,14,31);
    -unity-font-style: bold;
}

/* live readout row */
.readout {
    flex-direction: row; align-items: center; justify-content: space-between;
    background-color: var(--panel-darker);
    border-width: 1px; border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 9px 12px;
    margin-bottom: 8px;
}
.readout__metric { align-items: center; }
.readout__value { font-size: 15px; -unity-font-style: bold; }
.readout__label { font-size: 8px; color: var(--muted); }

/* big roll button / die host */
.roll-host {
    align-items: center; justify-content: center;
    margin: 4px 0 8px;
}
.die {
    width: 70px; height: 70px; border-radius: var(--radius-md);
    border-width: 2px; border-color: var(--gold-deep);
    background-color: rgb(36,20,18);
    align-items: center; justify-content: center;
}

/* harvest tally row */
.tally-row {
    flex-direction: row; align-items: center;
    background-color: var(--panel-darker);
    border-width: 1px; border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 8px 11px;
    margin-bottom: 6px;
}
.tally-row__pts { font-size: 14px; -unity-font-style: bold; }

/* Spring hub — roll scene */
.spring-hub__stage { align-items: center; }

.wheel-stack {
    position: relative;
    width: 180px;
    height: 180px;
    margin: 4px 0 8px;
    align-items: center;
    justify-content: center;
}

.wheel-stack__star {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0.15;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/starChart.png");
    -unity-background-scale-mode: scale-to-fit;
}

.wheel-stack__zodiac {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 8%;
    bottom: 8%;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/zodiacWheel.png");
    -unity-background-scale-mode: scale-to-fit;
}

.wheel-stack__glyph-host {
    position: absolute;
    left: 32%;
    right: 32%;
    top: 32%;
    bottom: 32%;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    background-color: rgb(22, 32, 58);
    border-width: 2px;
    border-color: var(--gold-deep);
}

.wheel-stack__glyph {
    font-size: 32px;
    color: var(--gold-bright);
    -unity-text-align: middle-center;
}

.spring-hub__wheel {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    border-width: 1px;
    border-color: rgb(43, 106, 74);
    background-color: rgb(19, 32, 26);
    margin-bottom: 4px;
    align-items: center;
    justify-content: center;
}
.spring-hub__wheel-glyph {
    font-size: 32px;
    color: rgb(244, 211, 94);
    -unity-text-align: middle-center;
}
.spring-hub__rolled-sign {
    font-size: 18px;
    color: rgb(244, 211, 94);
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}
.spring-hub__sign-match {
    font-size: 10px;
    color: rgb(154, 172, 146);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}
.spring-hub__harvest-count {
    font-size: 13px;
    color: rgb(127, 196, 168);
}
.spring-hub__hint {
    font-size: 11px;
    color: rgb(184, 154, 110);
    margin-top: 4px;
}

/* Commune panel embedded in Spring hub center stage */
.commune-stage {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    overflow: hidden;
    padding-left: 14px;
    padding-right: 14px;
    padding-bottom: 4px;
}
.commune-stage--hidden { display: none; }
.spring-hub__stage--hidden { display: none; }
.screen__inventory--hidden { display: none; }
.commune-stage__readout-wrap { flex-shrink: 0; padding-top: 4px; }
.commune-stage__zone-wrap { flex-shrink: 0; }
.commune-stage__tip {
    flex-shrink: 0;
    margin-top: 4px;
    margin-bottom: 4px;
}

/* Spring harvest compare row */
.harvest-compare {
    flex-direction: row;
    flex-shrink: 0;
    margin: 10px 14px 8px;
}
.harvest-compare__panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    align-items: center;
    padding: 10px 8px;
    border-radius: var(--radius-lg);
    border-width: 1px;
    border-color: rgb(43, 106, 74);
    background-color: rgb(22, 38, 31);
    margin-right: 8px;
}
.harvest-compare__panel:last-child { margin-right: 0; }
.harvest-compare__eyebrow {
    font-size: 8px;
    color: rgb(122, 154, 130);
    margin-bottom: 6px;
}
.harvest-compare__sigil {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    border-width: 1px;
    border-color: var(--gold-deep);
    background-color: var(--gold-deep);
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
}
.harvest-compare__glyph {
    font-size: 18px;
    color: rgb(26, 14, 31);
    -unity-text-align: middle-center;
}
.harvest-compare__sign {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(244, 211, 94);
    margin-bottom: 6px;
}
.harvest-compare__sign--match {
    color: rgb(255, 230, 120);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: rgb(244, 211, 94);
    background-color: rgba(52, 42, 16, 0.6);
}
.harvest-compare__aspects {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
}
.harvest-compare__chip {
    font-size: 9px;
    -unity-font-style: bold;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    border-width: 1px;
    margin-right: 4px;
    margin-bottom: 2px;
}
.harvest-compare__chip:last-child { margin-right: 0; }
.harvest-compare__chip--planet {
    background-color: rgba(46, 28, 10, 0.85);
    border-color: var(--border-gold);
    color: rgb(224, 128, 96);
}
.harvest-compare__chip--element {
    background-color: rgba(22, 32, 58, 0.85);
    border-color: rgb(111, 168, 212);
    color: rgb(127, 196, 168);
}
.harvest-compare__chip--match-sign {
    border-color: rgb(244, 211, 94);
    background-color: rgba(52, 42, 16, 0.95);
    color: rgb(244, 211, 94);
}
.harvest-compare__chip--match-planet {
    border-color: rgb(224, 128, 96);
    background-color: rgba(52, 28, 16, 0.95);
    color: rgb(240, 153, 123);
}
.harvest-compare__chip--match-element {
    border-color: rgb(127, 196, 168);
    background-color: rgba(22, 38, 31, 0.95);
    color: rgb(127, 196, 168);
}
.harvest-compare__alignment {
    font-size: 9px;
    color: rgb(154, 172, 146);
    margin-top: 6px;
    -unity-text-align: middle-center;
}

/* Spring harvest tally screen */
.harvest-hero {
    align-items: center;
    justify-content: center;
    margin: 4px 14px 12px;
    padding: 16px 12px;
    border-radius: var(--radius-lg);
    border-width: 1px;
    border-color: rgb(43, 106, 74);
    background-color: rgb(22, 38, 31);
}
.harvest-hero__total {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(127, 196, 168);
}
.harvest-hero__label {
    font-size: 11px;
    color: rgb(154, 172, 146);
    margin-top: 4px;
}
.harvest-sources-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 14px;
    padding-right: 14px;
    margin-bottom: 6px;
}
.harvest-sources-header__title {
    font-size: 9px;
    color: rgb(122, 154, 130);
    letter-spacing: 0.5px;
}
.harvest-sources-header__summary {
    font-size: 9px;
    color: rgb(184, 154, 110);
}
.harvest-source-scroll {
    flex-grow: 1;
    max-height: 240px;
    margin-left: 14px;
    margin-right: 14px;
}
.harvest-source-list { flex-grow: 1; }
.harvest-source-row {
    flex-direction: row;
    align-items: center;
    background-color: var(--panel-darker);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 8px 11px;
    margin-bottom: 6px;
}
.harvest-source-row--boon {
    border-color: rgb(122, 100, 154);
    background-color: rgb(28, 22, 36);
}
.harvest-source-row__text { flex-grow: 1; }
.harvest-source-row__title {
    font-size: 11px;
    color: rgb(243, 233, 210);
}
.harvest-source-row__subtitle {
    font-size: 9px;
    color: rgb(154, 172, 146);
    margin-top: 2px;
}
.harvest-source-row__pts {
    font-size: 14px;
    -unity-font-style: bold;
}
.harvest-source-row__pts--neutral { color: rgb(184, 154, 110); }
.tally__pts--sign { color: rgb(244, 211, 94); }
.tally__pts--planet { color: rgb(224, 128, 96); }
.tally__pts--element { color: rgb(127, 196, 168); }
.harvest-footnote {
    font-size: 9px;
    color: rgb(122, 154, 130);
    -unity-text-align: middle-center;
    padding: 6px 14px 8px;
}

/* ---------- Winter wager sign grid (also used by Spring if needed) ---------- */
.sign-cell {
    width: 22%;
    height: 44px;
    margin-bottom: 8px;
    border-radius: var(--radius-md);
    background-color: var(--panel-darker);
    border-width: 1px; border-color: var(--border-subtle);
    color: var(--muted);
    font-size: 18px;
    -unity-text-align: middle-center;
}
.sign-cell--selected {
    background-color: var(--arcanum-bg);
    border-width: 2px; border-color: rgb(154,122,192);
    color: var(--arcanum-text);
}

/* over-limit card flag (Winter card limits) */
.card-chip--overlimit { border-width: 2px; border-color: rgb(224,160,96); }
