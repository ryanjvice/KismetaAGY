/* Kismeta — SpringSteps.uss
   Shared styling for the Spring step screens (#11-15) and reused by Winter
   tap-to-swap. Builds on Kismeta.uss tokens. */

/* tap-to-swap: two stacked zones (Spread / Hand) with movable chips */
.swap-zone {
    border-radius: var(--radius-lg);
    border-width: 1px;
    padding: 10px 12px;
    margin-bottom: 8px;
}
.swap-zone--spread {
    background-color: rgb(19,32,26);
    border-color: rgb(43,74,58);
    margin-bottom: 4px;
}
.swap-zone--hand {
    background-color: rgb(22,16,28);
    border-color: var(--border-subtle);
}
.swap-zone__header {
    flex-direction: row; align-items: center; justify-content: space-between;
    margin-bottom: 8px;
}
.swap-zone__cards {
    flex-direction: row;
    flex-wrap: wrap;
}
.swap-zone__cards > .card-chip { margin-right: 6px; margin-bottom: 6px; }

/* a card showing its alignment value tag */
.card-chip__tag {
    position: absolute;
    top: -5px; right: -5px;
    background-color: var(--gold-bright);
    border-radius: 6px;
    padding: 0 3px;
    font-size: 8px;
    color: rgb(26,14,31);
    -unity-font-style: bold;
}

/* live readout row */
.readout {
    flex-direction: row; align-items: center; justify-content: space-between;
    background-color: var(--panel-darker);
    border-width: 1px; border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 9px 12px;
    margin-bottom: 8px;
}
.readout__metric { align-items: center; }
.readout__value { font-size: 15px; -unity-font-style: bold; }
.readout__label { font-size: 8px; color: var(--muted); }

/* big roll button / die host */
.roll-host {
    align-items: center; justify-content: center;
    margin: 4px 0 8px;
}
.die {
    width: 70px; height: 70px; border-radius: var(--radius-md);
    border-width: 2px; border-color: var(--gold-deep);
    background-color: rgb(36,20,18);
    align-items: center; justify-content: center;
}

/* harvest tally row */
.tally-row {
    flex-direction: row; align-items: center;
    background-color: var(--panel-darker);
    border-width: 1px; border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 8px 11px;
    margin-bottom: 6px;
}
.tally-row__pts { font-size: 14px; -unity-font-style: bold; }

/* Spring hub — roll scene */
.spring-hub__toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 0 var(--space-md);
    margin: var(--space-xs) var(--space-md) 0;
    min-height: 40px;
}

.spring-hub__toolbar--hidden {
    display: none;
}

.spring-hub__toolbar .table-fab,
.spring-hub__toolbar .effects-fab {
    position: relative;
    top: auto;
    right: auto;
    flex-shrink: 0;
}

.spring-hub__toolbar .narrative-beat {
    flex-grow: 1;
    flex-shrink: 1;
    -unity-text-align: middle-center;
    margin: 0 var(--space-sm);
    margin-bottom: 0;
}

.spring-hub__stage { align-items: center; }

.spring-hub__stage .narrative-charge,
.commune-stage .narrative-charge {
    -unity-text-align: middle-center;
    align-self: stretch;
    margin-top: 4px;
    margin-bottom: 6px;
}

.spring-hub__stakes {
    flex-shrink: 0;
    margin: 0 var(--space-md) var(--space-sm);
}

.spring-hub__stakes .narrative-stakes-wrap {
    margin: 0;
}

.wheel-stack {
    position: relative;
    width: 180px;
    height: 180px;
    margin: 4px 0 8px;
    align-items: center;
    justify-content: center;
}

.wheel-stack__star {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0.15;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/starChart.png");
    -unity-background-scale-mode: scale-to-fit;
}

.wheel-stack__zodiac {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 8%;
    bottom: 8%;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/zodiacWheel.png");
    -unity-background-scale-mode: scale-to-fit;
}

.wheel-stack__glyph-host {
    position: absolute;
    left: 32%;
    right: 32%;
    top: 32%;
    bottom: 32%;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    background-color: rgb(22, 32, 58);
    border-width: 2px;
    border-color: var(--gold-deep);
}

.wheel-stack__glyph {
    font-size: 32px;
    color: var(--gold-bright);
    -unity-text-align: middle-center;
}

.spring-hub__wheel {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    border-width: 1px;
    border-color: rgb(43, 106, 74);
    background-color: rgb(19, 32, 26);
    margin-bottom: 4px;
    align-items: center;
    justify-content: center;
}
.spring-hub__wheel-glyph {
    font-size: 32px;
    color: rgb(244, 211, 94);
    -unity-text-align: middle-center;
}
.spring-hub__rolled-sign {
    font-size: 18px;
    color: rgb(244, 211, 94);
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}
.spring-hub__sign-match {
    font-size: 10px;
    color: var(--muted);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}
.spring-hub__harvest-count {
    font-size: 15px;
    color: rgb(127, 196, 168);
}
.spring-hub__hint {
    font-size: 13px;
    color: rgb(184, 154, 110);
    margin-top: 4px;
}

/* Commune panel embedded in Spring hub center stage */
.commune-stage {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    overflow: hidden;
    padding-left: 14px;
    padding-right: 14px;
    padding-bottom: 4px;
    align-items: stretch;
    align-self: stretch;
    justify-content: flex-start;
    width: 100%;
}
.commune-stage--hidden { display: none; }
.spring-hub__stage--hidden { display: none; }
.player-inventory-overlay--hidden { display: none; }

.commune-stage__heading {
    flex-shrink: 0;
    align-self: stretch;
    -unity-text-align: middle-center;
    color: var(--arcanum-text);
    font-size: var(--font-title);
    margin-top: 4px;
    margin-bottom: 6px;
}

.commune-stage__readout-wrap {
    flex-shrink: 0;
    padding-top: 0;
    margin-top: 4px;
}
.commune-stage__zone-wrap { flex-shrink: 0; }
.commune-stage__tip {
    flex-shrink: 0;
    margin-top: 0;
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 8px;
}

.commune-stage__swap-indicator {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
    margin-bottom: 10px;
}
.commune-stage__swap-badge {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--arcanum-border);
    background-color: var(--arcanum-bg);
    align-items: center;
    justify-content: center;
}
.commune-stage__swap-icon {
    font-size: 14px;
    color: var(--arcanum-text);
}

/* Winter Unlock tap-to-swap body (standalone screen) */
.tap-swap-body {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    overflow: hidden;
    padding-left: 14px;
    padding-right: 14px;
    padding-bottom: 4px;
    align-items: stretch;
    align-self: stretch;
    justify-content: flex-start;
    width: 100%;
}

/* Spring harvest compare row */
.harvest-heading-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: baseline;
    flex-shrink: 0;
    margin-top: 4px;
    margin-bottom: 8px;
    margin-left: 14px;
    margin-right: 14px;
}
.harvest-heading-row__beat {
    flex-shrink: 1;
    min-width: 0;
    margin-left: 8px;
    margin-bottom: 0;
    font-size: var(--font-label);
}
.harvest-compare__heading {
    flex-shrink: 0;
    -unity-text-align: middle-left;
    color: var(--arcanum-text);
    font-size: var(--font-title);
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
}
.harvest-compare {
    flex-direction: row;
    flex-shrink: 0;
    margin: 0 14px 8px;
}
.harvest-compare__panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    align-items: center;
    padding: 10px 8px;
    border-radius: var(--radius-lg);
    border-width: 1px;
    border-color: rgb(43, 106, 74);
    background-color: rgb(22, 38, 31);
    margin-right: 8px;
}
.harvest-compare__panel:last-child { margin-right: 0; }
.harvest-compare__panel--fire {
    border-color: rgb(180, 72, 56);
    background-color: rgba(52, 18, 16, 0.95);
}
.harvest-compare__panel--water {
    border-color: rgb(111, 168, 212);
    background-color: rgba(22, 32, 58, 0.95);
}
.harvest-compare__panel--earth {
    border-color: rgb(59, 140, 96);
    background-color: rgba(19, 36, 26, 0.95);
}
.harvest-compare__panel--air {
    border-color: rgb(180, 150, 80);
    background-color: rgba(42, 35, 14, 0.95);
}
.harvest-compare__eyebrow {
    font-size: 8px;
    color: rgb(122, 154, 130);
    margin-bottom: 6px;
}
.harvest-compare__sigil {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    border-width: 1px;
    border-color: var(--gold-deep);
    background-color: var(--gold-deep);
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
}
.harvest-compare__glyph {
    font-size: 18px;
    color: rgb(26, 14, 31);
    -unity-text-align: middle-center;
}
.harvest-compare__sign {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(244, 211, 94);
    margin-bottom: 6px;
}
.harvest-compare__sign--match {
    color: rgb(255, 230, 120);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: rgb(244, 211, 94);
    background-color: rgba(52, 42, 16, 0.6);
}
.harvest-compare__aspects {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
}
.harvest-compare__chip {
    font-size: 9px;
    -unity-font-style: bold;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    border-width: 1px;
    margin-right: 4px;
    margin-bottom: 2px;
}
.harvest-compare__chip:last-child { margin-right: 0; }
.harvest-compare__chip--planet {
    background-color: rgba(46, 28, 10, 0.85);
    border-color: var(--border-gold);
    color: rgb(224, 128, 96);
}
.harvest-compare__chip--fire {
    background-color: rgba(52, 28, 16, 0.95);
    border-color: rgb(224, 128, 96);
    color: rgb(240, 153, 123);
}
.harvest-compare__chip--water {
    background-color: rgba(22, 32, 58, 0.85);
    border-color: rgb(111, 168, 212);
    color: rgb(111, 168, 212);
}
.harvest-compare__chip--earth {
    background-color: rgba(19, 36, 26, 0.95);
    border-color: rgb(59, 140, 96);
    color: rgb(127, 196, 168);
}
.harvest-compare__chip--air {
    background-color: rgba(42, 35, 14, 0.95);
    border-color: rgb(180, 150, 80);
    color: rgb(224, 192, 96);
}
.harvest-compare__chip--match-sign {
    border-color: rgb(244, 211, 94);
    background-color: rgba(52, 42, 16, 0.95);
    color: rgb(244, 211, 94);
}
.harvest-compare__chip--match-planet {
    border-color: rgb(224, 128, 96);
    background-color: rgba(52, 28, 16, 0.95);
    color: rgb(240, 153, 123);
}
.harvest-compare__chip--fire.harvest-compare__chip--match-element {
    border-color: rgb(255, 180, 140);
    background-color: rgba(72, 28, 20, 0.98);
    color: rgb(255, 200, 160);
}
.harvest-compare__chip--water.harvest-compare__chip--match-element {
    border-color: rgb(140, 190, 240);
    background-color: rgba(28, 42, 72, 0.98);
    color: rgb(160, 200, 255);
}
.harvest-compare__chip--earth.harvest-compare__chip--match-element {
    border-color: rgb(100, 200, 150);
    background-color: rgba(24, 48, 34, 0.98);
    color: rgb(160, 230, 190);
}
.harvest-compare__chip--air.harvest-compare__chip--match-element {
    border-color: rgb(220, 190, 110);
    background-color: rgba(58, 48, 18, 0.98);
    color: rgb(255, 220, 130);
}
.harvest-compare__alignment {
    font-size: 9px;
    color: rgb(154, 172, 146);
    margin-top: 6px;
    -unity-text-align: middle-center;
}

/* Spring harvest tally screen */
.harvest-sources {
    flex-shrink: 0;
    flex-direction: column;
    margin-left: 14px;
    margin-right: 14px;
    margin-bottom: 0;
}
.harvest-sources-heading-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: baseline;
    flex-shrink: 0;
    margin-top: 4px;
    margin-bottom: 8px;
}
.harvest-sources-heading-row__rule {
    flex-shrink: 1;
    min-width: 0;
    margin-left: 8px;
    margin-bottom: 0;
    font-size: var(--font-label);
    color: rgb(122, 154, 130);
    white-space: normal;
}
.harvest-sources__title {
    flex-shrink: 0;
    -unity-text-align: middle-left;
    color: var(--arcanum-text);
    font-size: var(--font-title);
    margin-top: 0;
    margin-bottom: 0;
}
.harvest-source-scroll {
    flex-shrink: 0;
    max-height: 220px;
}
.harvest-source-list { flex-shrink: 0; }
.harvest-footer {
    flex-shrink: 0;
    flex-direction: column;
    margin-top: 8px;
    padding-bottom: var(--space-sm);
}
.harvest-hero {
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 0 14px 0;
    padding: 14px 12px;
    border-radius: var(--radius-lg);
    border-width: 1px;
    border-color: rgb(43, 106, 74);
    background-color: rgb(22, 38, 31);
}
.harvest-hero--action {
    align-self: stretch;
    min-height: var(--touch-min);
    -unity-text-align: middle-center;
}
.harvest-hero--action:hover {
    border-color: rgb(59, 140, 96);
    background-color: rgb(28, 48, 38);
}
.harvest-hero--action:active {
    border-color: rgb(43, 106, 74);
    background-color: rgb(18, 32, 26);
}
.viewport--compact .harvest-source-scroll {
    max-height: 180px;
}
.viewport--compact .harvest-footer {
    margin-top: 4px;
}
.viewport--compact .harvest-hero {
    padding: 12px 10px;
}
.harvest-hero__breakdown {
    font-size: 11px;
    color: rgb(184, 154, 110);
    -unity-text-align: middle-center;
}
.harvest-hero__total {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(127, 196, 168);
    -unity-text-align: middle-center;
    margin-top: 6px;
}
.harvest-hero__cta {
    font-size: 11px;
    color: rgb(184, 154, 110);
    -unity-text-align: middle-center;
    margin-top: 8px;
}
.harvest-source-row {
    flex-direction: row;
    align-items: center;
    background-color: var(--panel-darker);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 8px 11px;
    margin-bottom: 6px;
}
.harvest-source-row--boon {
    border-color: rgb(122, 100, 154);
    background-color: rgb(28, 22, 36);
}
.harvest-source-row__title {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    font-size: 11px;
    color: rgb(243, 233, 210);
    -unity-text-align: middle-left;
}
.harvest-source-row__match {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    font-size: 9px;
    color: rgb(154, 172, 146);
    -unity-text-align: middle-center;
}
.harvest-source-row__pts {
    flex-shrink: 0;
    flex-grow: 0;
    min-width: 36px;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}
.harvest-source-row__pts--neutral { color: rgb(184, 154, 110); }
.tally__pts--sign { color: rgb(244, 211, 94); }
.tally__pts--planet { color: rgb(224, 128, 96); }
.tally__pts--element { color: rgb(127, 196, 168); }

/* ---------- Winter wager sign grid (also used by Spring if needed) ---------- */
.sign-cell {
    width: 22%;
    height: 44px;
    margin-bottom: 8px;
    border-radius: var(--radius-md);
    background-color: var(--panel-darker);
    border-width: 1px; border-color: var(--border-subtle);
    color: var(--muted);
    font-size: 18px;
    -unity-text-align: middle-center;
}
.sign-cell--selected {
    background-color: var(--arcanum-bg);
    border-width: 2px; border-color: rgb(154,122,192);
    color: var(--arcanum-text);
}

/* over-limit card flag (Winter card limits) */
.card-chip--overlimit { border-width: 2px; border-color: rgb(224,160,96); }
