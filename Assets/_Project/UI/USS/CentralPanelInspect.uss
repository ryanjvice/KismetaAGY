/* Floating inspect FAB on central panels + shared inspect modal shell. */

.central-panel-inspect {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 2;
}

.central-panel-inspect-fab {
    min-width: 36px;
    min-height: 36px;
    border-width: 1px;
    border-radius: 18px;
    border-color: var(--border-gold);
    background-color: rgba(28, 18, 38, 0.92);
    color: rgb(232, 185, 74);
    font-size: 16px;
    padding: 0;
    -unity-text-align: middle-center;
}

.central-panel-inspect-fab:hover {
    background-color: rgba(42, 28, 52, 0.96);
    color: rgb(244, 211, 94);
}

.central-panel-inspect-fab--hidden {
    display: none;
}

.spring-board-inspect {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.overlay-clone-host > .spring-board-inspect {
    margin-bottom: var(--space-xl);
    max-height: 95%;
}

.spring-board-inspect__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 8px 14px var(--space-xl);
}

.central-panel-inspect-modal__content {
    flex-direction: column;
    padding-bottom: var(--space-md);
}

.autumn-forge-inspect {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.overlay-clone-host > .autumn-forge-inspect {
    margin-bottom: var(--space-xl);
    max-height: 95%;
}

.autumn-forge-inspect__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 8px 14px var(--space-xl);
}

.central-panel-inspect-player-row__stone {
    font-size: 11px;
    color: rgb(243, 233, 210);
    margin-bottom: 4px;
    white-space: normal;
}

.central-panel-inspect-player-row__stone--stasis {
    color: rgb(224, 138, 74);
}

.central-panel-inspect-player-row__stasis-note {
    font-size: 9px;
    color: rgb(154, 122, 122);
    margin-bottom: 4px;
}

.central-panel-inspect-cauldron-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.central-panel-inspect-cauldron-chip {
    font-size: 9px;
    padding: 2px 6px;
    margin-right: 4px;
    margin-bottom: 2px;
    border-width: 1px;
    border-radius: 4px;
    border-color: var(--border-subtle);
    color: rgb(122, 110, 110);
}

.central-panel-inspect-cauldron-chip--lit {
    border-color: rgb(224, 138, 74);
    color: rgb(244, 211, 94);
}

.central-panel-inspect-cauldron-chip--dormant {
    opacity: 0.55;
}

.central-panel-inspect-section {
    margin-bottom: 14px;
}

.central-panel-inspect-section:last-child {
    margin-bottom: 0;
}

.central-panel-inspect-section__body {
    flex-direction: column;
}

.central-panel-inspect-player-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 8px;
    padding: 8px 10px;
    border-width: 1px;
    border-radius: 8px;
    border-color: var(--border-subtle);
    background-color: rgba(16, 10, 18, 0.55);
}

.central-panel-inspect-player-row:last-child {
    margin-bottom: 0;
}

.central-panel-inspect-player-row__dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 8px;
    flex-shrink: 0;
}

.central-panel-inspect-player-row__info {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
}

.central-panel-inspect-player-row__name {
    font-size: 12px;
    color: rgb(243, 233, 210);
    margin-bottom: 2px;
}

.central-panel-inspect-player-row__sign-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.central-panel-inspect-player-row__meta {
    font-size: 10px;
    color: rgb(184, 154, 110);
    margin-left: 6px;
}

.central-panel-inspect-house-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 8px;
    padding: 8px 10px;
    border-width: 1px;
    border-radius: 8px;
    border-color: var(--border-subtle);
    background-color: rgba(16, 10, 18, 0.55);
}

.central-panel-inspect-house-row:last-child {
    margin-bottom: 0;
}

.central-panel-inspect-house-row__chip {
    margin-right: 8px;
    flex-shrink: 0;
}

.central-panel-inspect-house-row .house-chip__glyph {
    color: var(--gold-bright);
}

.central-panel-inspect-house-row__info {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
}

.central-panel-inspect-house-row__owner {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.central-panel-inspect-house-row__owner-name {
    font-size: 11px;
    color: rgb(243, 233, 210);
}

.central-panel-inspect-house-row__desc {
    font-size: 10px;
    color: rgb(184, 154, 110);
    white-space: normal;
}

.central-panel-inspect-empty {
    font-size: 11px;
    color: rgb(154, 122, 122);
}
