/* Kismeta — SummerActions.uss
   Shared styling for Summer action sheets and screens (#18-25, 27).
   Reagent stepper + transaction strip here are reused by Autumn (Fire) and
   contests (fees) in later batches. */

/* action sheet (Craft & build / Consort) — a list of action rows */
.action-sheet__row {
    flex-direction: row; align-items: center;
    background-color: var(--panel-darker);
    border-width: 1px; border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 11px 12px;
    margin-bottom: 7px;
    flex-shrink: 0;
}
.action-sheet__row:last-child { margin-bottom: 0; }
.action-sheet__icon {
    width: 30px; height: 30px; border-radius: var(--radius-md);
    border-width: 1px;
    align-items: center; justify-content: center;
    margin-right: 11px;
}
.action-sheet__sub { font-size: 10px; color: var(--muted); white-space: normal; }

/* reagent fee / cost stepper */
.stepper-row {
    flex-direction: row; align-items: center;
    background-color: var(--panel-darker);
    border-width: 1px; border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 7px 10px;
    margin-bottom: 6px;
}
.stepper-btn {
    width: 26px; height: 26px; border-radius: var(--radius-sm);
    border-width: 1px;
    align-items: center; justify-content: center;
}
.stepper-btn--minus { background-color: rgb(22,12,8); border-color: rgb(106,74,58); }
.stepper-btn--plus  { background-color: rgb(58,26,14); border-color: var(--gold-deep); }
.stepper-btn--disabled { border-color: rgb(58,32,24); }
.stepper-value { min-width: 14px; font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-center; }

/* "paying X / N" pill */
.pay-pill {
    flex-direction: row; align-items: center; justify-content: space-between;
    background-color: rgb(28,18,12);
    border-width: 1px; border-color: rgb(74,40,24);
    border-radius: var(--radius-md);
    padding: 10px 12px;
    margin-bottom: 8px;
}
.pay-slot {
    width: 16px; height: 16px; border-radius: 8px;
    border-width: 1px;
    margin-right: 4px;
}
.pay-slot--empty { background-color: rgba(0,0,0,0); border-color: rgb(90,74,58); }

/* transaction strip: inputs -> output */
.txn {
    flex-direction: row; align-items: center; justify-content: center;
    background-color: var(--panel-darker);
    border-width: 1px; border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 11px;
    margin-bottom: 8px;
}
.txn__arrow { font-size: 16px; color: var(--muted); margin: 0 10px; }

/* formula slot (Activate) + card pick row (Craft / Build) */
.formula {
    flex-direction: row; flex-wrap: wrap; align-items: center;
}

.card-pool {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-evenly;
    align-content: flex-start;
    width: 100%;
}

.card-pool > .card-chip {
    overflow: hidden;
    margin-bottom: 6px;
}

.card-pool .card-chip__rank {
    font-size: 11px;
    -unity-text-align: middle-center;
    overflow: hidden;
    max-width: 100%;
    padding-left: 1px;
    padding-right: 1px;
}
.formula-slot {
    width: var(--card-chip-w);
    height: var(--card-chip-h);
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: rgb(90,74,58);
    align-items: center;
    justify-content: center;
    margin-right: 5px;
}
.formula-slot--empty {
    background-color: rgba(0,0,0,0);
    border-color: rgb(74,58,42);
}

/* benefit list (Build house) */
.benefit-row {
    flex-direction: row; align-items: center;
    background-color: var(--panel-darker);
    border-width: 1px; border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 8px 11px;
    margin-bottom: 6px;
}

/* reagent picker chip (Craft) */
.reagent-pick--salt {
    width: 100%;
}

.reagent-picker {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    flex-shrink: 0;
}

.craft-pick {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
}

.craft-body {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    padding-bottom: var(--space-xs);
}

.reagent-pick {
    width: 48%;
    flex-direction: row; align-items: center;
    background-color: var(--panel-darker);
    border-width: 1px; border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 9px 11px;
    margin-bottom: 7px;
}
.reagent-pick--active {
    background-color: var(--ok-bg);
    border-width: 2px; border-color: var(--ok-border);
}
.reagent-pick--locked { opacity: 0.45; }

/* Activate panel — compact layout so intro + slots + formula + footer fit on screen */
#activate .statusbar {
    padding-top: 6px;
    padding-bottom: 6px;
}

#activate .tip {
    padding: 6px 9px;
    margin-top: 4px;
    margin-bottom: 4px;
    margin-left: 14px;
    margin-right: 14px;
}

#activate .activate-section {
    padding: 6px 14px 2px;
}

#activate .activate-section--detail {
    padding: 4px 14px 6px;
}

#activate .eyebrow {
    margin-bottom: 4px;
}

#activate .crucible-slots__row {
    margin-bottom: 4px;
}

#activate .crucible-slots__row:last-child {
    margin-bottom: 0;
}

#activate .crucible-slot {
    padding: 6px 8px;
}

#activate .crucible-slot__head {
    margin-bottom: 2px;
}

#activate .crucible-slot__ring {
    width: 20px;
    height: 20px;
    border-radius: 10px;
}

#activate .crucible-slot__reagent {
    font-size: 11px;
    margin-bottom: 2px;
}

#activate .formula-card {
    padding: 8px 10px;
}

#activate .formula-card__head {
    margin-bottom: 6px;
}

#activate .formula-card__ring {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    margin-right: 8px;
}

#activate .formula-card__count {
    font-size: 13px;
}

#activate .formula-slot {
    width: 38px;
    height: 54px;
}

#activate .formula-status {
    margin-top: 4px;
}

#activate #formula-chips > .card-chip {
    width: 38px;
    min-height: 54px;
    margin-right: 4px;
    margin-bottom: 4px;
}

#activate #formula-chips > .formula-slot {
    margin-right: 4px;
    margin-bottom: 4px;
}

#activate .activate-footer {
    padding: 6px 14px 10px;
}

/* ---------- Activate: four cauldron slots + formula reveal (#21 v2) ---------- */
.activate-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.activate-footer {
    flex-shrink: 0;
    padding: 8px 14px 16px;
}

.crucible-slots {
    flex-direction: column;
}

.crucible-slots__row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}

.crucible-slot {
    width: 48%;
    max-width: 48%;
    min-width: 0;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    align-items: stretch;
    align-self: flex-start;
    -unity-text-align: upper-left;
    white-space: normal;
    background-color: rgb(22,10,28);
    border-width: 1px; border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 10px 11px;
}
.crucible-slot--selected { border-width: 2px; }
.crucible-slot--active { opacity: 0.55; }
.crucible-slot__head { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 5px; }
.crucible-slot__ring {
    width: 24px; height: 24px; border-radius: 12px;
    background-color: rgb(28,18,8);
    border-width: 2px;
    align-items: center; justify-content: center;
}
.crucible-slot__reagent { font-size: 12px; -unity-font-style: bold; color: var(--ink); margin-bottom: 4px; }

/* ---------- Pass your turn (End Summer) ---------- */
.end-summer__title {
    color: rgb(127, 196, 168);
}

.end-summer__close {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--muted);
    font-size: 18px;
    min-width: var(--touch-min);
    min-height: var(--touch-min);
}

.end-summer__section {
    margin-bottom: var(--space-md);
}

.end-summer__eyebrow {
    font-size: var(--font-label);
    color: var(--muted);
    letter-spacing: 1px;
    margin-bottom: var(--space-sm);
}

.end-summer__recap-list {
    flex-direction: column;
}

.end-summer__recap-row {
    flex-direction: row;
    align-items: center;
    background-color: var(--panel-darker);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 9px 11px;
    margin-bottom: 6px;
}

.end-summer__hints {
    flex-direction: column;
    align-items: stretch;
    margin: 0;
}

.end-summer__hint-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 7px;
}

.end-summer__hint-row:last-child {
    margin-bottom: 0;
}

.end-summer__line {
    font-size: var(--font-body);
    color: var(--ink);
    white-space: normal;
    flex-shrink: 1;
}

.end-summer__hints .end-summer__line {
    color: var(--caution-text);
}

.end-summer__footnote {
    font-size: var(--font-label);
    color: var(--muted);
    -unity-text-align: middle-center;
    margin-top: var(--space-sm);
    white-space: normal;
}

.end-summer__actions {
    flex-direction: row;
    margin-top: var(--space-xs);
}

.end-summer__btn {
    flex-grow: 1;
    margin-right: var(--space-sm);
}

.end-summer__btn:last-child {
    margin-right: 0;
}

.end-summer__btn--pass {
    flex-grow: 1.3;
    color: rgb(224, 138, 74);
}
.crucible-slot__progress { font-size: 9px; }

.ring--red { border-color: rgb(192,57,43); }
.ring--blue { border-color: rgb(46,109,164); }
.ring--green { border-color: rgb(43,106,74); }
.ring--yellow { border-color: rgb(184,148,31); }
.slot-sel--red { border-color: rgb(229,115,115); }
.slot-sel--blue { border-color: rgb(111,168,212); }
.slot-sel--green { border-color: rgb(93,202,165); }
.slot-sel--yellow { border-color: rgb(224,192,96); }

.formula-card {
    background-color: rgb(22,10,28);
    border-width: 1px; border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 12px;
}
.formula-card__head { flex-direction: row; align-items: center; margin-bottom: 11px; }
.formula-card__ring {
    width: 34px; height: 34px; border-radius: 17px;
    background-color: rgb(28,18,8);
    border-width: 2px;
    align-items: center; justify-content: center;
    margin-right: 10px;
}
.formula-card__count { font-size: 15px; -unity-font-style: bold; }

.fslot-fill--red { background-color: rgb(192,57,43); }
.fslot-fill--blue { background-color: rgb(46,109,164); }
.fslot-fill--green { background-color: rgb(43,106,74); }
.fslot-fill--yellow { background-color: rgb(184,148,31); }

/* ---------- Summer main / hub: narrative toolbar ---------- */
.summer-main__toolbar,
.summer-hub__toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 0 var(--space-md);
    margin: var(--space-xs) var(--space-md) 0;
    min-height: 40px;
}

.summer-main__toolbar--hidden,
.summer-hub__toolbar--hidden {
    display: none;
}

.summer-main__toolbar .table-fab,
.summer-main__toolbar .effects-fab,
.summer-hub__toolbar .table-fab,
.summer-hub__toolbar .effects-fab {
    position: relative;
    top: auto;
    right: auto;
    flex-shrink: 0;
}

.summer-hub__toolbar {
    justify-content: space-between;
}

.summer-main__toolbar .narrative-beat {
    flex-grow: 1;
    flex-shrink: 1;
    -unity-text-align: middle-center;
    margin: 0 var(--space-sm);
    margin-bottom: 0;
}

.summer-main__actionbar {
    flex-shrink: 0;
    padding: 8px var(--space-md) 6px;
    margin: 0 var(--space-md);
    border-top-width: 1px;
    border-top-color: var(--border-gold);
}

.summer-main__actionbar .actionbar__row--primary > .actionbtn {
    min-height: var(--touch-min);
}

#summer-main-stage {
    min-height: 340px;
}

.summer-main__pass-block {
    padding-bottom: var(--space-xs);
}

.summer-main__charge {
    flex-shrink: 0;
    width: 100%;
    -unity-text-align: middle-center;
    margin: var(--space-sm) 0 0;
    padding: 0 var(--space-sm);
    color: var(--muted);
    font-size: var(--font-label);
    white-space: normal;
}

.summer-main__crucible-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin: 0 var(--space-md) var(--space-sm);
    padding: 0 var(--space-xs);
}

.crucible-activate {
    flex-shrink: 0;
    flex-grow: 0;
    min-height: var(--card-chip-h);
    margin-right: var(--space-sm);
}

.crucible-cards {
    flex-direction: row;
    flex-grow: 1;
    justify-content: space-around;
    align-items: center;
}

.crucible-card {
    width: var(--card-chip-w);
    height: var(--card-chip-h);
    flex-shrink: 0;
    flex-grow: 0;
    position: relative;
    align-items: center;
    justify-content: center;
    background-color: rgb(22, 10, 28);
    border-width: 1px;
    border-color: var(--gold-deep);
    border-radius: var(--radius-sm);
}

.crucible-card__token {
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
}

.crucible-card__token--red {
    background-image: url("project://database/Assets/_Project/Art/cauldrons/cauldron_red.png");
}

.crucible-card__token--blue {
    background-image: url("project://database/Assets/_Project/Art/cauldrons/cauldron_blue.png");
}

.crucible-card__token--green {
    background-image: url("project://database/Assets/_Project/Art/cauldrons/cauldron_green.png");
}

.crucible-card__token--yellow {
    background-image: url("project://database/Assets/_Project/Art/cauldrons/cauldron_yellow.png");
}

.summer-main__stakes {
    flex-shrink: 0;
    margin: 0 var(--space-md) var(--space-sm);
}

.summer-main__stakes .narrative-stakes-wrap {
    margin: 0;
}

/* ---------- Summer main: cauldron hub (state center) ---------- */
.cauldron-hub {
    align-items: center;
    justify-content: center;
    width: 320px;
    height: 320px;
    align-self: center;
    margin-top: 0;
    margin-bottom: 0;
    position: relative;
    flex-shrink: 0;
}

.cauldron-hub__mantle {
    position: absolute;
    left: 2%;
    right: 2%;
    top: 2%;
    bottom: 2%;
    background-image: url("project://database/Assets/_Project/Art/cauldrons/cauldronBG.png");
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.55;
}

.cauldron-stage {
    position: relative;
    width: 320px;
    height: 320px;
    align-items: center;
    justify-content: center;
}

.cauldron-hub .cauldron {
    width: 78px;
    height: 78px;
    border-radius: 39px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    padding-top: 2px;
    padding-bottom: 2px;
    overflow: hidden;
    background-color: rgba(12, 8, 10, 0.35);
    border-color: var(--border-gold);
}

.cauldron__art {
    position: absolute;
    left: 4px;
    right: 4px;
    top: 4px;
    bottom: 18px;
    -unity-background-scale-mode: scale-to-fit;
}

.cauldron-hub .cauldron--lit {
    border-width: 3px;
    border-color: var(--gold-bright);
    opacity: 1;
    background-color: rgba(12, 8, 10, 0.15);
}

.cauldron-hub .cauldron--dormant {
    border-width: 2px;
    border-color: rgba(192, 160, 96, 0.45);
    opacity: 0.85;
    border-style: dashed;
}

.cauldron-hub .cauldron--red {
    background-color: rgba(192, 57, 43, 0.9);
}

.cauldron-hub .cauldron--blue {
    background-color: rgba(46, 109, 164, 0.9);
}

.cauldron-hub .cauldron--green {
    background-color: rgba(43, 106, 74, 0.9);
}

.cauldron-hub .cauldron--yellow {
    background-color: rgba(184, 148, 31, 0.9);
}

.cauldron-hub .cauldron--tappable {
    picking-mode: position;
}

.cauldron-hub .cauldron--tappable:active {
    scale: 0.96 0.96;
}

.cauldron-hub .codex-hub--tappable {
    picking-mode: position;
}

.cauldron-hub .codex-hub--tappable:active {
    scale: 0.96 0.96;
}

.cauldron-hub #cauldron-n { top: 10px; left: 10px; right: auto; bottom: auto; }

.cauldron-hub #cauldron-e { top: 10px; right: 10px; left: auto; bottom: auto; }

.cauldron-hub #cauldron-s { bottom: 10px; left: 10px; top: auto; right: auto; }

.cauldron-hub #cauldron-w { bottom: 10px; right: 10px; top: auto; left: auto; }

.cauldron__color {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 1px;
}

.cauldron__progress {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(243, 233, 210);
    margin-bottom: 1px;
}

.cauldron__req {
    font-size: 9px;
    color: rgb(243, 233, 210);
    margin-bottom: 1px;
}

.cauldron__reagent {
    font-size: 8px;
    color: rgb(243, 233, 210);
    margin-bottom: 1px;
}

.cauldron__state {
    font-size: 8px;
    color: rgb(184, 154, 110);
}

.cauldron--dormant .cauldron__reagent {
    display: none;
}

.cauldron--dormant .cauldron__state {
    display: none;
}

.cauldron--dormant .cauldron__art {
    display: none;
}

.cauldron--lit .cauldron__color {
    display: none;
}

.cauldron--lit .cauldron__progress {
    display: none;
}

.cauldron--lit .cauldron__req {
    display: none;
}

.cauldron--lit .cauldron__state {
    color: var(--gold-bright);
}

.codex-hub {
    position: absolute;
    width: 76px;
    height: 76px;
    border-radius: 38px;
    top: 122px;
    left: 122px;
    background-color: rgb(22, 10, 28);
    border-width: 2px;
    border-color: var(--gold-bright);
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    padding: 4px 2px;
}

.codex-hub__title {
    width: 100%;
    font-size: 8px;
    color: var(--muted);
    letter-spacing: 0.5px;
    margin-bottom: 2px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.codex-hub__count {
    width: 100%;
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--ink);
    margin-bottom: 2px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.codex-hub__status {
    width: 100%;
    font-size: 7px;
    color: var(--gold-bright);
    -unity-text-align: middle-center;
    white-space: nowrap;
}
