/* Kismeta — AgeCeremony.uss
   Ceremony typography and sigil styling inside menu-screen panels. */

.ceremony-phase {
    width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
}

.ceremony-eyebrow {
    font-size: 10px;
    letter-spacing: 4px;
    color: rgb(184, 154, 186);
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.ceremony-sigil {
    align-items: center;
    justify-content: center;
    border-color: var(--gold-deep);
}

.ceremony-sigil--open {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    background-color: rgba(74, 20, 16, 0.75);
    border-width: 3px;
    margin-bottom: 12px;
}

.ceremony-sigil--close {
    width: 78px;
    height: 78px;
    border-radius: 39px;
    background-color: rgba(36, 16, 16, 0.75);
    border-width: 2px;
    border-color: rgb(192, 160, 96);
    margin-bottom: 10px;
    opacity: 0.85;
}

.ceremony-sigil__glyph {
    font-size: 48px;
    color: rgb(240, 192, 176);
    -unity-font-style: normal;
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/Amarante-Regular.asset");
}

.ceremony-sigil--close .ceremony-sigil__glyph {
    font-size: 38px;
    color: rgb(176, 136, 104);
}

.ceremony-prelabel {
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.ceremony-prelabel--after {
    margin-top: 4px;
}

.ceremony-agename {
    font-size: 36px;
    color: var(--gold);
    letter-spacing: 2px;
    margin-top: 2px;
    -unity-font-style: normal;
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/Amarante-Regular.asset");
    -unity-text-align: middle-center;
}

.ceremony-agename--close {
    font-size: 30px;
    color: rgb(201, 168, 74);
}

.ceremony-couplet {
    font-size: 10px;
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/Amarante-Regular.asset");
    -unity-font-style: normal;
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 260px;
    margin-top: 10px;
    color: rgb(184, 168, 172);
}

.ceremony-aspects {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
}

.ceremony-aspect {
    font-size: 11px;
    border-width: 1px;
    border-radius: var(--radius-sm);
    padding: 3px 10px;
    margin-right: 8px;
}

.ceremony-aspect:last-child { margin-right: 0; }

.ceremony-aspect--planet {
    color: rgb(240, 153, 123);
    background-color: rgba(42, 21, 16, 0.9);
    border-color: rgb(106, 58, 42);
}

.ceremony-aspect--element {
    color: rgb(127, 196, 168);
    background-color: rgba(22, 38, 31, 0.9);
    border-color: rgb(43, 106, 74);
}

.ceremony-die {
    width: 88px;
    height: 88px;
    border-radius: 14px;
    background-color: rgb(36, 20, 52);
    border-width: 2px;
    border-color: rgb(106, 74, 138);
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}

.ceremony-die__face {
    font-size: 40px;
    color: rgb(205, 176, 224);
}

.ceremony-reveal-body {
    width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
}

.ceremony-panel-wrap {
    padding: 8px 16px 0;
}

.ceremony-panel-wrap--callout {
    padding-bottom: 8px;
    flex-grow: 1;
    justify-content: flex-end;
}

.ceremony-wager-panel {
    flex-direction: row;
    align-items: center;
    background-color: rgb(36, 16, 40);
    border-color: rgb(106, 74, 138);
}

.ceremony-wager-panel__icon {
    color: rgb(205, 176, 224);
    margin-right: 9px;
}

.ceremony-wager-panel__text {
    flex-grow: 1;
    font-size: 11px;
    color: rgb(184, 154, 192);
    white-space: normal;
}

.ceremony-effect-panel {
    flex-direction: row;
    align-items: flex-start;
    background-color: rgb(22, 16, 40);
    border-color: rgb(58, 42, 90);
}

.ceremony-effect-panel__icon-wrap {
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background-color: rgb(36, 16, 56);
    border-width: 1px;
    border-color: rgb(106, 74, 138);
    align-items: center;
    justify-content: center;
    margin-right: 11px;
}

.ceremony-effect-panel__icon-wrap .ti-icon {
    color: rgb(205, 176, 224);
}

.ceremony-effect-panel__body {
    flex-grow: 1;
}

.ceremony-effect-panel__eyebrow {
    color: rgb(138, 106, 170);
    margin-bottom: 1px;
}

.ceremony-effect-panel__title {
    font-size: 13px;
    color: rgb(243, 233, 210);
}

.ceremony-effect-panel__desc {
    font-size: 10px;
    color: rgb(154, 138, 172);
    white-space: normal;
}

.ceremony-callout__text {
    color: rgb(168, 176, 216);
}

/* Age Opening: group the callout + CTA directly under the cosmic effect panel
   instead of pushing them to the bottom of the screen. */
#age-open .ceremony-reveal-body {
    flex-grow: 0;
}

#age-open .ceremony-panel-wrap--callout {
    flex-grow: 0;
    justify-content: flex-start;
}
