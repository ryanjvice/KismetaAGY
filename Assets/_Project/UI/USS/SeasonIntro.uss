/* Kismeta — SeasonIntro.uss
   Shared styling for the 4 season-intro screens. The season's hue is applied
   by adding a modifier class to the root: .intro--spring/summer/autumn/winter.
   NATIVE NOTE: the radial header glow + drifting motes (seeds/sun/leaves/snow)
   were SVG. In Unity use a background sprite per season on .intro-hero, and an
   optional particle overlay for the motes. */

.intro-hero {
    padding: 24px 18px 16px;
    align-items: center;
    position: relative;
    overflow: hidden;
    background-image: url("project://database/Assets/_Project/Art/UI/tableFelt_vignette.png");
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgba(19, 37, 26, 0.85);
}

.intro--spring .intro-hero { background-color: rgba(26, 58, 36, 0.82); }
.intro--summer .intro-hero { background-color: rgba(74, 46, 10, 0.82); }
.intro--autumn .intro-hero { background-color: rgba(74, 22, 10, 0.82); }
.intro--winter .intro-hero { background-color: rgba(26, 48, 72, 0.82); }

.intro-sigil {
    width: 60px;
    height: 60px;
    border-radius: 30px;
    border-width: 2px;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    overflow: hidden;
    background-color: rgba(16, 8, 12, 0.65);
}
.intro--spring .intro-sigil { border-color: var(--spring-accent); }
.intro--summer .intro-sigil { border-color: var(--summer-accent); }
.intro--autumn .intro-sigil { border-color: var(--autumn-accent); }
.intro--winter .intro-sigil { border-color: var(--winter-accent); }

.intro-sigil__art {
    width: 46px;
    height: 46px;
    background-image: url("project://database/Assets/_Project/Art/GameSplash/crucibleForge.png");
    -unity-background-scale-mode: scale-to-fit;
}

.intro-name {
    font-size: 26px;
    letter-spacing: 4px;
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/Amarante-Regular.asset");
}
.intro--spring .intro-name { color: var(--spring-accent); }
.intro--summer .intro-name { color: var(--summer-accent); }
.intro--autumn .intro-name { color: var(--autumn-accent); }
.intro--winter .intro-name { color: var(--winter-accent); }

.intro-tagline {
    font-size: 10px;
    letter-spacing: 3px;
    margin-top: 7px;
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/GermaniaOne-Regular.asset");
}
.intro--spring .intro-tagline { color: rgb(90, 154, 111); }
.intro--summer .intro-tagline { color: rgb(184, 122, 58); }
.intro--autumn .intro-tagline { color: rgb(176, 90, 42); }
.intro--winter .intro-tagline { color: rgb(111, 154, 196); }

.intro-couplet {
    font-size: 10px;
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/Amarante-Regular.asset");
    -unity-font-style: normal;
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 250px;
    margin-top: 13px;
    color: rgb(184, 168, 146);
}

.intro-agestrip {
    flex-direction: row;
    align-items: center;
    padding: 12px 16px;
    border-top-width: 2px;
    border-top-color: var(--border-gold);
    border-bottom-width: 2px;
    border-bottom-color: var(--border-gold);
    background-color: rgba(16, 10, 18, 0.75);
}

.intro-agestrip__sigil {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    border-width: 2px;
    border-color: var(--gold-deep);
    align-items: center;
    justify-content: center;
    margin-right: 10px;
    background-color: rgba(28, 18, 8, 0.8);
}

.intro-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 7px;
}
.intro-row__num {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    border-width: 1px;
    align-items: center;
    justify-content: center;
    margin-right: 9px;
}

.intro-row__label {
    font-size: 12px;
    color: var(--ink);
}

.intro-steps-wrap {
    padding: 10px 16px 4px;
}

.intro-steps-eyebrow {
    color: var(--muted-dim);
}

.intro-cta-wrap {
    padding: 12px 16px 24px;
}

.intro-cta {
    font-size: 14px;
    padding: 12px 16px 24px;
}

.intro-tip {
    margin-left: var(--space-md);
    margin-right: var(--space-md);
}

.screen.intro--spring,
.screen.intro--summer,
.screen.intro--autumn,
.screen.intro--winter {
    background-color: transparent;
}
