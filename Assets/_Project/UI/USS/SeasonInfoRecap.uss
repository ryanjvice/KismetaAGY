/* Kismeta — SeasonInfoRecap.uss
   Tabbed season info overlay (Overview + Focus). */

.season-info-recap {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.season-info-recap__hero {
    flex-shrink: 0;
    flex-direction: column;
    align-items: stretch;
    margin: 8px 12px 4px;
    padding: 8px 10px;
}

.season-info-recap__hero-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
}

.season-info-recap__sigil {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    margin-bottom: 0;
    margin-right: 10px;
    flex-shrink: 0;
}

.season-info-recap__emoji {
    font-size: 20px;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.season-info-recap__overview-btn {
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    padding: 0;
    margin-left: 8px;
    flex-shrink: 0;
    border-radius: 18px;
    border-width: 1px;
    border-color: var(--gold-deep);
    background-color: rgba(16, 8, 12, 0.65);
    align-items: center;
    justify-content: center;
}

.season-info-recap__overview-art {
    width: 28px;
    height: 28px;
}

.season-info-recap__hero-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
}

.season-info-recap .season-info-recap__name {
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-align: upper-left;
    margin: 0;
    padding: 0;
}

.season-info-recap .season-info-recap__tagline {
    font-size: var(--font-micro);
    letter-spacing: 1px;
    margin-top: 2px;
    -unity-text-align: upper-left;
    white-space: normal;
}

.season-info-recap__tabs {
    flex-shrink: 0;
    margin-top: 0;
    margin-bottom: 8px;
    padding: 6px 16px 4px;
    picking-mode: position;
}

.season-info-recap__tab {
    position: relative;
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-min);
    picking-mode: position;
}

.season-info-recap__tab-label {
    -unity-text-align: middle-center;
    color: var(--muted);
    picking-mode: ignore;
}

.season-info-recap__tab.codex-tab--active .season-info-recap__tab-label {
    color: var(--ink);
}

.season-info-recap__tab-hit {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.season-info-recap__body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin: 0 12px;
}

.season-info-recap__body .unity-scroll-view__content-container {
    width: 100%;
    align-items: stretch;
}

.season-info-recap__pane {
    flex-direction: column;
    width: 100%;
    align-self: stretch;
    padding-bottom: 8px;
}

.season-info-recap__focus-block {
    flex-shrink: 0;
    width: 100%;
    align-self: stretch;
    margin-bottom: 8px;
}

.season-info-recap__focus-block:last-child {
    margin-bottom: 0;
}

.season-info-recap__pane--hidden {
    display: none;
}

.season-info-recap__overview-host {
    flex-direction: column;
    width: 100%;
}

.season-info-recap__overview-host .ceremony-reveal-body {
    margin-top: 0;
}

.season-info-recap__focus-tip {
    white-space: normal;
    -unity-text-align: upper-left;
}

.season-info-recap__season-note {
    flex-shrink: 0;
    font-size: var(--font-label);
    color: var(--muted);
    margin: 0 16px 8px;
    padding: 0 4px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.season-info-recap__step-list {
    flex-direction: column;
    width: 100%;
}

.season-info-recap__step-list .intro-row {
    margin-bottom: 6px;
}

.season-info-recap__step-list .text-muted {
    margin-top: 2px;
}

.season-info-recap__clone-hidden {
    display: none;
}

.season-info-recap--ceremony {
    flex-grow: 1;
}

.season-info-recap--ceremony .menu-screen__footer {
    flex-shrink: 0;
    padding-top: 12px;
    padding-bottom: 20px;
}

.season-info-recap__overview-host .season-intro-overview {
    margin-top: 0;
}

.season-info-recap__overview-host .ceremony-panel-wrap {
    padding-left: 0;
    padding-right: 0;
}

.season-info-recap .menu-screen__footer {
    flex-shrink: 0;
}
