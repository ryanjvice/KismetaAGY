/* Kismeta — AutumnActions.uss
   Shared styling for Fire, Temper, Manage cards, Leave Stasis (#30-32, 34-36).
   Reuses Kismeta.uss + SummerActions stepper. */

/* modal chrome (Fire / Temper / Leave Stasis are modals) */
.modal {
    width: 92%;
    max-width: 520px;
    max-height: 88%;
    border-radius: var(--radius-xl);
    border-width: 1px;
    overflow: hidden;
    flex-shrink: 1;
}
.modal--fire   { background-color: rgb(22,16,12); border-color: rgb(106,58,26); }
.modal--temper { background-color: rgb(18,12,20); border-color: rgb(106,80,32); }
.modal--stasis { background-color: rgb(14,14,26); border-color: rgb(43,74,106); }
.modal__header {
    flex-direction: row; align-items: center;
    padding: 12px 14px;
    border-bottom-width: 1px;
}

/* forge position track (Fire) — small numbered nodes left-to-right */
.track {
    flex-direction: row; align-items: center; justify-content: center;
    margin-bottom: 14px;
}
.track-node {
    width: 38px; height: 38px; border-radius: 19px;
    align-items: center; justify-content: center;
    -unity-font-style: bold;
}
.track-node--now { background-color: rgb(207,207,207); border-width: 2px; border-color: white; color: rgb(58,58,58); }
.track-node--target { background-color: rgb(42,24,16); border-width: 2px; border-color: var(--gold-deep); color: var(--gold); }
.track-node--future { background-color: var(--gold-deep); border-width: 2px; border-color: var(--gold-bright); color: rgb(90,60,10); }
.track-arrow { width: 40px; align-items: center; }
.track-conn { width: 54px; height: 3px; border-radius: 2px; background-color: rgb(90,40,24); }

/* stage track (Temper) — Lead→Bronze→Silver→Gold→Altar */
.stage-track { flex-direction: row; align-items: center; justify-content: center; margin-bottom: 14px; }
.stage-node {
    width: 24px; height: 24px; border-radius: 12px;
    align-items: center; justify-content: center;
    font-size: 9px; -unity-font-style: bold;
}
.stage-node--now { width: 30px; height: 30px; border-radius: 15px; border-width: 2px; }
.stage-node--altar { width: 34px; height: 34px; border-radius: 17px; border-width: 2px; border-color: var(--gold-bright); }
.stage-conn { width: 8px; height: 1px; background-color: rgb(74,58,42); margin: 0 1px; }
.stage-label { font-size: 7px; color: var(--muted); margin-top: 2px; }

/* escape option card (Leave Stasis) */
.escape {
    border-radius: var(--radius-md);
    border-width: 1px;
    padding: 11px 12px;
    margin-bottom: 9px;
}
.escape--live { background-color: rgb(19,32,26); border-width: 2px; border-color: var(--ok-border); }
.escape--inactive { background-color: var(--panel-darker); border-color: var(--border-subtle); opacity: 0.92; }
.escape__head { flex-direction: row; align-items: center; margin-bottom: 8px; }
.escape__badge {
    border-radius: var(--radius-sm);
    border-width: 1px;
    padding: 3px 7px;
    font-size: 10px;
}

/* crucible-card state pills (Manage cards) */
.crucible-pill {
    flex-grow: 1;
    border-radius: var(--radius-md);
    border-width: 1px;
    padding: 8px 4px;
    align-items: center;
    margin-right: 7px;
}
.crucible-pill:last-child { margin-right: 0; }
.crucible-pill--forged { background-color: var(--ok-bg); border-color: var(--ok-border); }
.crucible-pill--ready { background-color: rgb(42,31,14); border-width: 2px; border-color: var(--gold-deep); }
.crucible-pill--active { background-color: var(--panel-darker); border-color: var(--border-subtle); }
.crucible-pill--dormant { background-color: var(--panel-darker); border-color: var(--border-subtle); opacity: 0.6; }

/* ---------- Pass your turn (End Autumn) ---------- */
.end-pass__heading {
    flex-shrink: 1;
    min-width: 0;
    flex-grow: 1;
}

.end-autumn__header .end-pass__heading .statusbar__sub {
    white-space: normal;
    flex-shrink: 1;
}

.end-autumn__title {
    color: var(--autumn-accent);
}

.end-autumn__close {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--muted);
    font-size: 18px;
    min-width: var(--touch-min);
    min-height: var(--touch-min);
}

.end-autumn__section {
    margin-bottom: var(--space-md);
}

.end-autumn__eyebrow {
    font-size: var(--font-label);
    color: var(--muted);
    letter-spacing: 1px;
    margin-bottom: var(--space-sm);
}

.end-autumn__recap-list {
    flex-direction: column;
}

.end-autumn__recap-row {
    flex-direction: row;
    align-items: center;
    background-color: var(--panel-darker);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 9px 11px;
    margin-bottom: 6px;
}

.end-autumn__hints {
    flex-direction: column;
    align-items: stretch;
    margin: 0;
}

.end-autumn__hint-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 7px;
}

.end-autumn__hint-row:last-child {
    margin-bottom: 0;
}

.end-autumn__line {
    font-size: var(--font-body);
    color: var(--ink);
    white-space: normal;
    flex-shrink: 1;
}

.end-autumn__hints .end-autumn__line {
    color: var(--caution-text);
}

.end-autumn__footnote {
    font-size: var(--font-label);
    color: var(--muted);
    -unity-text-align: middle-center;
    margin-top: var(--space-sm);
    white-space: normal;
}

.end-autumn__actions {
    flex-direction: row;
    margin-top: var(--space-xs);
}

.end-autumn__btn {
    flex-grow: 1;
    margin-right: var(--space-sm);
}

.end-autumn__btn:last-child {
    margin-right: 0;
}

.end-autumn__btn--pass {
    flex-grow: 1.3;
    color: var(--autumn-accent);
}

/* ---------- Autumn main / hub: narrative toolbar ---------- */
.autumn-main__toolbar,
.autumn-hub__toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 0 var(--space-md);
    margin: 2px var(--space-md) 0;
    min-height: 28px;
}

.autumn-main__toolbar--hidden,
.autumn-hub__toolbar--hidden {
    display: none;
}

.autumn-main__toolbar .table-fab,
.autumn-main__toolbar .effects-fab,
.autumn-hub__toolbar .table-fab,
.autumn-hub__toolbar .effects-fab {
    position: relative;
    top: auto;
    right: auto;
    flex-shrink: 0;
}

.autumn-hub__toolbar {
    justify-content: space-between;
}

.autumn-main__toolbar .narrative-beat {
    flex-grow: 1;
    flex-shrink: 1;
    -unity-text-align: middle-center;
    margin: 0 var(--space-sm);
    margin-bottom: 0;
}

.autumn-main__actionbar {
    flex-shrink: 0;
    padding: 6px var(--space-md) 4px;
    margin: 0 var(--space-md);
    border-top-width: 1px;
    border-top-color: var(--border-gold);
}

.autumn-main__actionbar .actionbar__row--primary > .actionbtn {
    min-height: var(--touch-min);
    line-height: 13px;
}

.autumn-main__stakes {
    flex-shrink: 0;
    margin: 0 var(--space-md) 4px;
}

.autumn-main__stakes .narrative-stakes-wrap {
    flex-direction: column;
    align-items: stretch;
    margin: 0;
}

.autumn-main__stakes .narrative-stakes {
    -unity-text-align: middle-center;
}

.autumn-main__charge {
    flex-shrink: 0;
    width: 100%;
    -unity-text-align: middle-center;
    margin: 4px 0 0;
    padding: 0;
    color: var(--muted);
    font-size: var(--font-label);
    white-space: normal;
}

.screen--autumn .central-panel {
    flex-grow: 0;
    flex-shrink: 0;
}

.screen--autumn .screen__body--inventory-pad > .central-panel {
    padding-bottom: 0;
}

.screen--autumn .central-panel > .stage {
    min-height: auto;
    flex-shrink: 0;
}

.autumn-main__forge-heading {
    flex-shrink: 0;
    margin: 0 var(--space-md);
}

.autumn-main__crucible-section {
    flex-shrink: 0;
    flex-direction: column;
    align-items: stretch;
    margin: var(--space-sm) var(--space-md) var(--space-md);
}

.autumn-main__crucible-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.screen--autumn .stage-cta {
    padding-top: 4px;
    padding-left: 14px;
    padding-right: 14px;
    margin-top: var(--space-sm);
}

.screen--autumn .forge-panel {
    flex-shrink: 0;
}

/* Autumn main/hub — crucible forge mandala + stone markers + cauldron mini */
.forge-panel {
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
}

.forge-panel__narrative {
    width: 100%;
    max-width: 320px;
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.forge-panel__narrative .narrative-beat,
.forge-panel__narrative .narrative-charge {
    -unity-text-align: middle-center;
}

.forge-panel__hint {
    font-size: 11px;
    color: rgb(243, 233, 210);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 4px;
}

.forge-panel__status {
    font-size: 9px;
    color: var(--autumn-accent);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 8px;
}

.forge-stage {
    align-items: center;
    justify-content: center;
    position: relative;
    width: 280px;
    height: 280px;
    flex-shrink: 0;
}

.forge-mandala {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("project://database/Assets/_Project/Art/crucible/crucibleForge.png");
    -unity-background-scale-mode: scale-to-fit;
}

.forge-pos {
    position: absolute;
    translate: -17px -17px;
}

.forge-pos--0 { left: 14%; top: 14%; }
.forge-pos--1 { left: 22%; top: 50%; translate: -19px -19px; }
.forge-pos--2 { left: 14%; top: 86%; }
.forge-pos--3 { left: 50%; top: 78%; translate: -19px -19px; }
.forge-pos--4 { left: 86%; top: 86%; }
.forge-pos--5 { left: 78%; top: 50%; translate: -19px -19px; }
.forge-pos--6 { left: 86%; top: 14%; }
.forge-pos--7 { left: 50%; top: 22%; translate: -19px -19px; }
.forge-pos--altar {
    left: 50%;
    top: 50%;
    translate: -26px -26px;
}

.stone-marker {
    width: 34px;
    height: 34px;
    -unity-background-scale-mode: scale-to-fit;
}

.stone-marker--inner {
    width: 38px;
    height: 38px;
}

.stone-marker.forge-pos--altar {
    width: 52px;
    height: 52px;
    display: none;
}

.player-stones {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.player-stone {
    position: absolute;
    width: 28px;
    height: 28px;
    -unity-background-scale-mode: scale-to-fit;
    translate: -14px -14px;
}

.player-stone.forge-pos--1,
.player-stone.forge-pos--3,
.player-stone.forge-pos--5,
.player-stone.forge-pos--7 {
    translate: -14px -14px;
}

.player-stone.forge-pos--altar {
    width: 36px;
    height: 36px;
    translate: -18px -18px;
}

.player-stone--stack-0 { margin-left: -6px; margin-top: -6px; }
.player-stone--stack-1 { margin-left: 6px; margin-top: -6px; }
.player-stone--stack-2 { margin-left: -6px; margin-top: 6px; }
.player-stone--stack-3 { margin-left: 6px; margin-top: 6px; }

.player-stone--local {
    border-width: 2px;
    border-color: var(--gold-bright);
    border-radius: 50%;
    scale: 1.1 1.1;
}

.forge-bottom-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    align-self: center;
    width: 100%;
    margin-top: 4px;
    margin-bottom: 8px;
}

.forge-bottom-row > .stasis-slot,
.forge-bottom-row > .cauldron-mini {
    margin-left: 6px;
    margin-right: 6px;
    flex-shrink: 0;
}

.stasis-slot {
    width: 52px;
    height: 52px;
    align-items: center;
    justify-content: center;
    background-image: url("project://database/Assets/_Project/Art/crucible/stasis_zone.png");
    -unity-background-scale-mode: scale-to-fit;
}

.stasis-slot__stone {
    width: 28px;
    height: 28px;
    -unity-background-scale-mode: scale-to-fit;
    display: none;
}

.stasis-slot--occupied .stasis-slot__stone {
    display: flex;
}

.stasis-slot--local {
    border-width: 2px;
    border-color: rgb(90, 200, 120);
    border-radius: 8px;
}

.cauldron-mini {
    position: relative;
    width: 88px;
    height: 88px;
    background-image: url("project://database/Assets/_Project/Art/cauldrons/cauldronBG.png");
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.cauldron-mini__reagent {
    position: absolute;
    width: 38px;
    height: 38px;
    -unity-background-scale-mode: scale-to-fit;
    display: none;
}

.cauldron-mini__reagent--lit {
    display: flex;
}

.cauldron-mini__reagent--wands {
    left: 14%;
    top: 14%;
}

.cauldron-mini__reagent--cups {
    right: 14%;
    top: 14%;
}

.cauldron-mini__reagent--pentacles {
    left: 14%;
    bottom: 14%;
}

.cauldron-mini__reagent--swords {
    right: 14%;
    bottom: 14%;
}

/* Info button (replaces the always-visible stakes block) */
.autumn-info-btn {
    min-width: 28px;
    min-height: 28px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(184, 154, 110);
    font-size: 18px;
    padding: 0 4px;
    flex-shrink: 0;
}

.autumn-info-btn:hover {
    color: rgb(232, 185, 74);
}

.screen--yielded .forge-panel {
    opacity: 0.94;
}
.screen--yielded .yielded-banner {
    color: rgb(196, 118, 64);
}
