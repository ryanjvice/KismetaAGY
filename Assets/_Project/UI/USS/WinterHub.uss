/* Kismeta — WinterHub.uss */

.winter-hub__stage {
    align-items: stretch;
    justify-content: flex-start;
    padding: 8px 0 0;
}

.winter-hub__narrative {
    flex-shrink: 0;
}

.winter-hub__toolbar {
    flex-shrink: 0;
    flex-direction: column;
    align-items: stretch;
    padding: 0 var(--space-md);
    margin: var(--space-xs) var(--space-md) 0;
    min-height: 40px;
}

.winter-hub__toolbar .narrative-toolbar {
    margin: 0;
    padding: 0;
    width: 100%;
}

.winter-hub__toolbar--hidden {
    display: none;
}

.winter-hub__unlock {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
    overflow: hidden;
}

.winter-hub__unlock--hidden {
    display: none;
}
