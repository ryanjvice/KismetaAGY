/* Kismeta — WinterHub.uss */

.winter-hub__stage {
    align-items: stretch;
    justify-content: flex-start;
    padding: 8px 0 0;
}

.winter-hub__narrative {
    flex-shrink: 0;
}

.winter-hub__unlock {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
    overflow: hidden;
}

.winter-hub__unlock--hidden {
    display: none;
}
