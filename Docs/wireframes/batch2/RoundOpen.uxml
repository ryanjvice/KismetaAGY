<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../USS/Kismeta.uss" />
    <engine:Style src="../USS/AgeCeremony.uss" />

    <!-- ============================================================
         ROUND-OPEN (#7) — the Agekeeper casts the Cosmic Age die. This is
         the action that precedes the AgeOpening reveal.
         NATIVE NOTE: the die tumble was an animated SVG (12 frames @ 70ms).
         In Unity animate #age-die: swap a face sprite each frame via a
         coroutine, OR rotate a 3D die and read the settled face. After it
         settles, transition to AgeOpening.uxml with the rolled age.
         Also resolves the pending Fateful Wager here (#9) before the reveal.
         ============================================================ -->
    <engine:VisualElement name="round-open" class="screen ceremony" style="background-color: rgb(10,8,16);">

        <engine:VisualElement class="ceremony-hero ceremony-hero--open" style="padding-bottom: 22px;">
            <engine:Label name="keeper-eyebrow" text="Iolanthe casts the age" class="ceremony-eyebrow" />

            <!-- die host: animate in C# -->
            <engine:VisualElement name="age-die" style="width: 88px; height: 88px; border-radius: var(--radius-lg); background-color: rgb(36,20,52); border-width: 2px; border-color: var(--arcanum-border); align-items: center; justify-content: center; margin-bottom: 14px;">
                <engine:Label name="die-face" text="?" style="font-size: 40px; color: var(--arcanum-text);" />
            </engine:VisualElement>

            <engine:Label text="the cosmic age die" class="ceremony-prelabel" />
            <engine:Label text="one of twelve signs will rule the coming age" class="ceremony-couplet" style="margin-top: 8px;" />
        </engine:VisualElement>

        <!-- pending wager (shown only if one is staked; hidden by C# otherwise) -->
        <engine:VisualElement name="pending-wager" style="padding: 14px 16px 4px;">
            <engine:Label text="a wager awaits the cast" class="eyebrow" />
            <engine:VisualElement class="panel" style="flex-direction: row; align-items: center; background-color: var(--arcanum-bg); border-color: var(--arcanum-border);">
                <engine:Label text="&#xeb6c;" class="ti-icon" style="color: var(--arcanum-text); margin-right: 9px;" />
                <engine:Label name="wager-line" text="You staked 3 cards on Pisces last Winter — it resolves the instant the die lands."
                              style="flex-grow: 1; font-size: 11px; color: rgb(184,154,192); white-space: normal;" />
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement class="intro-cta" style="margin-top: 10px;">
            <engine:Button name="roll-btn" text="Cast the age die" class="btn btn--primary" style="font-size: 14px;" />
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
