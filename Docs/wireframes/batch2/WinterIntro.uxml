<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../USS/Kismeta.uss" />
    <engine:Style src="../USS/SeasonIntro.uss" />

    <engine:VisualElement name="winter-intro" class="screen intro--winter" style="background-color: rgb(14,20,32);">

        <engine:VisualElement class="intro-hero">
            <engine:VisualElement class="intro-sigil">
                <engine:Label text="&#10052;" style="font-size: 28px; color: var(--winter-accent);" />
            </engine:VisualElement>
            <engine:Label text="WINTER" class="intro-name" />
            <engine:Label text="THE LONG NIGHT · CLOSE THE AGE" class="intro-tagline" />
            <engine:Label text="The forge fires bank low. What was gained is reckoned, what was held is loosed, and the wheel turns toward a new age."
                          class="intro-couplet" style="color: rgb(138,154,172);" />
        </engine:VisualElement>

        <engine:VisualElement class="intro-agestrip">
            <engine:VisualElement class="intro-agestrip__sigil">
                <engine:Label text="&#xec3a;" class="ti-icon" style="color: var(--gold);" />
            </engine:VisualElement>
            <engine:VisualElement>
                <engine:Label text="the age of Scorpio ends" class="eyebrow" style="margin-bottom: 0;" />
                <engine:Label text="mars · water — a strong age for your forging run" style="font-size: 12px; color: rgb(154,138,122);" />
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement style="padding: 10px 16px 4px;">
            <engine:Label text="four steps to close the age" class="eyebrow" />
            <engine:VisualElement name="intro-steps">
                <engine:VisualElement class="intro-row">
                    <engine:VisualElement class="intro-row__num" style="background-color: rgb(22,32,42); border-color: rgb(43,74,106);"><engine:Label text="1" style="font-size: 10px; color: var(--winter-accent); -unity-font-style: bold;" /></engine:VisualElement>
                    <engine:Label text="Unlock cards" style="font-size: 12px; color: var(--ink);" />
                </engine:VisualElement>
                <engine:VisualElement class="intro-row">
                    <engine:VisualElement class="intro-row__num" style="background-color: var(--arcanum-bg); border-color: var(--arcanum-border);"><engine:Label text="2" style="font-size: 10px; color: var(--arcanum-text); -unity-font-style: bold;" /></engine:VisualElement>
                    <engine:Label text="Fateful Wager" style="font-size: 12px; color: var(--ink);" />
                </engine:VisualElement>
                <engine:VisualElement class="intro-row">
                    <engine:VisualElement class="intro-row__num" style="background-color: var(--ok-bg); border-color: var(--ok-border);"><engine:Label text="3" style="font-size: 10px; color: var(--ok-text); -unity-font-style: bold;" /></engine:VisualElement>
                    <engine:Label text="Card limits" style="font-size: 12px; color: var(--ink);" />
                </engine:VisualElement>
                <engine:VisualElement class="intro-row">
                    <engine:VisualElement class="intro-row__num" style="background-color: rgb(58,46,14); border-color: var(--gold-deep);"><engine:Label text="4" style="font-size: 10px; color: var(--gold); -unity-font-style: bold;" /></engine:VisualElement>
                    <engine:Label text="Transit the age" style="font-size: 12px; color: var(--ink);" />
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement class="intro-tip tip--ok">
            <engine:Label text="Only your cards reset. Lit cauldrons, astral houses, active crucible cards and your stone's forge position all carry into the next age."
                          class="tip__text" style="color: rgb(159,196,180);" />
        </engine:VisualElement>

        <engine:VisualElement class="intro-cta">
            <engine:Button name="begin-btn" text="Begin Winter" class="btn"
                           style="background-color: rgb(22,32,42); border-color: rgb(43,74,106); color: var(--winter-accent);" />
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
