<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../USS/Kismeta.uss" />
    <engine:Style src="../USS/SeasonIntro.uss" />

    <engine:VisualElement name="spring-intro" class="screen intro--spring" style="background-color: rgb(15,20,16);">

        <engine:VisualElement class="intro-hero">
            <engine:VisualElement class="intro-sigil">
                <engine:Label text="&#xeb2f;" class="ti-icon" style="font-size: 28px; color: var(--spring-accent);" />
            </engine:VisualElement>
            <engine:Label text="SPRING" class="intro-name" />
            <engine:Label text="THE WHEEL TURNS · SET THE AGE" class="intro-tagline" />
            <engine:Label text="A new age dawns over Kismeta. The stars take their stations, and the alchemists gather their fortune."
                          class="intro-couplet" />
        </engine:VisualElement>

        <engine:VisualElement class="intro-agestrip">
            <engine:VisualElement class="intro-agestrip__sigil">
                <engine:Label text="&#xea6c;" class="ti-icon" style="color: var(--gold);" />
            </engine:VisualElement>
            <engine:VisualElement>
                <engine:Label text="a new age is cast" class="eyebrow" style="margin-bottom: 0;" />
                <engine:Label text="the Agekeeper rolls to set the cosmic age for all" style="font-size: 12px; color: rgb(154,172,146);" />
            </engine:VisualElement>
        </engine:VisualElement>

        <!-- preview: 5 steps -->
        <engine:VisualElement style="padding: 10px 16px 4px;">
            <engine:Label text="five steps to open the round" class="eyebrow" style="color: rgb(106,138,114);" />
            <engine:VisualElement name="intro-steps">
                <engine:VisualElement class="intro-row">
                    <engine:VisualElement class="intro-row__num" style="background-color: rgb(58,46,14); border-color: var(--gold-deep);"><engine:Label text="1" style="font-size: 10px; color: var(--gold); -unity-font-style: bold;" /></engine:VisualElement>
                    <engine:Label text="Set the Cosmic Age" style="font-size: 12px; color: var(--ink);" />
                </engine:VisualElement>
                <engine:VisualElement class="intro-row">
                    <engine:VisualElement class="intro-row__num" style="background-color: var(--ok-bg); border-color: var(--ok-border);"><engine:Label text="2" style="font-size: 10px; color: var(--ok-text); -unity-font-style: bold;" /></engine:VisualElement>
                    <engine:Label text="Determine Your Sign" style="font-size: 12px; color: var(--ink);" />
                </engine:VisualElement>
                <engine:VisualElement class="intro-row">
                    <engine:VisualElement class="intro-row__num" style="background-color: rgb(58,46,14); border-color: rgb(184,148,31);"><engine:Label text="3" style="font-size: 10px; color: rgb(224,200,120); -unity-font-style: bold;" /></engine:VisualElement>
                    <engine:Label text="Harvest Cards" style="font-size: 12px; color: var(--ink);" />
                </engine:VisualElement>
                <engine:VisualElement class="intro-row">
                    <engine:VisualElement class="intro-row__num" style="background-color: var(--arcanum-bg); border-color: var(--arcanum-border);"><engine:Label text="4" style="font-size: 10px; color: var(--arcanum-text); -unity-font-style: bold;" /></engine:VisualElement>
                    <engine:Label text="Commune" style="font-size: 12px; color: var(--ink);" />
                </engine:VisualElement>
                <engine:VisualElement class="intro-row">
                    <engine:VisualElement class="intro-row__num" style="background-color: rgb(26,21,48); border-color: rgb(74,58,106);"><engine:Label text="5" style="font-size: 10px; color: rgb(184,154,192); -unity-font-style: bold;" /></engine:VisualElement>
                    <engine:Label text="Card Lock" style="font-size: 12px; color: var(--ink);" />
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement class="intro-tip tip--ok">
            <engine:Label text="This age's sign shapes everything — which cards harvest well, which alignments score, and your own cosmic effect for the round."
                          class="tip__text" style="color: rgb(159,196,180);" />
        </engine:VisualElement>

        <engine:VisualElement class="intro-cta">
            <engine:Button name="begin-btn" text="Begin Spring" class="btn"
                           style="background-color: var(--ok-bg); border-color: var(--ok-border); color: var(--spring-accent);" />
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
