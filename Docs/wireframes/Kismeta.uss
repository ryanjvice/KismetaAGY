/* ============================================================
   Kismeta — shared stylesheet for Unity UI Toolkit (USS)
   Production canonical copy: Assets/_Project/UI/USS/Kismeta.uss
   Update both files when changing shared tokens or shell layout.
   Design baseline artboard: 380×844 (proportions only, not a width cap).
   ============================================================ */

:root,
.kismeta-scope,
.screen,
.sheet,
.kismeta-root {
    --ink: rgb(243, 233, 210);
    --gold: rgb(232, 185, 74);
    --gold-deep: rgb(201, 150, 47);
    --gold-bright: rgb(244, 211, 94);
    --muted: rgb(184, 154, 110);
    --muted-dim: rgb(138, 106, 122);
    --suit-wands: rgb(122, 31, 26);
    --suit-cups: rgb(31, 58, 110);
    --suit-pentacles: rgb(31, 110, 74);
    --suit-swords: rgb(138, 106, 31);
    --reagent-salt: rgb(207, 207, 207);
    --reagent-sulphur: rgb(192, 57, 43);
    --reagent-vitriol: rgb(31, 110, 74);
    --reagent-aqua: rgb(46, 109, 164);
    --reagent-quick: rgb(184, 148, 31);
    --spring-bg: rgb(15, 20, 16);
    --spring-accent: rgb(127, 196, 154);
    --summer-bg: rgb(24, 15, 10);
    --summer-accent: rgb(240, 176, 96);
    --autumn-bg: rgb(22, 10, 10);
    --autumn-accent: rgb(224, 138, 74);
    --winter-bg: rgb(14, 20, 32);
    --winter-accent: rgb(158, 201, 224);
    --ok-bg: rgb(22, 38, 31);
    --ok-border: rgb(43, 106, 74);
    --ok-text: rgb(127, 196, 168);
    --danger-bg: rgb(38, 16, 22);
    --danger-border: rgb(106, 48, 48);
    --danger-text: rgb(240, 144, 138);
    --caution-bg: rgb(42, 31, 14);
    --caution-border: rgb(106, 90, 58);
    --caution-text: rgb(224, 200, 120);
    --arcanum-bg: rgb(36, 16, 40);
    --arcanum-border: rgb(106, 74, 138);
    --arcanum-text: rgb(205, 176, 224);
    --panel-dark: rgb(22, 10, 28);
    --panel-darker: rgb(16, 10, 18);
    --border-subtle: rgb(58, 36, 64);
    --radius-sm: 6px;
    --radius-md: 9px;
    --radius-lg: 14px;
    --radius-xl: 18px;
    /* Responsive defaults — static; scaled by PanelSettings */
    --ui-scale: 1;
    --space-xs: 4px;
    --space-sm: 8px;
    --space-md: 12px;
    --space-lg: 16px;
    --space-xl: 24px;
    --font-micro: 8px;
    --font-label: 10px;
    --font-body: 12px;
    --font-title: 14px;
    --font-display: 34px;
    --touch-min: 44px;
    --card-chip-w: 34px;
    --card-chip-h: 48px;
    --overlay-max-width: 520px;
    --overlay-inset-x: var(--space-xl);
}

.kismeta-scope {
    flex-direction: column;
}

/* ---------- App shell (ViewportLayout) ---------- */
.kismeta-root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    flex-shrink: 0;
    flex-direction: column;
    position: relative;
    background-color: var(--panel-dark);
}

.app-shell {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    flex-shrink: 0;
    flex-direction: column;
    position: relative;
}

.content-layer {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    flex-shrink: 0;
    flex-direction: column;
    align-items: stretch;
}

/* UXML Instantiate() wrapper — must stretch or screens shrink to content height */
.screen-host {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    flex-shrink: 0;
    flex-direction: column;
    align-items: stretch;
}

.overlay-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0.65);
    align-items: center;
    justify-content: flex-start;
    padding-left: var(--overlay-inset-x);
    padding-right: var(--overlay-inset-x);
}

.overlay-clone-host {
    width: 100%;
    max-width: var(--overlay-max-width);
    min-width: 0;
    flex-grow: 0;
    flex-shrink: 1;
    flex-direction: column;
    align-items: stretch;
    padding-top: var(--space-lg);
}

.overlay-layer--sheet {
    justify-content: flex-start;
    align-items: center;
}

/* ---------- Full-bleed screens ---------- */
.screen {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    flex-shrink: 0;
    flex-direction: column;
    align-items: stretch;
    border-radius: 0;
    border-width: 0;
    background-color: var(--autumn-bg);
    overflow: hidden;
}

.screen--spring { background-color: var(--spring-bg); }
.screen--summer { background-color: var(--summer-bg); }
.screen--autumn { background-color: var(--autumn-bg); }
.screen--winter { background-color: var(--winter-bg); }

.screen__body {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    overflow: hidden;
}

/* ---------- Persistent in-game frame ---------- */
.statusbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    padding: var(--space-sm) var(--space-md);
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle);
}

.statusbar__left { flex-direction: row; align-items: center; }
.statusbar__sigil {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    border-width: 1px;
    border-color: var(--gold-deep);
    align-items: center;
    justify-content: center;
    margin-right: var(--space-sm);
}

.statusbar__title { font-size: var(--font-title); color: var(--gold); }
.statusbar__sub { font-size: var(--font-label); color: var(--muted); }

.rivals {
    flex-direction: row;
    flex-shrink: 0;
    padding: var(--space-sm) var(--space-md) var(--space-xs);
}

.rival {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    background-color: var(--panel-dark);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 6px var(--space-sm);
    margin-right: 6px;
}

.rival:last-child { margin-right: 0; }
.rival__dot { width: 18px; height: 18px; border-radius: 9px; border-width: 1px; margin-right: 6px; }
.rival__name { font-size: var(--font-body); }
.rival__stat { font-size: var(--font-label); color: var(--muted); }

.stage {
    flex-grow: 1;
    flex-shrink: 1;
    margin: var(--space-xs) var(--space-md) 6px;
    border-radius: var(--radius-lg);
    border-width: 1px;
    border-color: rgb(74, 32, 48);
    background-color: rgb(42, 18, 40);
    padding: var(--space-md);
    overflow: hidden;
}

.actionbar {
    flex-direction: row;
    flex-shrink: 0;
    padding: 0 var(--space-md) var(--space-sm);
}

.actionbtn {
    flex-grow: 1;
    min-height: var(--touch-min);
    border-radius: var(--radius-md);
    padding: 9px 4px;
    margin-right: 6px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
}

.actionbtn:last-child { margin-right: 0; }
.actionbtn__label { font-size: var(--font-body); -unity-font-style: normal; }

.dock {
    flex-shrink: 0;
    border-top-width: 1px;
    border-top-color: var(--border-subtle);
    background-color: var(--panel-darker);
    padding: var(--space-sm) var(--space-md) var(--space-md);
}

.dock__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 7px;
}

.dock__strip {
    flex-direction: row;
    flex-wrap: nowrap;
    overflow: hidden;
}

/* ---------- Cards ---------- */
.card-chip {
    width: var(--card-chip-w);
    height: var(--card-chip-h);
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: var(--gold-deep);
    align-items: center;
    justify-content: center;
}

.card-chip--selected { border-width: 2px; border-color: var(--gold-bright); }
.card-chip--wands { background-color: var(--suit-wands); }
.card-chip--cups { background-color: var(--suit-cups); }
.card-chip--pentacles { background-color: var(--suit-pentacles); }
.card-chip--swords { background-color: var(--suit-swords); }
.card-chip__rank { font-size: var(--font-body); color: white; -unity-font-style: bold; }

.reagent-dot { width: 16px; height: 16px; border-radius: 8px; border-width: 1px; }
.reagent-dot--salt { background-color: var(--reagent-salt); border-color: white; }
.reagent-dot--sulphur { background-color: var(--reagent-sulphur); border-color: rgb(229, 115, 115); }
.reagent-dot--vitriol { background-color: var(--reagent-vitriol); border-color: rgb(93, 202, 165); }
.reagent-dot--aqua { background-color: var(--reagent-aqua); border-color: rgb(111, 168, 212); }
.reagent-dot--quick { background-color: var(--reagent-quick); border-color: rgb(224, 192, 96); }

/* ---------- Buttons ---------- */
.btn {
    min-height: var(--touch-min);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    align-items: center;
    justify-content: center;
    border-width: 1px;
    -unity-text-align: middle-center;
    font-size: var(--font-body);
}

.btn--primary { background-color: rgb(58, 46, 14); border-color: var(--gold-deep); color: var(--gold); }
.btn--secondary { background-color: var(--panel-dark); border-color: rgb(74, 58, 90); color: var(--muted); }
.btn--disabled { background-color: rgb(42, 21, 48); border-color: var(--border-subtle); color: rgb(90, 74, 106); }
.btn:hover { opacity: 0.92; }

/* ---------- Panels & semantic blocks ---------- */
.panel {
    background-color: var(--panel-darker);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-md);
}

.tip {
    flex-direction: row;
    border-radius: var(--radius-md);
    padding: 9px 11px;
    margin: var(--space-sm) var(--space-md);
}

.tip--ok { background-color: var(--ok-bg); border-width: 1px; border-color: var(--ok-border); }
.tip--caution { background-color: var(--caution-bg); border-width: 1px; border-color: var(--caution-border); }
.tip--danger { background-color: var(--danger-bg); border-width: 1px; border-color: var(--danger-border); }
.tip--arcanum { background-color: var(--arcanum-bg); border-width: 1px; border-color: var(--arcanum-border); }
.tip__text { font-size: var(--font-label); -unity-text-align: upper-left; flex-shrink: 1; }

.eyebrow {
    font-size: var(--font-label);
    color: var(--muted-dim);
    -unity-font-style: normal;
    letter-spacing: 1px;
    margin-bottom: var(--space-sm);
}

/* ---------- Step rail ---------- */
.steprail { flex-direction: row; align-items: center; padding: 4px 2px var(--space-sm); }
.step { flex-grow: 1; align-items: center; }
.step__dot {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    border-width: 1px;
    align-items: center;
    justify-content: center;
}

.step__dot--done { background-color: var(--ok-bg); border-color: var(--ok-border); }
.step__dot--active { border-width: 2px; }
.step__dot--locked { background-color: var(--panel-darker); border-color: rgb(58, 58, 58); }
.step__label { font-size: var(--font-micro); color: var(--muted); margin-top: 3px; }
.step__connector { width: 12px; height: 1px; background-color: var(--border-subtle); }

/* ---------- Setup ---------- */
.player-pip {
    flex-grow: 1;
    min-height: var(--touch-min);
    border-radius: var(--radius-md);
    padding: 11px 0;
    margin-right: 7px;
    align-items: center;
    justify-content: center;
    background-color: var(--panel-darker);
    border-width: 1px;
    border-color: var(--border-subtle);
    color: var(--muted);
    font-size: 18px;
    -unity-font-style: bold;
}

.player-pip:last-child { margin-right: 0; }
.player-pip--active {
    background-color: var(--arcanum-bg);
    border-width: 2px;
    border-color: var(--gold-deep);
    color: var(--ink);
}

.mode-row {
    flex-direction: row;
    align-items: center;
    min-height: var(--touch-min);
    border-radius: var(--radius-md);
    padding: 11px 13px;
    margin-bottom: 9px;
    background-color: var(--panel-darker);
    border-width: 1px;
    border-color: var(--border-subtle);
}

.mode-row--active {
    background-color: var(--arcanum-bg);
    border-width: 2px;
    border-color: var(--gold-deep);
}

.mode-row__icon {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-md);
    background-color: rgb(22, 10, 28);
    border-width: 1px;
    margin-right: 11px;
}

.mode-row__radio {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--border-subtle);
    align-items: center;
    justify-content: center;
}

.mode-row__radio--on { border-color: var(--gold-deep); }

.ti-icon {
    font-size: var(--font-title);
}

.cauldron {
    width: 66px;
    height: 66px;
    border-radius: 33px;
    align-items: center;
    justify-content: center;
    position: absolute;
}

.cauldron--lit { border-width: 3px; border-color: var(--gold-bright); }
.cauldron--dormant { border-width: 2px; border-color: rgb(90, 58, 74); opacity: 0.6; }

/* ---------- Bottom sheet ---------- */
.sheet {
    width: 100%;
    max-height: 90%;
    flex-shrink: 0;
    background-color: rgb(26, 14, 31);
    border-top-width: 2px;
    border-top-color: var(--gold-deep);
    border-top-left-radius: var(--radius-xl);
    border-top-right-radius: var(--radius-xl);
}

.sheet__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 13px var(--space-lg);
    background-color: var(--panel-dark);
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle);
}

.sheet__body {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

/* ---------- Centered modal (shared chrome) ---------- */
.modal {
    width: 92%;
    max-width: 520px;
    max-height: 88%;
    flex-direction: column;
    border-radius: var(--radius-xl);
    border-width: 1px;
    overflow: hidden;
    flex-shrink: 1;
}

.modal__header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: var(--space-md);
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle);
}

.modal__body {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

/* ---------- Codex tabs ---------- */
.codex-tab {
    flex-grow: 1;
    min-height: var(--touch-min);
    background-color: var(--panel-darker);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-size: var(--font-body);
    padding: 6px;
    margin-right: 6px;
    -unity-text-align: middle-center;
}

.codex-tab:last-child { margin-right: 0; }
.codex-tab--active {
    background-color: var(--arcanum-bg);
    border-color: var(--gold-deep);
    color: var(--ink);
}

/* ---------- Viewport classes (toggled by ViewportLayout) ---------- */
.viewport--tablet .stage { margin-left: var(--space-xl); margin-right: var(--space-xl); }
.viewport--compact .title-flavor { max-width: 90%; }
