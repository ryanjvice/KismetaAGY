/* Kismeta — AutumnActions.uss
   Shared styling for Fire, Temper, Manage cards, Leave Stasis (#30-32, 34-36).
   Reuses Kismeta.uss + SummerActions stepper. */

/* modal chrome (Fire / Temper / Leave Stasis are modals) */
.modal {
    width: 92%;
    max-width: 520px;
    max-height: 88%;
    border-radius: var(--radius-xl);
    border-width: 1px;
    overflow: hidden;
    flex-shrink: 1;
}
.modal--fire   { background-color: rgb(22,16,12); border-color: rgb(106,58,26); }
.modal--temper { background-color: rgb(18,12,20); border-color: rgb(106,80,32); }
.modal--stasis { background-color: rgb(14,14,26); border-color: rgb(43,74,106); }
.modal__header {
    flex-direction: row; align-items: center;
    padding: 12px 14px;
    border-bottom-width: 1px;
}

/* forge position track (Fire) — small numbered nodes left-to-right */
.track {
    flex-direction: row; align-items: center; justify-content: center;
    margin-bottom: 14px;
}
.track-node {
    width: 38px; height: 38px; border-radius: 19px;
    align-items: center; justify-content: center;
    -unity-font-style: bold;
}
.track-node--now { background-color: rgb(207,207,207); border-width: 2px; border-color: white; color: rgb(58,58,58); }
.track-node--target { background-color: rgb(42,24,16); border-width: 2px; border-color: var(--gold-deep); color: var(--gold); }
.track-node--future { background-color: var(--gold-deep); border-width: 2px; border-color: var(--gold-bright); color: rgb(90,60,10); }
.track-arrow { width: 40px; align-items: center; }
.track-conn { width: 54px; height: 3px; border-radius: 2px; background-color: rgb(90,40,24); }

/* stage track (Temper) — Lead→Bronze→Silver→Gold→Altar */
.stage-track { flex-direction: row; align-items: center; justify-content: center; margin-bottom: 14px; }
.stage-node {
    width: 24px; height: 24px; border-radius: 12px;
    align-items: center; justify-content: center;
    font-size: 9px; -unity-font-style: bold;
}
.stage-node--now { width: 30px; height: 30px; border-radius: 15px; border-width: 2px; }
.stage-node--altar { width: 34px; height: 34px; border-radius: 17px; border-width: 2px; border-color: var(--gold-bright); }
.stage-conn { width: 8px; height: 1px; background-color: rgb(74,58,42); margin: 0 1px; }
.stage-label { font-size: 7px; color: var(--muted); margin-top: 2px; }

/* escape option card (Leave Stasis) */
.escape {
    border-radius: var(--radius-md);
    border-width: 1px;
    padding: 11px 12px;
    margin-bottom: 9px;
}
.escape--live { background-color: rgb(19,32,26); border-width: 2px; border-color: var(--ok-border); }
.escape--inactive { background-color: var(--panel-darker); border-color: var(--border-subtle); opacity: 0.92; }
.escape__head { flex-direction: row; align-items: center; margin-bottom: 8px; }
.escape__badge {
    border-radius: var(--radius-sm);
    border-width: 1px;
    padding: 3px 7px;
    font-size: 10px;
}

/* crucible-card state pills (Manage cards) */
.crucible-pill {
    flex-grow: 1;
    border-radius: var(--radius-md);
    border-width: 1px;
    padding: 8px 4px;
    align-items: center;
    margin-right: 7px;
}
.crucible-pill:last-child { margin-right: 0; }
.crucible-pill--forged { background-color: var(--ok-bg); border-color: var(--ok-border); }
.crucible-pill--ready { background-color: rgb(42,31,14); border-width: 2px; border-color: var(--gold-deep); }
.crucible-pill--active { background-color: var(--panel-darker); border-color: var(--border-subtle); }
.crucible-pill--dormant { background-color: var(--panel-darker); border-color: var(--border-subtle); opacity: 0.6; }
