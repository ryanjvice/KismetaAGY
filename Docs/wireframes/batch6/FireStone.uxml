<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../USS/Kismeta.uss" />
    <engine:Style src="../USS/SummerActions.uss" />
    <engine:Style src="../USS/AutumnActions.uss" />

    <!-- ============================================================
         FIRE YOUR STONE (#31) — modal. Spend reagents (any type) to advance
         ONE position. Reuses the ReagentStepper + pay-pill. Present as an
         overlay with a scrim over the Autumn forge scene.
         ============================================================ -->
    <engine:VisualElement name="fire-modal" class="modal modal--fire">

        <engine:VisualElement class="modal__header" style="background-color: rgb(36,17,8); border-bottom-color: rgb(74,32,24);">
            <engine:VisualElement style="width: 30px; height: 30px; border-radius: var(--radius-md); background-color: rgb(58,26,14); border-width: 1px; border-color: var(--gold-deep); align-items: center; justify-content: center; margin-right: 10px;">
                <engine:Label text="&#xec3a;" class="ti-icon" style="color: var(--gold);" />
            </engine:VisualElement>
            <engine:VisualElement style="flex-grow: 1;">
                <engine:Label text="Fire your stone" style="font-size: 14px; color: var(--autumn-accent);" />
                <engine:Label text="spend reagents to advance one position" style="font-size: 10px; color: rgb(184,148,106);" />
            </engine:VisualElement>
            <engine:Button name="fire-close" text="&#10005;" style="background-color: rgba(0,0,0,0); border-width: 0; color: var(--muted); font-size: 18px;" />
        </engine:VisualElement>

        <engine:VisualElement style="padding: 16px 14px 6px;">
            <!-- position track 5 -> 6 -> (7) -->
            <engine:VisualElement class="track">
                <engine:VisualElement style="align-items: center;">
                    <engine:VisualElement class="track-node track-node--now"><engine:Label text="5" /></engine:VisualElement>
                    <engine:Label text="Silver · now" style="font-size: 8px; color: var(--muted); margin-top: 3px;" />
                </engine:VisualElement>
                <engine:VisualElement class="track-arrow"><engine:VisualElement class="track-conn" /></engine:VisualElement>
                <engine:VisualElement style="align-items: center;">
                    <engine:VisualElement class="track-node track-node--target"><engine:Label text="6" /></engine:VisualElement>
                    <engine:Label text="target" style="font-size: 8px; color: var(--gold); margin-top: 3px;" />
                </engine:VisualElement>
                <engine:VisualElement class="track-arrow" style="opacity: 0.4;"><engine:Label text="&#8594;" style="color: var(--muted);" /></engine:VisualElement>
                <engine:VisualElement style="align-items: center; opacity: 0.5;">
                    <engine:VisualElement class="track-node track-node--future" style="width: 32px; height: 32px;"><engine:Label text="7" /></engine:VisualElement>
                    <engine:Label text="Gold" style="font-size: 8px; color: var(--muted); margin-top: 3px;" />
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:Label text="cost to advance · 2 reagents" class="eyebrow" style="color: rgb(154,90,58);" />
            <engine:VisualElement class="pay-pill">
                <engine:VisualElement style="flex-direction: row; align-items: center;">
                    <engine:Label text="paying" style="font-size: 10px; color: rgb(184,148,106); margin-right: 8px;" />
                    <engine:VisualElement name="pay-slots" style="flex-direction: row;">
                        <engine:VisualElement class="pay-slot pay-slot--empty" />
                        <engine:VisualElement class="pay-slot pay-slot--empty" />
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:Label name="pay-count" text="0 / 2" style="font-size: 11px; color: rgb(184,148,106);" />
            </engine:VisualElement>

            <engine:Label text="tap reagents to spend" style="font-size: 9px; color: rgb(106,90,74); margin-bottom: 6px;" />
            <engine:VisualElement name="supply">
                <engine:VisualElement class="stepper-row">
                    <engine:VisualElement class="reagent-dot reagent-dot--salt" style="margin-right: 9px;" />
                    <engine:Label text="Salt" style="flex-grow: 1; font-size: 12px; color: var(--ink);" />
                    <engine:Label text="have 3" style="font-size: 9px; color: rgb(122,90,74); margin-right: 8px;" />
                    <engine:Button name="fire-salt-minus" class="stepper-btn stepper-btn--minus"><engine:Label text="&#8722;" style="color: rgb(212,160,122);" /></engine:Button>
                    <engine:Label name="fire-salt-val" text="0" class="stepper-value" style="color: var(--muted);" />
                    <engine:Button name="fire-salt-plus" class="stepper-btn stepper-btn--plus"><engine:Label text="+" style="color: var(--gold);" /></engine:Button>
                </engine:VisualElement>
                <engine:VisualElement class="stepper-row">
                    <engine:VisualElement class="reagent-dot reagent-dot--vitriol" style="margin-right: 9px;" />
                    <engine:Label text="Vitriol" style="flex-grow: 1; font-size: 12px; color: var(--ink);" />
                    <engine:Label text="have 2" style="font-size: 9px; color: rgb(122,90,74); margin-right: 8px;" />
                    <engine:Button name="fire-vitriol-minus" class="stepper-btn stepper-btn--minus"><engine:Label text="&#8722;" style="color: rgb(212,160,122);" /></engine:Button>
                    <engine:Label name="fire-vitriol-val" text="0" class="stepper-value" style="color: var(--muted);" />
                    <engine:Button name="fire-vitriol-plus" class="stepper-btn stepper-btn--plus"><engine:Label text="+" style="color: var(--gold);" /></engine:Button>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement class="tip tip--danger">
            <engine:Label text="Advancing to position 6 keeps your stone forging in the open — still exposed to Opposition this age."
                          class="tip__text" style="color: rgb(212,160,122);" />
        </engine:VisualElement>

        <engine:VisualElement style="padding: 4px 14px 16px;">
            <engine:Button name="fire-btn" text="Spend 2 to advance" class="btn btn--disabled" />
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
