<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:Style src="../USS/Kismeta.uss" />
    <engine:Style src="../USS/AutumnActions.uss" />

    <!-- ============================================================
         MANAGE CARDS — AUTUMN (#30) — a LOCKED review (cards frozen until
         Winter). Read-only planning surface for Fire/Temper/Oppose. Crucible
         states lead; full Spread + Hand (yours to see); reagents + Arcanum.
         NATIVE NOTE: no tap-to-move here (unlike Commune). Populate strips in C#.
         ============================================================ -->
    <engine:VisualElement name="manage-cards" class="screen" style="background-color: rgb(14,10,20);">

        <engine:VisualElement class="statusbar" style="border-bottom-color: rgb(74,58,42);">
            <engine:VisualElement class="statusbar__left">
                <engine:VisualElement class="statusbar__sigil" style="background-color: rgb(42,31,14); border-color: var(--gold-deep);">
                    <engine:Label text="&#xea6f;" class="ti-icon" style="color: var(--gold);" />
                </engine:VisualElement>
                <engine:VisualElement>
                    <engine:Label text="Your tableau" class="statusbar__title" style="color: var(--gold);" />
                    <engine:Label text="review — cards locked until Winter" class="statusbar__sub" />
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:Button name="close-btn" text="&#10005;" style="background-color: rgba(0,0,0,0); border-width: 0; color: var(--muted); font-size: 18px;" />
        </engine:VisualElement>

        <engine:VisualElement class="tip tip--arcanum">
            <engine:Label text="Spread &amp; hand are frozen this season. This view is for planning your Fire, Temper &amp; Oppose moves."
                          class="tip__text" style="color: rgb(184,154,192);" />
        </engine:VisualElement>

        <!-- crucible card states -->
        <engine:VisualElement style="padding: 8px 14px 4px;">
            <engine:Label text="crucible cards" class="eyebrow" />
            <engine:VisualElement style="flex-direction: row;">
                <engine:VisualElement class="crucible-pill crucible-pill--forged">
                    <engine:Label text="&#xeb81;" class="ti-icon" style="color: var(--ok-text);" />
                    <engine:Label text="A" style="font-size: 10px; color: var(--ink); margin-top: 2px;" />
                    <engine:Label text="forged" style="font-size: 7px; color: var(--ok-text);" />
                </engine:VisualElement>
                <engine:VisualElement class="crucible-pill crucible-pill--ready">
                    <engine:Label text="&#xea1b;" class="ti-icon" style="color: var(--gold);" />
                    <engine:Label text="C" style="font-size: 10px; color: var(--ink); margin-top: 2px;" />
                    <engine:Label text="temper-ready" style="font-size: 7px; color: var(--gold);" />
                </engine:VisualElement>
                <engine:VisualElement class="crucible-pill crucible-pill--active">
                    <engine:Label text="&#xec3a;" class="ti-icon" style="color: rgb(154,122,106);" />
                    <engine:Label text="B" style="font-size: 10px; color: rgb(207,196,168); margin-top: 2px;" />
                    <engine:Label text="active" style="font-size: 7px; color: var(--muted);" />
                </engine:VisualElement>
                <engine:VisualElement class="crucible-pill crucible-pill--dormant">
                    <engine:Label text="&#xeae2;" class="ti-icon" style="color: rgb(106,90,74);" />
                    <engine:Label text="D" style="font-size: 10px; color: var(--muted); margin-top: 2px;" />
                    <engine:Label text="dormant" style="font-size: 7px; color: rgb(106,90,74);" />
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:Label text="Crucible C is forged — you can Temper to advance a stage this Autumn."
                          style="font-size: 9px; color: var(--muted); margin-top: 6px; white-space: normal;" />
        </engine:VisualElement>

        <!-- spread (aligned dotted) -->
        <engine:VisualElement style="padding: 10px 14px 4px;">
            <engine:Label text="Spread · visible · duel-exposed" class="eyebrow" style="color: var(--gold-bright);" />
            <engine:VisualElement name="spread-strip" style="flex-direction: row; flex-wrap: wrap;">
                <engine:VisualElement class="card-chip card-chip--wands card-chip--selected" style="margin-right: 5px;"><engine:Label text="7" class="card-chip__rank" /></engine:VisualElement>
                <engine:VisualElement class="card-chip card-chip--cups card-chip--selected" style="margin-right: 5px;"><engine:Label text="K" class="card-chip__rank" /></engine:VisualElement>
                <engine:VisualElement class="card-chip card-chip--pentacles" style="margin-right: 5px;"><engine:Label text="3" class="card-chip__rank" /></engine:VisualElement>
                <engine:VisualElement class="card-chip card-chip--wands card-chip--selected"><engine:Label text="A" class="card-chip__rank" /></engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>

        <!-- hand (yours to see in Autumn) -->
        <engine:VisualElement style="padding: 8px 14px 4px;">
            <engine:Label text="Hand · hidden reserve" class="eyebrow" style="color: var(--ok-text);" />
            <engine:VisualElement name="hand-strip" style="flex-direction: row; flex-wrap: wrap;">
                <engine:VisualElement class="card-chip card-chip--swords" style="margin-right: 5px;"><engine:Label text="9" class="card-chip__rank" /></engine:VisualElement>
                <engine:VisualElement class="card-chip card-chip--pentacles" style="margin-right: 5px;"><engine:Label text="J" class="card-chip__rank" /></engine:VisualElement>
                <engine:VisualElement class="card-chip card-chip--cups" style="margin-right: 5px;"><engine:Label text="2" class="card-chip__rank" /></engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>

        <!-- reagents -->
        <engine:VisualElement style="padding: 8px 14px 16px;">
            <engine:Label text="reagents" class="eyebrow" />
            <engine:VisualElement class="panel" style="flex-direction: row; align-items: center;">
                <engine:VisualElement style="flex-direction: row; align-items: center; margin-right: 14px;"><engine:VisualElement class="reagent-dot reagent-dot--salt" style="margin-right: 4px;" /><engine:Label text="3" style="font-size: 11px; color: var(--ink);" /></engine:VisualElement>
                <engine:VisualElement style="flex-direction: row; align-items: center; margin-right: 14px;"><engine:VisualElement class="reagent-dot reagent-dot--vitriol" style="margin-right: 4px;" /><engine:Label text="2" style="font-size: 11px; color: var(--ink);" /></engine:VisualElement>
                <engine:VisualElement style="flex-direction: row; align-items: center;"><engine:VisualElement class="reagent-dot reagent-dot--sulphur" style="margin-right: 4px;" /><engine:Label text="1" style="font-size: 11px; color: var(--ink);" /></engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement style="padding: 0 14px 16px;">
            <engine:Button name="forge-btn" text="Back to the forge" class="btn btn--primary" />
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
